#!/usr/bin/env python3
"""Keep-awake sessions and rules. Hypridle consults the private runtime snapshot."""

import argparse
import contextlib
import datetime as dt
import fcntl
import json
import math
import os
import re
import signal
import socket
import socketserver
import stat
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import uuid
from pathlib import Path
from typing import Any, cast, final

BUSCTL = "@busctl@"
NOTIFY_SEND = "@notify_send@"
EXAMPLE = "@example@"
DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
NM = "org.freedesktop.NetworkManager"
UP = "org.freedesktop.UPower"
MAX_AGE = 30


class KeepawakeError(Exception):
    pass


def program(value: str, fallback: str) -> str:
    return fallback if value.startswith("@") else value


def config_path() -> Path:
    return (
        Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
        / "keepawake/config.toml"
    )


def runtime_dir() -> Path:
    directory = os.environ.get("XDG_RUNTIME_DIR")
    if not directory:
        raise KeepawakeError(
            "XDG_RUNTIME_DIR is unavailable; run in your desktop session."
        )
    return Path(directory) / "keepawake"


def init_config(destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    example = (
        Path(EXAMPLE)
        if not EXAMPLE.startswith("@")
        else Path(__file__).resolve().parents[1]
        / "config/keepawake/config.example.toml"
    )

    def opener(filename: str, flags: int) -> int:
        return os.open(filename, flags, 0o600)

    try:
        with open(destination, "x", opener=opener) as output:
            output.write(example.read_text())
    except FileExistsError:
        pass


def clock_minutes(value: str) -> int:
    if not re.fullmatch(r"[0-2]\d:[0-5]\d", value) or int(value[:2]) > 23:
        raise KeepawakeError("Clock times must use HH:MM, from 00:00 to 23:59.")
    return int(value[:2]) * 60 + int(value[3:])


def duration_seconds(value: str) -> int:
    if value.isdigit():
        result = int(value) * 60
    else:
        parts = re.findall(r"(\d+)([smh])", value)
        if not parts or "".join(n + unit for n, unit in parts) != value:
            raise KeepawakeError(
                "Use a duration such as 30m or 1h30m; bare numbers mean minutes."
            )
        result = sum(int(n) * {"s": 1, "m": 60, "h": 3600}[unit] for n, unit in parts)
    if result <= 0 or result > 365 * 86400:
        raise KeepawakeError("Duration must be positive and no longer than one year.")
    return result


def validate_schedule(value: Any) -> None:
    if not isinstance(value, dict):
        raise KeepawakeError("Schedules require days, start, and end.")
    schedule = cast(dict[str, Any], value)
    if set(schedule) != {"days", "start", "end"}:
        raise KeepawakeError("Schedules require days, start, and end.")
    days: Any = schedule["days"]
    if (
        not isinstance(days, list)
        or not days
        or any(day not in DAYS for day in cast(list[Any], days))
    ):
        raise KeepawakeError(
            "Schedule days must be Mon, Tue, Wed, Thu, Fri, Sat, or Sun."
        )
    for key in ("start", "end"):
        if not isinstance(schedule[key], str):
            raise KeepawakeError("Schedule times must be strings.")
        clock_minutes(schedule[key])
    if schedule["start"] == schedule["end"]:
        raise KeepawakeError("Schedule start and end must differ.")


def load_config(filename: Path) -> dict[str, Any]:
    data = tomllib.loads(filename.read_text())
    allowed = {
        "version",
        "battery_floor",
        "poll_seconds",
        "notifications",
        "keep_display_awake",
        "allow_lid_closed",
        "rules",
    }
    if set(data) - allowed or data.get("version", 1) != 1:
        raise KeepawakeError("Unknown configuration key or unsupported version.")
    for key, default in (("battery_floor", 20), ("poll_seconds", 5)):
        data.setdefault(key, default)
        if type(data[key]) not in (int, float) or not math.isfinite(data[key]):
            raise KeepawakeError(f"{key} must be a finite number.")
    if not 0 <= data["battery_floor"] <= 100 or not 1 <= data["poll_seconds"] <= 10:
        raise KeepawakeError("battery_floor must be 0–100; poll_seconds must be 1–10.")
    for key in ("notifications", "keep_display_awake", "allow_lid_closed"):
        data.setdefault(key, key == "notifications")
        if type(data[key]) is not bool:
            raise KeepawakeError(f"{key} must be true or false.")
    rules = data.setdefault("rules", [])
    if not isinstance(rules, list):
        raise KeepawakeError("rules must be an array of tables.")
    names: set[str] = set()
    for raw_rule in cast(list[Any], rules):
        if not isinstance(raw_rule, dict):
            raise KeepawakeError("Each rule must be a table.")
        rule = cast(dict[str, Any], raw_rule)
        if set(rule) - {
            "name",
            "enabled",
            "match",
            "when",
            "keep_display_awake",
            "allow_lid_closed",
        }:
            raise KeepawakeError("Unknown rule key.")
        name = rule.get("name")
        if not isinstance(name, str) or not name.strip() or name in names:
            raise KeepawakeError("Each rule needs a unique, nonempty name.")
        names.add(name)
        for key in ("enabled", "keep_display_awake", "allow_lid_closed"):
            if key in rule and type(rule[key]) is not bool:
                raise KeepawakeError(f"Rule {key} must be true or false.")
        if rule.get("match", "all") not in ("all", "any"):
            raise KeepawakeError("Rule match must be all or any.")
        when = rule.get("when")
        if (
            not isinstance(when, dict)
            or not when
            or set(cast(dict[str, Any], when))
            - {"wifi_ssid", "process", "ac_power", "external_display", "schedule"}
        ):
            raise KeepawakeError("Rules need supported conditions in when.")
        for key, value in cast(dict[str, Any], when).items():
            if key in ("wifi_ssid", "process") and (
                not isinstance(value, str) or not value
            ):
                raise KeepawakeError(f"{key} must be a nonempty string.")
            if key in ("ac_power", "external_display") and type(value) is not bool:
                raise KeepawakeError(f"{key} must be true or false.")
            if key == "schedule":
                validate_schedule(value)
    return data


def in_schedule(schedule: dict[str, Any], now: dt.datetime) -> bool:
    start, end = clock_minutes(schedule["start"]), clock_minutes(schedule["end"])
    minute = now.hour * 60 + now.minute
    day = now.weekday()
    if start < end:
        return DAYS[day] in schedule["days"] and start <= minute < end
    if minute >= start:
        return DAYS[day] in schedule["days"]
    return minute < end and DAYS[(day - 1) % 7] in schedule["days"]


def rule_matches(rule: dict[str, Any], facts: dict[str, Any], now: dt.datetime) -> bool:
    checks: list[bool] = []
    for key, value in rule["when"].items():
        if key == "wifi_ssid":
            checks.append(value in facts["wifi_ssids"])
        elif key == "process":
            checks.append(value in facts["processes"])
        elif key == "ac_power":
            checks.append(facts["on_ac"] is value)
        elif key == "external_display":
            checks.append(bool(facts["external_displays"]) is value)
        elif key == "schedule":
            checks.append(in_schedule(value, now))
    return all(checks) if rule.get("match", "all") == "all" else any(checks)


def power_allowed(facts: dict[str, Any], floor: float) -> bool:
    if facts["on_ac"] is True:
        return True
    percent = facts["battery_percent"]
    return facts["on_ac"] is False and percent is not None and percent > floor


def batteryless_desktop(supplies: Path) -> bool:
    try:
        return supplies.is_dir() and all(
            item.read_text().strip() != "Battery" for item in supplies.glob("*/type")
        )
    except OSError:
        return False


class SystemFacts:
    def property(self, service: str, obj: str, interface: str, name: str) -> Any:
        result = subprocess.run(
            [
                program(BUSCTL, "busctl"),
                "--system",
                "--json=short",
                "--timeout=1",
                "get-property",
                service,
                obj,
                interface,
                name,
            ],
            capture_output=True,
            text=True,
            timeout=2,
            check=True,
        )
        return json.loads(result.stdout)["data"]

    def power(self) -> tuple[bool, float | None]:
        try:
            on_battery = self.property(UP, "/org/freedesktop/UPower", UP, "OnBattery")
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            # UPower may be absent on a desktop. Only treat it as AC-only when
            # sysfs confirms that there are no battery devices. A laptop with
            # unavailable power information still releases its holds.
            supplies = Path("/sys/class/power_supply")
            if batteryless_desktop(supplies):
                return True, None
            raise
        if type(on_battery) is not bool:
            raise KeepawakeError("UPower returned an invalid power source.")
        if not on_battery:
            return True, None
        percent = self.property(
            UP,
            "/org/freedesktop/UPower/devices/DisplayDevice",
            UP + ".Device",
            "Percentage",
        )
        if (
            type(percent) not in (int, float)
            or not math.isfinite(percent)
            or not 0 <= percent <= 100
        ):
            raise KeepawakeError("UPower returned an invalid battery percentage.")
        return False, percent

    def wifi(self) -> list[str]:
        ssids: list[str] = []
        devices = self.property(NM, "/org/freedesktop/NetworkManager", NM, "Devices")
        for device in devices:
            if (
                self.property(NM, device, NM + ".Device", "DeviceType") != 2
                or self.property(NM, device, NM + ".Device", "State") != 100
            ):
                continue
            access_point = self.property(
                NM, device, NM + ".Device.Wireless", "ActiveAccessPoint"
            )
            if access_point != "/":
                ssids.append(
                    bytes(
                        self.property(NM, access_point, NM + ".AccessPoint", "Ssid")
                    ).decode("utf-8", errors="replace")
                )
        return ssids

    def sample(self) -> tuple[dict[str, Any], list[str]]:
        errors: list[str] = []
        facts: dict[str, Any] = {
            "on_ac": None,
            "battery_percent": None,
            "wifi_ssids": [],
            "processes": set(),
            "external_displays": [],
        }
        try:
            facts["on_ac"], facts["battery_percent"] = self.power()
        except (
            OSError,
            ValueError,
            KeyError,
            subprocess.SubprocessError,
            KeepawakeError,
        ):
            errors.append("Power information unavailable; keep-awake holds released.")
        try:
            facts["wifi_ssids"] = self.wifi()
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
            errors.append("Wi-Fi information unavailable.")
        for proc in Path("/proc").glob("[0-9]*"):
            try:
                if proc.stat().st_uid != os.getuid():
                    continue
                facts["processes"].add((proc / "comm").read_text().strip())
                executable = (proc / "exe").resolve(strict=True).name
                facts["processes"].add(executable)
                if executable.startswith(".") and executable.endswith("-wrapped"):
                    facts["processes"].add(executable[1:-8])
            except OSError:
                pass
        for connector in Path("/sys/class/drm").glob("card*-*/status"):
            try:
                if (
                    not re.search(r"-(eDP|LVDS|DSI)-", connector.parent.name)
                    and connector.read_text().strip() == "connected"
                ):
                    facts["external_displays"].append(connector.parent.name)
            except OSError:
                pass
        return facts, errors


def file_signature(filename: str) -> tuple[int, int] | None:
    try:
        info = Path(filename).stat()
        return info.st_size, info.st_mtime_ns
    except OSError:
        return None


def pid_identity(pid: int) -> str | None:
    try:
        text = Path(f"/proc/{pid}/stat").read_text()
        # comm may contain spaces and parentheses. Start time is field 22.
        fields = text[text.rfind(")") + 2 :].split()
        return None if fields[0] == "Z" else fields[19]
    except (OSError, IndexError):
        return None


def suspend_offset() -> float:
    clock = getattr(time, "CLOCK_BOOTTIME", None)
    return 0.0 if clock is None else time.clock_gettime(clock) - time.monotonic()


@final
class Engine:
    def __init__(self, filename: Path, directory: Path):
        self.filename, self.directory = filename, directory
        self.lock = threading.RLock()
        self.config: dict[str, Any] = {}
        self.facts: dict[str, Any] = {
            "on_ac": None,
            "battery_percent": None,
            "wifi_ssids": [],
            "processes": set(),
            "external_displays": [],
        }
        self.sampled_at = 0.0
        self.errors: list[str] = []
        self.config_error = ""
        self.paused = False
        self.suspend_offset = suspend_offset()
        self.sessions: list[dict[str, Any]] = []
        self.snapshot: dict[str, Any] = {
            "active": False,
            "sessions": [],
            "rules": [],
            "error": "Starting",
        }

    def poll(self, source: SystemFacts) -> None:
        try:
            config = load_config(self.filename)
            config_error = ""
        except (OSError, ValueError, KeepawakeError) as error:
            config, config_error = {}, f"Configuration error: {error}"
        facts, errors = source.sample()
        with self.lock:
            # BOOTTIME includes suspend; MONOTONIC does not. Clear manual
            # sessions after sleep without monitoring logind or blocking it.
            offset = suspend_offset()
            if offset > self.suspend_offset + 1:
                self.sessions = []
            self.suspend_offset = offset
            self.config, self.config_error = config, config_error
            self.facts, self.errors, self.sampled_at = facts, errors, time.monotonic()
            self.update()

    def update(self) -> dict[str, Any]:
        now, wall = time.monotonic(), dt.datetime.now().astimezone()
        ended: list[str] = []
        allowed = (
            bool(self.config)
            and power_allowed(self.facts, self.config["battery_floor"])
            and now - self.sampled_at <= MAX_AGE
        )
        retained: list[dict[str, Any]] = []
        for session in self.sessions:
            done = not allowed and self.facts["on_ac"] is False
            if "deadline" in session:
                done |= now >= session["deadline"]
            if "until_epoch" in session:
                done |= time.time() >= session["until_epoch"]
            if "process" in session:
                done |= session["process"] not in self.facts["processes"]
            if "pid" in session:
                done |= pid_identity(session["pid"]) != session["pid_start"]
            if "file" in session:
                signature = file_signature(session["file"])
                if signature != session["signature"]:
                    session["signature"], session["changed_at"] = signature, now
                done |= (
                    signature is None
                    or now - session["changed_at"] >= session["quiet_seconds"]
                )
            if done:
                ended.append(session["name"])
            else:
                retained.append(session)
        self.sessions = retained
        rules = [
            {
                "name": rule["name"],
                "active": allowed
                and not self.paused
                and rule.get("enabled", True)
                and rule_matches(rule, self.facts, wall),
            }
            for rule in self.config.get("rules", [])
        ]
        holds: list[dict[str, Any]] = []
        if allowed and not self.paused:
            holds.extend(
                rule
                for rule, state in zip(self.config.get("rules", []), rules)
                if state["active"]
            )
            holds.extend(self.sessions)
        public_sessions: list[dict[str, Any]] = []
        for session in self.sessions:
            remaining = (
                max(0, math.ceil(session["deadline"] - now))
                if "deadline" in session
                else max(0, math.ceil(session["until_epoch"] - time.time()))
                if "until_epoch" in session
                else None
            )
            public_sessions.append(
                {
                    "id": session["id"],
                    "name": session["name"],
                    "remaining_seconds": remaining,
                    "keep_display_awake": session["keep_display_awake"],
                    "allow_lid_closed": session["allow_lid_closed"],
                }
            )
        self.snapshot = {
            "version": 1,
            "sampled_at": self.sampled_at,
            "pid": os.getpid(),
            "pid_start": pid_identity(os.getpid()),
            "active": bool(holds),
            "keep_display_awake": any(
                hold.get(
                    "keep_display_awake", self.config.get("keep_display_awake", False)
                )
                for hold in holds
            ),
            "allow_lid_closed": any(
                hold.get("allow_lid_closed", self.config.get("allow_lid_closed", False))
                for hold in holds
            ),
            "paused": self.paused,
            "power_allowed": allowed,
            "battery_floor": self.config.get("battery_floor", 20),
            "on_ac": self.facts["on_ac"],
            "battery_percent": self.facts["battery_percent"],
            "reasons": [hold["name"] for hold in holds],
            "sessions": public_sessions,
            "rules": rules,
            "config_path": str(self.filename),
            "error": self.config_error or "; ".join(self.errors),
        }
        if self.directory.is_dir():
            with tempfile.NamedTemporaryFile(
                mode="w", dir=self.directory, delete=False
            ) as output:
                json.dump(self.snapshot, output)
                temporary = Path(output.name)
            temporary.replace(self.directory / "status.json")
        if ended and self.config.get("notifications", True):
            try:
                subprocess.Popen(
                    [
                        program(NOTIFY_SEND, "notify-send"),
                        "Keep awake",
                        "Session ended: " + ", ".join(ended),
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except OSError:
                pass
        return self.snapshot

    def command(self, request: dict[str, Any]) -> dict[str, Any]:
        with self.lock:
            action = request.get("action")
            if action == "status":
                return self.update()
            if action in ("pause", "resume", "toggle-pause"):
                self.paused = (
                    not self.paused if action == "toggle-pause" else action == "pause"
                )
            elif action == "stop":
                session_id = request.get("id")
                self.sessions = (
                    [
                        session
                        for session in self.sessions
                        if session["id"] != session_id
                    ]
                    if session_id
                    else []
                )
            elif action == "toggle":
                manual = next(
                    (
                        session
                        for session in self.sessions
                        if session["name"] == "Manual"
                    ),
                    None,
                )
                if manual:
                    self.sessions.remove(manual)
                else:
                    self.start({})
            elif action == "start":
                self.start(request)
            else:
                raise KeepawakeError("Unknown action.")
            return self.update()

    def start(self, request: dict[str, Any]) -> None:
        for key in ("duration", "until", "process", "file"):
            if request.get(key) is not None and not isinstance(request[key], str):
                raise KeepawakeError(f"{key} must be a string.")
        self.update()
        if not self.snapshot["power_allowed"]:
            raise KeepawakeError(
                "Cannot start: power unavailable, configuration invalid, or battery at/below its limit."
            )
        if self.paused:
            raise KeepawakeError("Resume keep-awake before starting a session.")
        selectors = [
            key
            for key in ("duration", "until", "process", "pid", "file")
            if request.get(key) is not None
        ]
        if len(selectors) > 1:
            raise KeepawakeError("Choose only one session end condition.")
        session: dict[str, Any] = {"id": uuid.uuid4().hex, "name": "Manual"}
        for key in ("keep_display_awake", "allow_lid_closed"):
            value = request.get(key, self.config[key])
            if type(value) is not bool:
                raise KeepawakeError(f"{key} must be true or false.")
            session[key] = value
        if request.get("duration") is not None:
            duration = duration_seconds(request["duration"])
            session.update(
                name=f"Timer {request['duration']}",
                deadline=time.monotonic() + duration,
            )
        elif request.get("until") is not None:
            clock_minutes(request["until"])
            now = dt.datetime.now()
            target = now.replace(
                hour=int(request["until"][:2]),
                minute=int(request["until"][3:]),
                second=0,
                microsecond=0,
            )
            if target <= now:
                target += dt.timedelta(days=1)
            session.update(
                name=f"Until {request['until']}", until_epoch=target.timestamp()
            )
        elif request.get("process") is not None:
            process = request["process"]
            if process not in self.facts["processes"]:
                raise KeepawakeError("The selected process is not running.")
            session.update(name=f"While {process} runs", process=process)
        elif request.get("pid") is not None:
            pid = request["pid"]
            if (
                type(pid) is not int
                or pid <= 0
                or (identity := pid_identity(pid)) is None
            ):
                raise KeepawakeError("The selected PID is not running.")
            session.update(name=f"While PID {pid} runs", pid=pid, pid_start=identity)
        elif request.get("file") is not None:
            filename = str(Path(request["file"]).expanduser().resolve())
            signature = file_signature(filename)
            quiet = request.get("quiet_seconds", 60)
            if signature is None or not Path(filename).is_file():
                raise KeepawakeError("Select an existing download file.")
            if type(quiet) is not int or not 5 <= quiet <= 86400:
                raise KeepawakeError("Download quiet time must be 5–86400 seconds.")
            session.update(
                name=f"Download {Path(filename).name}",
                file=filename,
                signature=signature,
                changed_at=time.monotonic(),
                quiet_seconds=quiet,
            )
        if len(self.sessions) >= 64:
            raise KeepawakeError("Too many sessions; stop an existing session first.")
        self.sessions.append(session)


def can_idle(action: str, directory: Path) -> bool:
    try:
        data = json.loads((directory / "status.json").read_text())
        age = time.monotonic() - data["sampled_at"]
        if (
            not 0 <= age <= MAX_AGE
            or pid_identity(data["pid"]) != data.get("pid_start")
            or data.get("pid_start") is None
        ):
            return True
        return not data.get(
            {
                "can-suspend": "active",
                "can-screen-sleep": "keep_display_awake",
                "can-lid-suspend": "allow_lid_closed",
            }[action],
            False,
        )
    except (OSError, ValueError, KeyError, TypeError):
        return True


def client(directory: Path, request: dict[str, Any]) -> dict[str, Any]:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(3)
        connection.connect(str(directory / "control.sock"))
        connection.sendall(json.dumps(request).encode() + b"\n")
        with connection.makefile("rb") as response:
            result = json.loads(response.readline(65536))
    if "failure" in result:
        raise KeepawakeError(result["failure"])
    return result


def serve(filename: Path, directory: Path) -> None:
    init_config(filename)
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = directory.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        raise KeepawakeError(
            "Keep-awake runtime directory must be owned by you with mode 0700."
        )
    with (directory / "daemon.lock").open("w") as lockfile:
        try:
            fcntl.flock(lockfile, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise KeepawakeError("Keep-awake is already running.") from error
        engine = Engine(filename, directory)
        source = SystemFacts()
        stopping = threading.Event()

        class Handler(socketserver.StreamRequestHandler):
            def handle(self) -> None:
                self.request.settimeout(3)
                try:
                    request = json.loads(self.rfile.readline(8192))
                    if not isinstance(request, dict):
                        raise KeepawakeError("Requests must be objects.")
                    result = engine.command(cast(dict[str, Any], request))
                except (
                    OSError,
                    ValueError,
                    KeyError,
                    TypeError,
                    KeepawakeError,
                ) as error:
                    result = {"failure": str(error)}
                with contextlib.suppress(OSError):
                    self.wfile.write(json.dumps(result).encode() + b"\n")

        @final
        class Server(socketserver.ThreadingUnixStreamServer):
            daemon_threads = True

        socket_path = directory / "control.sock"
        socket_path.unlink(missing_ok=True)
        engine.poll(source)
        with Server(str(socket_path), Handler) as server:
            thread = threading.Thread(target=server.serve_forever, daemon=True)
            thread.start()

            def stop(_number: int, _frame: Any) -> None:
                stopping.set()

            for signum in (signal.SIGTERM, signal.SIGINT):
                signal.signal(signum, stop)
            try:
                while not stopping.wait(engine.config.get("poll_seconds", 5)):
                    engine.poll(source)
            finally:
                server.shutdown()
                thread.join()
                socket_path.unlink(missing_ok=True)
                (directory / "status.json").unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=config_path())
    sub = parser.add_subparsers(dest="action", required=True)
    for command in (
        "serve",
        "status",
        "toggle",
        "pause",
        "resume",
        "toggle-pause",
        "can-suspend",
        "can-screen-sleep",
        "can-lid-suspend",
        "init",
        "check-config",
    ):
        sub.add_parser(command)
    start = sub.add_parser("start")
    end = start.add_mutually_exclusive_group()
    end.add_argument("--duration")
    end.add_argument("--until")
    end.add_argument("--process")
    end.add_argument("--pid", type=int)
    end.add_argument("--file")
    start.add_argument("--quiet-seconds", type=int, default=60)
    start.add_argument(
        "--keep-display-awake", action=argparse.BooleanOptionalAction, default=None
    )
    start.add_argument(
        "--allow-lid-closed", action=argparse.BooleanOptionalAction, default=None
    )
    stop = sub.add_parser("stop")
    stop.add_argument("--id")
    args = parser.parse_args()
    try:
        if args.action == "init":
            init_config(args.config)
            print(args.config)
        elif args.action == "check-config":
            load_config(args.config)
            print("Configuration is valid")
        elif args.action.startswith("can-"):
            return 0 if can_idle(args.action, runtime_dir()) else 1
        elif args.action == "serve":
            serve(args.config, runtime_dir())
        else:
            request = {
                key: value
                for key, value in vars(args).items()
                if key != "config" and value is not None
            }
            print(json.dumps(client(runtime_dir(), request)))
    except (OSError, ValueError, subprocess.SubprocessError, KeepawakeError) as error:
        # Missing runtime/daemon releases automatic sleep rather than disabling it.
        if args.action.startswith("can-"):
            return 0
        print(f"keepawake: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
