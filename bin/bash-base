#!/usr/bin/env bash

[[ "${TRACE}" ]] && set -x
set -euo pipefail
shopt -s nullglob

main() {
  if [[ -f "$1" ]]; then
    existing-file "$1"
  else
    new-file "$1"
  fi

  chmod +x "$1"
}

header() {
  cat <<EOF
#!/usr/bin/env bash

[[ "\${TRACE}" ]] && set -x
set -eou pipefail
shopt -s nullglob

main() {
EOF
}

footer() {
  cat <<EOF
}

main "\$@"
EOF
}

new-file() {
  header > "$1"
  footer >> "$1"
}

existing-file() {
  local temp_file
  temp_file="$(mktemp)"

  header > "${temp_file}"
  # Drop the original shebang, indent with 2 spaces and clean up whitespace-only lines.
  # Only line 1 is a shebang: a "#!/" later in the body is script content.
  sed -e '1{/^#!/d;}' -e 's/^/  /' -e 's/[[:blank:]]*$//' "$1" >> "${temp_file}"
  footer >> "${temp_file}"

  mv "${temp_file}" "$1"
}

main "$@"
