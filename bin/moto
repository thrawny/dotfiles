#!/usr/bin/env python3
"""Track the worker sessions a driver session starts in Herdr.

The driver is a Claude session that hands each task to a worker: a Claude
session in its own Herdr tab, usually in its own worktree. This command is the
driver's toolbelt. It starts workers, lists them with their live Herdr state,
takes reports from workers, waits until a worker needs the driver, and cleans
up after a merge. A task blocked for a while can be snoozed: its worktree and
workspace go away, and wake brings them back on the same Claude session.
When the user resumes a worker's session in a new pane, moto attach moves the
task to that pane, so moto stops calling it gone. Claude's SessionStart hook
runs moto attach --hook, which records each worker's session id and does that
move by itself.

When the user closes a worker's pane by hand, the watch tells the driver once
the pane has stayed gone for PANE_GONE_GRACE, held tasks included, and marks
the task closed_at. moto list shows the mark, a later attach clears it, and
close counts a pane that closed after the user's last turn in it as the user
being done with it.

The watch stays quiet about a turn end that is not the driver's business: the
user talking to a worker, a worker whose background shells still run, or a
turn it already reported. It logs each one as an absorb event instead. Each
moto watch is one pass, printed as JSON. The moto-watch Claude Code mod, which
moto focus loads into the driver, runs a pass every few seconds and prompts the
driver with the news. Notes that scheduled jobs left ride along.

The user ends a worker's work by running the moto-wrap skill in its pane, which
reports wrap, a done that also lists what still runs. A held worker goes back to
the driver with the moto-handback skill, which reports handback: what the user
and the worker settled, for the driver to act on. The moto-snooze skill parks a
worker that waits on something: it reports snooze with what the task waits on,
and the driver runs moto snooze, since a worker that snoozes itself closes its
own pane mid-turn. All three end a hold, so the driver hears of them.

The user also runs those skills in Claude sessions they started by hand, which
no task owns. A wrap, snooze or handback from one adopts the session first: it
becomes a task built from its Herdr pane, its git checkout and its Claude
session id, logged as an adopt event, and the report lands as usual. moto made
none of that session's surroundings, so close and snooze close only its tab,
and remove its checkout only when it is a linked worktree that no other tab
works in.

moto list shows what happened in a held or snoozed task since its last
report, because the driver sees none of it: the user's turns in the worker's
pane, the user's new commits on its branch, and the last change to its PR.

moto afk records that the user is away, with their note word for word, and
moto back ends it with a brief of what happened meanwhile. moto stores and
shows the note but never reads it; the driver's own instructions decide what
it allows. moto log-action records what the driver did, for that brief.

Tasks live in $XDG_STATE_HOME/moto/tasks.json. herdr-decorator reads the same
file to show a worker's open question under its sidebar row.

Every command that changes a task also appends a line to events.jsonl in the
same folder, which nothing rewrites: a task's history outlives the task.
close and drop copy the whole task into their line before deleting it.
close refuses a worker that is mid-turn, or that the user typed to since its
last report, because a done report can be stale by then.
moto log prints those lines.

moto link puts the moto-* skills in ~/.claude/skills as symlinks, outside Home
Manager: the generic ones from moto/skills in dotfiles, and the Epidemic ones
from skills/ in MOTO_HOME. An Epidemic skill replaces a generic one of the same
name.

moto job runs work on a clock: a job file in MOTO_HOME/jobs names a time,
a cheap check, and whether the result wakes the driver or starts a worker.
Without a brief, the job follows the .md file of the same name beside it.
moto job loop is the scheduler, and its state is jobs.json beside tasks.json.

A worker can start workers of its own, which the driver's watch skips. moto
tell and wake from a worker's pane reach only the tasks it started, and tag the
message with the worker's name instead of [driver]. A worker that hands work
off instead runs moto spawn --to-driver: the task gets no parent, the driver
watches it as its own, and requested_by records the worker that asked for it.

fork-window starts a fork of a worker or the driver with MOTO_FORK set. A fork
is neither: the hooks skip it, and every command that changes a task or speaks
for the driver refuses to run in it.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import tomllib
from collections.abc import Generator
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager, suppress
from datetime import datetime, timedelta
from datetime import time as dt_time
from pathlib import Path
from typing import Any, cast

MOTO_HOME = Path(os.environ.get("MOTO_HOME") or Path.home() / "code/moto")
# Claude Code stops a background command at its Bash timeout, 30 minutes by
# A report lands a moment before the worker's turn ends. Holding it back this
# long lets the turn end first, so one wake covers both.
REPORT_SETTLE_SECONDS = 20
# How long a turn end waits for the worker's transcript to catch up with Herdr,
# and for the next turn to start once the worker's background work finishes.
TURN_SETTLE_SECONDS = 10
# Background work keeps a turn end quiet this long, then the driver hears of it.
BUSY_LIMIT = 15 * 60
# Claude wraps a pasted prompt, such as a long brief, in this tag.
PASTED = re.compile(r"^\s*(<pasted_content[^>]*>\s*)?")
# Claude's footer counts background work Herdr does not, as in "· 1 shell ·".
BACKGROUND_WORK = re.compile(
    r"· (\d+ (?:shells?|monitors?|local agents?))(?= ·|$)", re.M
)
REPORT_KINDS = ("done", "question", "blocked", "wrap", "handback", "snooze")
# Reports that make a session the user started, which no task owns, a task:
# the user handing it to the driver to finish, park or carry on.
ADOPT_KINDS = ("wrap", "snooze", "handback")
# Reports that end the task's work, so it needs no watch once the driver saw them.
FINISHED = ("done", "wrap")
# Reports from the user ending the worker on purpose, so close needs no idle pane.
ENDED_BY_USER = ("wrap", "snooze")
# A closed pane is news only once it has stayed gone this long, because the user
# may be resuming its session in a new pane, which attach then moves the task to.
PANE_GONE_GRACE = 2 * 60
# Herdr states of an agent that is mid-turn or waiting at a prompt.
BUSY = ("working", "blocked")
# moto list asks GitHub when a held task's PR last changed, and gives up after this.
PR_TIMEOUT = 3
PR_URL = re.compile(r"https://github\.com/[^/\s]+/[^/\s]+/pull/\d+")
CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
# The generic moto skills, next to this script in dotfiles.
CORE_SKILLS = Path(__file__).resolve().parents[1] / "moto/skills"
# The Claude Code mod that watches workers from inside the driver session.
WATCH_MOD = Path(__file__).resolve().parents[1] / "moto/claude/mods/moto-watch"

# Marks every prompt the driver sends, so a worker can tell it from the user's own typing.
# A worker's prompts to the workers it started carry its own name instead.
DRIVER_TAG = "[driver]"
REPORT_RULES = """\
When a turn ends with the task finished, with a question only the user can \
answer, or with the work blocked, make your last action \
`moto report done|question|blocked "<one line>"`. \
Put the PR URL in a done line when there is one. The user merges every PR, so \
stop once yours is ready."""
SPAWN_RULES = """\
To hand work off to a separate task, such as research that splits into \
implementation tasks, start it with `moto spawn --to-driver`, so the driver \
watches it. Start a helper you supervise yourself, such as a test worker, with \
plain `moto spawn`."""
BRIEF_FOOTER = f"""\
A driver session started you and tracks this task for the user. {REPORT_RULES}

Every message from the driver starts with {DRIVER_TAG}, as this one does. A \
message without it is from the user, typing in this pane. Answer the user here, \
and when the user and the driver disagree, follow the user. Still report to the \
driver when the task finishes, gets stuck or needs a decision.

{SPAWN_RULES}"""
CHILD_FOOTER = f"""\
Another worker, {{parent}}, started you and watches this task. A driver session \
tracks {{parent}} for the user. {REPORT_RULES}

Every message from {{parent}} starts with [{{parent}}], as this one does. A \
message that starts with {DRIVER_TAG} is from the driver, and a message with \
neither tag is from the user, typing in this pane. Answer the user here. When \
they disagree, follow the user first, then the driver, then {{parent}}.

{SPAWN_RULES}"""


UNTRACKED = (
    "No driver session is tracking this one, so there is nothing to report to. "
    + "Tell the user directly."
)
# What a fork may run: commands that only read, and hooks that skip forks.
FORK_SAFE = ("list", "log", "focus", "pin", "link")


# Scheduled jobs. The gate's exit codes are shepherd's, deliberately: a broken
# gate runs the job anyway, because a schedule that dies quietly is worse.
GATE_TIMEOUT = 120
GATE_SKIP = 75
JOB_TICK_SECONDS = 60
# A tick takes seconds; a loop silent for longer than this has stopped.
JOB_BEAT_STALE_SECONDS = 180
WEEKDAYS = {"mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6}
JOB_FIELDS = {
    "name",
    "at",
    "days",
    "gate",
    "deliver",
    "brief",
    "enabled",
    "stale_after",
    "repo",
    "worktree",
    "base",
    "agent",
    "title",
}
# Marks a scheduled job's prompt, so the driver and a worker can tell it from
# the driver's own messages and from the user's typing. It outranks neither.
JOB_TAG = "[job]"
JOB_FOOTER = f"""\
A scheduled moto job started you, and a driver session tracks this task for the \
user. {REPORT_RULES}

Messages from the driver start with {DRIVER_TAG}. A message without it is from \
the user, typing in this pane. Answer the user here, and when the user and the \
driver disagree, follow the user. A job is a trigger, not an authority: follow \
exactly the rules a worker the driver started follows, the user's away rules \
included."""

EVENTS_VERSION = 1


class MotoError(Exception):
    pass


# Events recorded during the current tasks_for_update, appended when it commits.
pending_events: list[dict[str, Any]] = []


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(base) / "moto"


def run(
    args: list[str],
    cwd: str | Path | None = None,
    timeout: int = 30,
    stdin: str | None = None,
) -> str:
    try:
        result = subprocess.run(
            args,
            cwd=cwd,
            input=stdin,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError as error:
        raise MotoError(f"Required executable not found: {args[0]}") from error
    if result.returncode:
        raise MotoError(
            result.stderr.strip() or result.stdout.strip() or f"{args[0]} failed"
        )
    return result.stdout


def herdr_binary() -> str:
    return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or "herdr"


def herdr(*args: str, timeout: int = 30) -> dict[str, Any]:
    output = run([herdr_binary(), *args], timeout=timeout)
    try:
        return json.loads(output)["result"]
    except (ValueError, KeyError, TypeError) as error:
        raise MotoError(f"herdr {' '.join(args[:2])} returned no result") from error


def herdr_request(method: str, params: dict[str, Any]) -> dict[str, Any]:
    """One socket API call, for methods the herdr CLI has no command for."""
    path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser(
        "~/.config/herdr/herdr.sock"
    )
    request = {"id": method, "method": method, "params": params}
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(10)
            sock.connect(path)
            sock.sendall((json.dumps(request) + "\n").encode())
            reply = json.loads(sock.makefile().readline() or "{}")
    except (OSError, ValueError) as error:
        raise MotoError(f"herdr {method}: {error}") from error
    if "result" not in reply:
        raise MotoError(f"herdr {method}: {reply.get('error') or 'no result'}")
    return reply["result"]


def live_agents() -> dict[str, dict[str, Any]]:
    """Herdr's agents by pane id."""
    return {a["pane_id"]: a for a in herdr("agent", "list")["agents"]}


def read_tasks() -> dict[str, dict[str, Any]]:
    try:
        data = json.loads((state_dir() / "tasks.json").read_text())
    except FileNotFoundError:
        return {}
    except ValueError as error:
        raise MotoError(f"{state_dir() / 'tasks.json'} is not valid JSON") from error
    return data.get("tasks", {})


def record(event: str, agent: str, **fields: Any) -> None:
    """Log an event; the enclosing tasks_for_update appends it if it commits."""
    pending_events.append(
        {"v": EVENTS_VERSION, "ts": time.time(), "event": event, "agent": agent}
        | fields
    )


def append_events(
    directory: Path, events: list[dict[str, Any]], tasks: dict[str, dict[str, Any]]
) -> None:
    """Append to the event log, opening it with a snapshot of every task."""
    path = directory / "events.jsonl"
    if not path.exists():
        now = time.time()
        events = [
            {"v": EVENTS_VERSION, "ts": now, "event": "snapshot", "agent": name}
            | {"task": task}
            for name, task in sorted(tasks.items())
        ] + events
    if events:
        with path.open("a") as log:
            log.write("".join(json.dumps(e) + "\n" for e in events))


@contextmanager
def tasks_for_update() -> Generator[dict[str, dict[str, Any]]]:
    """The task table under an exclusive lock, written back on exit if it changed.

    Events recorded inside are appended under the same lock, so log lines never
    interleave and a failed update logs nothing.
    """
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    with open(directory / "tasks.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        pending_events.clear()
        tasks = read_tasks()
        before = json.dumps(tasks, sort_keys=True)
        try:
            yield tasks
        except BaseException:
            pending_events.clear()
            raise
        append_events(directory, pending_events, json.loads(before))
        pending_events.clear()
        if json.dumps(tasks, sort_keys=True) != before:
            path = directory / "tasks.json"
            tmp = path.with_suffix(".tmp")
            tmp.write_text(json.dumps({"tasks": tasks}, indent=2) + "\n")
            tmp.replace(path)


def forked() -> bool:
    """Whether this runs in a session fork-window forked, which owns no task."""
    return bool(os.environ.get("MOTO_FORK"))


def find_task(tasks: dict[str, dict[str, Any]], agent: str) -> dict[str, Any]:
    if agent not in tasks:
        raise MotoError(f"No task named {agent}")
    return tasks[agent]


def caller(tasks: dict[str, dict[str, Any]]) -> str | None:
    """The task in the caller's Herdr pane, or None when the driver calls."""
    pane_id = os.environ.get("HERDR_PANE_ID")
    return next((n for n, t in tasks.items() if t["pane_id"] == pane_id), None)


def message_sender(
    tasks: dict[str, dict[str, Any]], agent: str, text: str
) -> str | None:
    """The worker sending a message to agent, or None for the driver.

    A worker can message only the tasks it started.
    """
    sender = caller(tasks)
    if sender is None:
        return None
    if parent := tasks[sender].get("parent"):
        hint = f"{parent} started you and reads your pane, so answer there"
    else:
        hint = "To reach the driver, use moto report"
    if agent not in tasks:
        raise MotoError(f"No task named {agent}. {hint}")
    if tasks[agent].get("requested_by") == sender:
        hint = "The driver watches it, so use moto report to pass something on"
    if tasks[agent].get("parent") != sender:
        raise MotoError(
            f"{sender} can message only the tasks it started, and {agent} is not one"
            + f" of them. {hint}"
        )
    if text.startswith(DRIVER_TAG):
        raise MotoError(
            f"Only the driver's messages start with {DRIVER_TAG}; moto tags yours"
            + f" [{sender}]"
        )
    return sender


def tag(sender: str | None) -> str:
    return f"[{sender}]" if sender else DRIVER_TAG


def decorator_links() -> dict[str, dict[str, str]]:
    """Pane id → the PR and Jira links herdr-decorator found for it."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    try:
        panes = json.loads((Path(base) / "herdr-decorator/panes.json").read_text())
    except (OSError, ValueError):
        return {}
    return {pane_id: info.get("links") or {} for pane_id, info in panes.items()}


def age(seconds: float) -> str:
    seconds = max(0, int(seconds))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{seconds // size}{unit}"
    return f"{seconds}s"


def timestamp(text: Any) -> float | None:
    try:
        return datetime.fromisoformat(text).timestamp()
    except (TypeError, ValueError):
        return None


def since_report(
    task: dict[str, Any],
    agent: dict[str, Any] | None,
    pr: str | None,
    events: list[dict[str, Any]],
) -> dict[str, Any] | None:
    """What happened in a held or snoozed task since its last report.

    The driver sees none of it, so the report may be stale. A task with no
    report counts from the hold. Every source is optional: a missing
    transcript, checkout or answer from GitHub leaves its count out.
    """
    if report := task.get("report"):
        mark, since = "report", report["at"]
    else:
        holds = [
            e["ts"]
            for e in events
            if e.get("event") == "hold" and e.get("agent") == task["agent"]
        ]
        if not holds:
            return None
        mark, since = "hold", holds[-1]
    turns = user_turns(task, agent, since)
    updated = pr_updated(pr) if pr else None
    return {
        "since": mark,
        "at": since,
        "turns": len(turns),
        "last_turn_at": max(turns, default=None),
        "commits": commits_since(task, since),
        "pr_updated_at": updated if updated and updated > since else None,
    }


def user_turns(
    task: dict[str, Any], agent: dict[str, Any] | None, since: float
) -> list[float]:
    """When the user typed each prompt into the worker's pane after since.

    Prompts from the driver, or from the worker that started this one, carry
    their sender's tag and do not count.
    """
    snooze = task.get("snoozed")
    try:
        if snooze:
            cwd = snooze.get("cwd") or task["cwd"]
            path: Path | None = session_dir(cwd) / f"{snooze['session']}.jsonl"
        else:
            path = transcript(task, agent)
        lines = path.read_text(errors="replace").splitlines() if path else []
    except (MotoError, OSError):
        return []
    tags = (DRIVER_TAG,) + ((f"[{task['parent']}]",) if task.get("parent") else ())
    times: list[float] = []
    for line in lines:
        if '"typed"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get("promptSource") != "typed" or entry.get("isSidechain"):
            continue
        at = timestamp(entry.get("timestamp"))
        if at is not None and at > since and not typed_text(entry).startswith(tags):
            times.append(at)
    return times


def commits_since(task: dict[str, Any], since: float) -> int | None:
    """How many commits the user made on the task's branch after since.

    Counting only the user's own commits leaves out what a merge or rebase
    brings in from the base branch. A snoozed worktree is gone, so its branch
    is read from the repo.
    """
    snooze: dict[str, Any] = task.get("snoozed") or {}
    cwd = task["cwd"] if os.path.isdir(task["cwd"]) else task["repo"]
    ref = snooze.get("branch") or "HEAD"
    try:
        email = run(["git", "config", "user.email"], cwd=cwd, timeout=5).strip()
        log = run(
            ["git", "log", f"--since=@{int(since)}", "--format=%ct"]
            + ["--fixed-strings", f"--author=<{email}>", ref, "--"],
            cwd=cwd,
            timeout=5,
        )
    except (MotoError, subprocess.TimeoutExpired):
        return None
    return len(log.split())


def pr_updated(url: str) -> float | None:
    """When the PR last changed, or None when GitHub does not answer in time."""
    try:
        output = run(
            ["gh", "pr", "view", url, "--json", "updatedAt", "--jq", ".updatedAt"],
            timeout=PR_TIMEOUT,
        )
    except (MotoError, subprocess.TimeoutExpired):
        return None
    return timestamp(output.strip())


def activity_line(info: dict[str, Any] | None, now: float) -> str | None:
    """since_report as one line, or None when nothing happened."""
    if not info:
        return None
    parts: list[str] = []
    if turns := info["turns"]:
        plural = "s" if turns != 1 else ""
        last = age(now - info["last_turn_at"])
        parts.append(f"{turns} turn{plural} with the user, last {last} ago")
    if commits := info["commits"]:
        parts.append(f"{commits} commit{'s' if commits != 1 else ''}")
    if updated := info["pr_updated_at"]:
        parts.append(f"PR updated {age(now - updated)} ago")
    return f"since the {info['since']}: " + " · ".join(parts) if parts else None


# The worker's Claude model and effort, which spawn-session passes to claude.
MODEL_FLAGS = ("model", "effort")
EFFORTS = ("low", "medium", "high", "xhigh", "max")


def start_worker(
    spec: dict[str, Any],
    prompt: str,
    parent: str | None,
    requested_by: str | None = None,
) -> dict[str, Any]:
    """Open a worker's pane on this prompt and record its task.

    spec holds the spawn flags; prompt is the whole first message, its tag and
    footer included, because a scheduled job tags and footers its workers
    differently from the driver.
    """
    command = ["spawn-session", "--json", "--repo", str(spec["repo"])]
    for flag in ("worktree", "base", "name", "title", "resume", "pane", *MODEL_FLAGS):
        if value := spec.get(flag):
            command += [f"--{flag}", str(value)]
    # Worktree creation, agent startup and the first prompt each wait on Herdr.
    output = run(command, timeout=600, stdin=prompt)
    try:
        info: dict[str, Any] = json.loads(output)
    except ValueError as error:
        raise MotoError(f"spawn-session printed no JSON: {output.strip()}") from error
    now = time.time()
    with tasks_for_update() as tasks:
        tasks[info["agent"]] = {
            "agent": info["agent"],
            "repo": info["repo"],
            "branch": info.get("branch"),
            "pane_id": info["pane_id"],
            "workspace_id": info["workspace_id"],
            "tab_id": info["tab_id"],
            "cwd": info["cwd"],
            "title": spec.get("title"),
            "started": now,
            "told": now,
            "report": None,
            "pr": None,
            "seen": {"status": "working"},
        } | ({"parent": parent} if parent else {})
        if requested_by:
            tasks[info["agent"]]["requested_by"] = requested_by
        # Kept so wake resumes the session on the model it started with.
        for flag in MODEL_FLAGS:
            if value := spec.get(flag):
                tasks[info["agent"]][flag] = value
        record(
            "spawn",
            info["agent"],
            repo=info["repo"],
            branch=info.get("branch"),
            worktree=info["cwd"] if info.get("branch") else None,
            title=spec.get("title"),
            session=spec.get("resume"),
            parent=parent,
            requested_by=requested_by,
            model=spec.get("model"),
            effort=spec.get("effort"),
        )
    return info


def cmd_spawn(args: argparse.Namespace) -> int:
    brief = sys.stdin.read().strip()
    if not brief:
        raise MotoError("Pass the task brief on stdin")
    # A worker that starts its own worker watches it itself, unless it hands the
    # task to the driver, which then treats it as one it started.
    worker = caller(read_tasks())
    requested_by = worker if getattr(args, "to_driver", False) else None
    parent = None if requested_by else worker
    footer = CHILD_FOOTER.format(parent=parent) if parent else BRIEF_FOOTER
    spec = {
        flag: getattr(args, flag, None)
        for flag in (
            "repo",
            "worktree",
            "base",
            "name",
            "title",
            "resume",
            "pane",
            *MODEL_FLAGS,
        )
    }
    info = start_worker(
        spec, f"{tag(parent)} {brief}\n\n{footer}\n", parent, requested_by
    )
    if getattr(args, "json", False):
        print(json.dumps(info))
        return 0
    where = f"{Path(info['repo']).name} {info.get('branch') or '(main checkout)'}"
    print(f"Started {info['agent']} on {where}")
    if parent:
        print(f"moto watch skips it, since {parent} started it; watch it yourself")
    elif requested_by:
        print(
            f"The driver watches {info['agent']}, so you cannot moto tell it."
            + " To pass anything on, moto report to the driver."
        )
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    tasks = read_tasks()
    try:
        live: dict[str, dict[str, Any]] | None = live_agents()
    except MotoError:
        live = None
    links = decorator_links()
    now = time.time()
    rows: list[dict[str, Any]] = []
    # Held and snoozed tasks, whose last report may be stale.
    stale: list[tuple[dict[str, Any], dict[str, Any], dict[str, Any] | None]] = []
    for name, task in sorted(tasks.items()):
        agent = live.get(task["pane_id"]) if live is not None else None
        status = (
            "unknown" if live is None else (agent or {}).get("agent_status", "gone")
        )
        if task.get("snoozed"):
            status = "snoozed"
        elif status == "gone" and (closed := task.get("closed_at")):
            status = f"pane closed by hand {age(now - closed)} ago"
        pr = task.get("pr") or links.get(task["pane_id"], {}).get("pr")
        rows.append({**task, "name": name, "status": status, "pr": pr})
        if task.get("held") or task.get("snoozed"):
            stale.append((rows[-1], task, agent))
    if stale:
        # Each task's checks run side by side, so a slow GitHub costs PR_TIMEOUT once.
        events = read_events()
        with ThreadPoolExecutor() as pool:
            found = [
                pool.submit(since_report, task, agent, row["pr"], events)
                for row, task, agent in stale
            ]
        for (row, _, _), future in zip(stale, found, strict=True):
            row["since_report"] = future.result()
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if away := read_afk():
        print(
            f"The user is away since {clock(away['since'])} ({age(now - away['since'])})."
        )
        print(f"  Note: {away['note'] or 'none, so no instructions'}")
    if not rows:
        print("No tasks.")
        print_jobs(now)
        return 0
    if live is None:
        print("Herdr is unavailable, so live states are unknown.")
    snoozed = [row for row in rows if row.get("snoozed")]
    for row in rows:
        if row.get("snoozed"):
            continue
        branch = row.get("branch") or "main checkout"
        held = " · held by the user" if row.get("held") else ""
        if parent := row.get("parent"):
            held += f" · started by {parent}"
        elif requested_by := row.get("requested_by"):
            held += f" · requested by {requested_by}"
        print(
            f"{row['name']} · {Path(row['repo']).name} · {branch} · {row['status']}{held}"
        )
        if row["pr"]:
            print(f"  PR: {row['pr']}")
        if report := row.get("report"):
            ago = age(now - report["at"])
            print(f"  {report['kind']} ({ago} ago): {report['text']}")
        if line := activity_line(row.get("since_report"), now):
            print(f"  {line}")
    if snoozed:
        print("\nSnoozed:")
    for row in snoozed:
        snooze = row["snoozed"]
        branch = snooze.get("branch") or row.get("branch") or "main checkout"
        ago = age(now - snooze["at"])
        print(f"{row['name']} · {Path(row['repo']).name} · {branch} · {ago}")
        print(f"  {snooze.get('reason') or 'no reason recorded'}")
        if row["pr"]:
            print(f"  PR: {row['pr']}")
        if line := activity_line(row.get("since_report"), now):
            print(f"  {line}")
    print_jobs(now)
    return 0


def git_checkout(cwd: str) -> tuple[str, str | None, str | None]:
    """The repo a folder belongs to, the branch when the folder is in a linked
    worktree, and the checked-out branch.

    A main checkout gives no linked branch, nor does a detached worktree, so
    close never removes either. A folder outside git is its own repo.
    """
    try:
        top, common, git_dir = run(
            ["git", "rev-parse", "--path-format=absolute", "--show-toplevel"]
            + ["--git-common-dir", "--git-dir"],
            cwd=cwd,
        ).splitlines()
    except (MotoError, ValueError, OSError):
        return cwd, None, None
    try:
        current: str | None = run(
            ["git", "symbolic-ref", "--quiet", "--short", "HEAD"], cwd=cwd
        ).strip()
    except MotoError:
        current = None
    if Path(common) == Path(git_dir):
        return top, None, current
    return str(Path(common).parent), current, current


def adopted_name(
    tasks: dict[str, dict[str, Any]],
    live: dict[str, dict[str, Any]],
    sources: list[str | None],
) -> str:
    """A task name from the first of sources that gives one, unique in moto and Herdr.

    A Jira key wins, as in abc-242 for ABC-242-retry-timeouts, the way the
    driver names its workers. Otherwise the first three words, as in
    widgets-api-notes.
    """
    base = ""
    for source in sources:
        if not source:
            continue
        if key := re.match(r"[A-Za-z]+-\d+", source):
            base = key.group(0).lower()
        else:
            base = "-".join(re.findall(r"[a-z0-9]+", source.lower())[:3])
        if base:
            break
    if not base[:1].isalpha():
        base = f"session-{base}".rstrip("-")
    base = base[:28]
    taken = set(tasks) | {a.get("name") for a in live.values()}
    name, suffix = base, 2
    while name in taken:
        name, suffix = f"{base}-{suffix}", suffix + 1
    return name


def adopt(tasks: dict[str, dict[str, Any]], pane_id: str | None) -> str | None:
    """Make the Claude session in this pane a task, or None when it may not be one.

    The user started it by hand, so moto takes what it finds: the pane, tab and
    workspace from Herdr, the repo and branch from the checkout Claude runs in.
    The driver's own pane stays untracked, like a pane outside Herdr or without
    Claude; main refuses a fork before this runs. A session a task already
    owns, resumed in a pane the SessionStart hook missed, moves its task here
    rather than becoming a second one.
    """
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not pane_id or not session or forked():
        return None
    try:
        live = live_agents()
    except MotoError:
        return None
    agent = live.get(pane_id) or {}
    # The pane's own cwd, where Claude started; foreground_cwd moves with programs.
    cwd = agent.get("cwd") or os.getcwd()
    if agent.get("agent") != "claude" or (
        read_driver().get("pane_id") == pane_id or driver_cwd({"cwd": cwd})
    ):
        return None
    for name, task in tasks.items():
        if task.get("session") == session and not task.get("snoozed"):
            attach(tasks, name, pane_id, live)
            return name
    repo, branch, current = git_checkout(cwd)
    path = session_dir(cwd) / f"{session}.jsonl"
    title = last_title(path) if path.is_file() else None
    named = agent.get("name")
    name = (
        named
        if named and named not in tasks
        else adopted_name(
            tasks,
            live,
            [
                branch,
                title,
                agent.get("terminal_title_stripped"),
                current,
                Path(repo).name,
            ],
        )
    )
    # moto tell and the watch reach a worker by its Herdr name.
    herdr("agent", "rename", pane_id, name)
    now = time.time()
    tasks[name] = {
        "agent": name,
        "repo": repo,
        "branch": branch,
        "pane_id": pane_id,
        "workspace_id": agent["workspace_id"],
        "tab_id": agent["tab_id"],
        "cwd": cwd,
        "title": title,
        "started": now,
        "told": now,
        "report": None,
        "pr": None,
        # The report about to land is news; the pane's state so far is not.
        "seen": {
            "status": agent.get("agent_status"),
            "seq": agent.get("state_change_seq"),
        },
        "session": session,
        "adopted": True,
    }
    record(
        "adopt",
        name,
        repo=repo,
        branch=branch,
        worktree=cwd if branch else None,
        pane_id=pane_id,
        session=session,
        title=title,
    )
    return name


def cmd_report(args: argparse.Namespace) -> int:
    pane_id = os.environ.get("HERDR_PANE_ID")
    text = " ".join(args.text).strip()
    with tasks_for_update() as tasks:
        if args.agent:
            task = find_task(tasks, args.agent)
        else:
            task = next((t for t in tasks.values() if t["pane_id"] == pane_id), None)
            if task is None and args.kind in ADOPT_KINDS:
                if adopted := adopt(tasks, pane_id):
                    task = tasks[adopted]
                    print(f"moto now tracks this session as {adopted} for the driver.")
                    if args.kind == "handback":
                        print(REPORT_RULES)
            if task is None:
                # Dropped tasks keep the brief that asks for reports.
                print(UNTRACKED)
                return 0
            # The SessionStart hook runs before spawn records the task, so a
            # new worker's session id arrives with its first report.
            if session := os.environ.get("CLAUDE_CODE_SESSION_ID"):
                task["session"] = session
        handed_back = args.kind in ("wrap", "handback", "snooze") and bool(
            task.get("held")
        )
        if handed_back:
            # The watch takes the task back from here, so this report is news to
            # it and whatever happened while held is not.
            task["held"] = False
            previous: dict[str, Any] = task.get("report") or {}
            task["seen"] = {
                k: v for k, v in task.get("seen", {}).items() if k != "pending"
            } | {"report_at": previous.get("at")}
            record("resume", task["agent"], by=args.kind)
        task["report"] = {"kind": args.kind, "text": text, "at": time.time()}
        record("report", task["agent"], kind=args.kind, text=text)
        if (match := PR_URL.search(text)) and match.group(0) != task.get("pr"):
            task["pr"] = match.group(0)
            record("pr", task["agent"], pr=task["pr"])
        held = bool(task.get("held"))
        parent = task.get("parent")
    if parent:
        print(
            f"Recorded. {parent} started you, not the driver, so the driver is not"
            + f" watching you. Answer here in your pane, where {parent} reads it."
        )
    elif held:
        # The driver's watch skips a held task, so nobody answers there.
        print(
            "Recorded. The user is driving this session and the driver is not"
            + " watching it, so ask the user directly in this pane."
        )
    else:
        again = "; moto watch covers this task again" if handed_back else ""
        print(f"Reported {args.kind} to the driver{again}.")
    return 0


def cmd_tell(args: argparse.Namespace) -> int:
    """Send a worker a prompt tagged with its sender: the driver or its parent."""
    text = " ".join(args.text).strip() or sys.stdin.read().strip()
    if not text:
        raise MotoError("Pass the message as arguments or on stdin")
    tasks = read_tasks()
    sender = message_sender(tasks, args.agent, text)
    task = find_task(tasks, args.agent)
    if task.get("snoozed"):
        raise MotoError(f"{args.agent} is snoozed; pass the message to moto wake")
    agent = task["agent"]
    herdr("agent", "prompt", agent, f"{tag(sender)} {text}")
    with tasks_for_update() as tasks:
        if agent in tasks:
            tasks[agent]["told"] = time.time()
        record("tell", agent, text=text, **{"from": sender or "driver"})
    print(f"Sent to {agent}.")
    return 0


def cmd_ask(args: argparse.Namespace) -> int:
    """Show the driver's question under its own sidebar row, or clear it.

    Clearing drops the question's own fields and keeps the rest, because
    driver.json also records where the driver is, which a scheduled job needs
    long after a question is answered.
    """
    if args.clear:
        driver = read_driver()
        for field in ("kind", "text", "at"):
            driver.pop(field, None)
        if driver:
            driver_path().write_text(json.dumps(driver) + "\n")
        else:
            driver_path().unlink(missing_ok=True)
        print("Cleared the driver's question.")
        return 0
    text = " ".join(args.text).strip()
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not text or not pane_id:
        raise MotoError("Pass the question, from inside the driver's Herdr pane")
    write_driver(pane_id=pane_id, kind="question", text=text, at=time.time())
    print("The question shows under the driver's sidebar row until moto ask --clear.")
    return 0


def check(
    tasks: dict[str, dict[str, Any]], live: dict[str, dict[str, Any]], now: float
) -> list[str]:
    """One line per task that needs the driver, updating each task's seen marker.

    A worker needs the driver when it reports, when its turn ends, when it waits at a
    prompt, and when its pane closes. Herdr's state_change_seq catches a turn
    that ended while nothing was watching. A done worker that someone looked at
    turns idle, and that is not news. turn_end decides which turn ends are news.
    A held task is news only when its pane closes; pane_closed decides when.
    """
    lines: list[str] = []
    for name, task in sorted(tasks.items()):
        if not pane_watched(task):
            continue
        seen: dict[str, Any] = task.setdefault("seen", {})
        agent = live.get(task["pane_id"])
        status = agent.get("agent_status") if agent else "gone"
        seq = agent.get("state_change_seq") if agent else None
        if status == "unknown":
            continue
        if closed := pane_closed(name, task, status == "gone", now):
            lines.append(closed)
        if unwatched(task):
            continue
        report: dict[str, Any] | None = task.get("report")
        fresh = report is not None and report["at"] != seen.get("report_at")
        if status == "working":
            changed = False
            seen.pop("pending", None)  # a new turn started
            fresh = (
                fresh
                and report is not None
                and now - report["at"] >= REPORT_SETTLE_SECONDS
            )
        elif status == "gone":
            changed = False  # pane_closed reports it, once it has stayed gone
        elif status == "idle":
            changed = seen.get("status") == "working"
        else:
            changed = seq != seen.get("seq")
        seen["status"], seen["seq"] = status, seq
        line = None
        if fresh and report is not None:
            seen["report_at"] = report["at"]
            line = f"{name} {report['kind']}: {report['text']}"
            if task.get("closed_at"):
                line += " (pane closed)"
        elif changed and status == "blocked":
            line = f"{name} blocked: waiting at an approval or question prompt"
        elif status in ("done", "idle") and (changed or "pending" in seen):
            line = turn_end(name, task, agent, now)
            if line:
                lines.append(line)
            continue
        if line:
            seen.pop("pending", None)
            lines.append(line)
    return lines


def pane_closed(name: str, task: dict[str, Any], gone: bool, now: float) -> str | None:
    """The line for a pane the user closed, once, or None.

    A pane counts as closed once it has stayed gone for PANE_GONE_GRACE, so a
    session resumed in a new pane, which attach moves the task to, is never
    news. closed_at marks the task until a live pane clears it.
    """
    seen = task["seen"]
    if not gone:
        seen.pop("gone_since", None)
        task.pop("closed_at", None)
        return None
    since = seen.setdefault("gone_since", now)
    if task.get("closed_at") or now - since < PANE_GONE_GRACE:
        return None
    task["closed_at"] = since
    record("pane_closed", name, pane_id=task["pane_id"], at=since)
    return f"{name}: pane closed"


def turn_end(
    name: str, task: dict[str, Any], agent: dict[str, Any] | None, now: float
) -> str | None:
    """The line for a turn that ended without a report, or None to stay quiet.

    Quiet, and logged as an absorb event, when the user is talking to the worker,
    when the worker reported since the driver last wrote to it, or when Herdr
    announces a turn the watch already handled. A turn end stays pending while
    the worker's background work runs, up to BUSY_LIMIT, and is rechecked every
    poll. With no transcript to read, every turn end is news.
    """
    seen = task["seen"]
    pending: dict[str, Any] = seen.setdefault("pending", {"since": now})
    turn, prompt = last_turn(task, agent)
    reason = None
    report: dict[str, Any] | None = task.get("report")
    told = task.get("told")
    if turn is not None and turn == seen.get("turn"):
        if now - pending["since"] < TURN_SETTLE_SECONDS:
            return None  # the transcript may not hold the new turn yet
        reason = "Herdr announced a turn the watch already handled"
    elif prompt is not None and not prompt.startswith(DRIVER_TAG):
        reason = "the user is talking to the worker"
    elif report and told is not None and report["at"] >= told:
        reason = "it reported since the driver last wrote to it"
    work = None if reason else background_work(task["pane_id"])
    if work and now - pending["since"] < BUSY_LIMIT:
        pending["busy_at"] = now
        if not pending.get("logged"):
            pending["logged"] = True
            record("absorb", name, reason=f"{work} still running", turn=turn)
        return None
    busy_at = pending.get("busy_at")
    if not reason and busy_at is not None and now - busy_at < TURN_SETTLE_SECONDS:
        return None  # its background work just ended, so a new turn may start
    del seen["pending"]
    seen["turn"] = turn
    if reason:
        record("absorb", name, reason=reason, turn=turn)
        return None
    if work:
        running = age(now - pending["since"])
        return (
            f"{name}: turn ended without a report; {work} still running after {running}"
        )
    return f"{name}: turn ended without a report"


def last_turn(
    task: dict[str, Any], agent: dict[str, Any] | None
) -> tuple[str | None, str | None]:
    """The uuid of the worker's last reply and its last typed prompt, from its transcript.

    Claude marks a prompt typed into the pane, by a person or by herdr agent
    prompt, apart from the ones it makes itself, such as a background task's
    notification. A pasted prompt comes wrapped in a pasted_content tag.
    """
    try:
        path = transcript(task, agent)
        lines = path.read_text(errors="replace").splitlines() if path else []
    except (MotoError, OSError):
        return None, None
    turn = prompt = None
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get("isSidechain"):
            continue
        if turn is None and entry.get("type") == "assistant":
            turn = entry.get("uuid")
        elif prompt is None and entry.get("promptSource") == "typed":
            prompt = typed_text(entry)
        if turn is not None and prompt is not None:
            break
    return turn, prompt


def typed_text(entry: dict[str, Any]) -> str:
    """A typed prompt's text, unwrapped from a pasted_content tag."""
    message: dict[str, Any] = entry.get("message") or {}
    content: str | list[dict[str, Any]] = message.get("content") or ""
    if isinstance(content, list):
        content = "".join(str(b.get("text") or "") for b in content)
    return PASTED.sub("", content, count=1)


def background_work(pane_id: str) -> str | None:
    """What the worker's footer says still runs, as in "1 shell", or None."""
    try:
        screen = run([herdr_binary(), "pane", "read", pane_id, "--source", "visible"])
    except (MotoError, subprocess.TimeoutExpired):
        return None
    found = BACKGROUND_WORK.findall("\n".join(screen.splitlines()[-3:]))
    return " and ".join(found) or None


def unwatched(task: dict[str, Any]) -> bool:
    """A held task is the user's, a snoozed one has no pane, and a worker that
    started another one watches it, so moto watch skips all three."""
    return bool(task.get("held") or task.get("snoozed") or task.get("parent"))


def pane_watched(task: dict[str, Any]) -> bool:
    """Whether moto watch looks for a closed pane, which it does for held tasks too."""
    return not (task.get("snoozed") or task.get("parent"))


def watch() -> dict[str, Any]:
    """One pass for the moto-watch mod, which runs it every few seconds in the driver.

    watching counts the tasks the pass covers, lines has one line per worker that
    needs the driver, and notes holds what scheduled jobs left, removed as the
    pass hands them over, or None.
    """
    with tasks_for_update() as tasks:
        watching = sum(1 for t in tasks.values() if not unwatched(t))
        panes = any(pane_watched(t) for t in tasks.values())
        lines = check(tasks, live_agents(), time.time()) if panes else []
    return {"watching": watching, "lines": lines, "notes": take_notes()}


def cmd_watch(_: argparse.Namespace) -> int:
    print(json.dumps(watch()))
    return 0


def exit_on_signal(number: int, _frame: object) -> None:
    sys.exit(128 + number)


def unsaved_work(cwd: str, branch: str | None = None) -> str | None:
    """Why removing this checkout would lose work, or None when it is safe.

    With a branch, cwd is the repo and the check covers that branch's commits,
    for a branch no worktree has checked out.
    """
    if branch is None and run(["git", "status", "--porcelain"], cwd=cwd).strip():
        return "the worktree has uncommitted changes"
    ref = f"refs/heads/{branch}" if branch else "HEAD"
    unpushed = int(
        run(["git", "rev-list", "--count", ref, "--not", "--remotes"], cwd=cwd)
    )
    if unpushed == 0:
        return None
    # A squash merge leaves the branch's own commits off every remote branch.
    pr: dict[str, Any]
    try:
        pr = json.loads(
            run(
                ["gh", "pr", "view", *([branch] if branch else [])]
                + ["--json", "state,headRefOid"],
                cwd=cwd,
            )
        )
    except (MotoError, ValueError):
        pr = {}
    head = run(["git", "rev-parse", ref], cwd=cwd).strip()
    if pr.get("state") == "MERGED" and pr.get("headRefOid") == head:
        return None
    commits = "1 commit is" if unpushed == 1 else f"{unpushed} commits are"
    return f"{commits} on no remote and in no merged PR"


def checkout_workspace(path: str) -> str | None:
    """The Herdr workspace opened on this checkout, if any."""
    for workspace in herdr("workspace", "list")["workspaces"]:
        worktree: dict[str, Any] = workspace.get("worktree") or {}
        if worktree.get("checkout_path") == path:
            return workspace["workspace_id"]
    # `workspace create --cwd` records no checkout, so fall back to a pane there.
    for pane in herdr("pane", "list")["panes"]:
        if pane.get("cwd") == path:
            return pane["workspace_id"]
    return None


def still_working(
    name: str, task: dict[str, Any], agent: dict[str, Any] | None
) -> str | None:
    """Why closing this worker could cut off its work, or None when it is safe.

    A done report alone is not enough: the user may have typed a new prompt
    into the pane since. A wrap or snooze report means the user ended the
    worker, so a busy pane is that turn finishing, but prompts after it still
    count, unless the user closed the pane after the last of them, which ends
    the worker too.
    """
    report: dict[str, Any] = task.get("report") or {}
    problems: list[str] = []
    status = agent.get("agent_status") if agent else None
    if status in BUSY and report.get("kind") not in ENDED_BY_USER:
        problems.append(f"{name} is {status}")
    since = report.get("at") or task.get("started") or 0
    turns = user_turns(task, agent, since)
    if (closed := task.get("closed_at")) and max(turns, default=0) <= closed:
        turns = []
    if turns:
        times = "time" if len(turns) == 1 else "times"
        mark = "its last report" if report else "it started"
        last = age(time.time() - max(turns))
        problems.append(
            f"the user typed in {name}'s pane {len(turns)} {times} since {mark},"
            + f" last {last} ago"
        )
    return "; ".join(problems) or None


def owns_worktree(task: dict[str, Any]) -> bool:
    """Whether close and snooze may remove the task's checkout.

    A spawned task with a branch made its own worktree. An adopted task ran
    where the user put it, often a tab in a repo workspace that other sessions
    share, so its checkout counts as its own only when it is a linked worktree
    that no pane outside the task's tab works in. A snoozed adopted task
    already settled this when it snoozed.
    """
    if not task.get("branch"):
        return False
    if not task.get("adopted"):
        return True
    if snooze := task.get("snoozed"):
        return bool(snooze.get("worktree"))
    try:
        top = Path(
            run(["git", "rev-parse", "--show-toplevel"], cwd=task["cwd"]).strip()
        )
    except (MotoError, OSError):
        return True  # the worktree is gone; its branch is still checked for work
    try:
        panes = herdr("pane", "list")["panes"]
    except MotoError:
        return False  # without Herdr nobody can tell who else works there
    for pane in panes:
        if pane.get("tab_id") == task["tab_id"]:
            continue
        for key in ("cwd", "foreground_cwd"):
            if (folder := pane.get(key)) and Path(folder).is_relative_to(top):
                return False
    return True


def release_adopted(task: dict[str, Any], own: bool, force: bool) -> None:
    """Close an adopted task's tab, and remove its worktree when it owns one.

    Only the tab goes, never the workspace, because the user may run other
    sessions as tabs beside it; Herdr closes a workspace with its last tab.
    """
    if not task.get("snoozed"):
        try:
            herdr("tab", "close", task["tab_id"])
        except MotoError:
            pass  # the tab is already gone
    if own and os.path.isdir(task["cwd"]):
        top = run(["git", "rev-parse", "--show-toplevel"], cwd=task["cwd"]).strip()
        flags = ["--force"] if force else []
        run(["git", "worktree", "remove", *flags, top], cwd=task["repo"], timeout=120)


def cmd_close(args: argparse.Namespace) -> int:
    live = {} if args.force else live_agents()
    with tasks_for_update() as tasks:
        task = find_task(tasks, args.agent)
        cwd, repo = task["cwd"], task["repo"]
        # A checkout close may not remove keeps its branch too.
        branch = task.get("branch") if owns_worktree(task) else None
        if not args.force and (
            # A snoozed task has no pane; Herdr may have reused its id.
            busy := still_working(
                args.agent,
                task,
                None if task.get("snoozed") else live.get(task["pane_id"]),
            )
        ):
            raise MotoError(
                f"{busy}; wait for it or ask the user, or pass --force to close anyway"
            )
        exists = os.path.isdir(cwd)
        if branch and not args.force:
            # A snoozed task's branch has no worktree, so check the branch itself.
            problem = unsaved_work(cwd) if exists else unsaved_work(repo, branch)
            if problem:
                raise MotoError(
                    f"{args.agent}: {problem}; pass --force to remove anyway"
                )
        if task.get("adopted"):
            release_adopted(task, bool(branch), args.force)
        elif branch:
            workspace = checkout_workspace(cwd)
            force = ["--force"] if args.force else []
            if workspace:
                herdr(
                    "worktree", "remove", "--workspace", workspace, *force, timeout=120
                )
            elif exists:
                run(["git", "worktree", "remove", *force, cwd], cwd=repo, timeout=120)
        else:
            try:
                herdr("tab", "close", task["tab_id"])
            except MotoError:
                pass  # the tab is already gone
        # Its commits are pushed or merged, so the local branch is a copy.
        if branch and not args.force:
            try:
                run(["git", "branch", "-D", branch], cwd=repo)
            except MotoError:
                pass
        record("close", args.agent, force=args.force, task=tasks.pop(args.agent))
    print(f"Closed {args.agent}")
    return 0


def cmd_drop(args: argparse.Namespace) -> int:
    with tasks_for_update() as tasks:
        find_task(tasks, args.agent)
        record("drop", args.agent, task=tasks.pop(args.agent))
    print(f"Dropped {args.agent}; its tab and worktree are untouched")
    return 0


def cmd_hold(args: argparse.Namespace) -> int:
    with tasks_for_update() as tasks:
        find_task(tasks, args.agent)["held"] = True
        record("hold", args.agent)
    print(f"Holding {args.agent}: moto watch skips it until moto resume")
    return 0


def mark_seen(task: dict[str, Any], live: dict[str, dict[str, Any]]) -> None:
    """Treat the pane's current state and the last report as already seen."""
    agent = live.get(task["pane_id"])
    report: dict[str, Any] = task.get("report") or {}
    task["seen"] = {
        "status": agent.get("agent_status") if agent else "gone",
        "seq": agent.get("state_change_seq") if agent else None,
        "report_at": report.get("at"),
    }


def resume(task: dict[str, Any], live: dict[str, dict[str, Any]]) -> None:
    """Hand a held task back, treating what happened while held as seen."""
    task["held"] = False
    mark_seen(task, live)


def cmd_resume(args: argparse.Namespace) -> int:
    live = live_agents()
    with tasks_for_update() as tasks:
        task = find_task(tasks, args.agent)
        if task.get("snoozed"):
            raise MotoError(f"{args.agent} is snoozed; bring it back with moto wake")
        resume(task, live)
        record("resume", args.agent)
    print(f"Resumed {args.agent}: moto watch covers it again")
    return 0


def attach(
    tasks: dict[str, dict[str, Any]],
    name: str,
    pane_id: str,
    live: dict[str, dict[str, Any]],
) -> None:
    """Move a task to another pane, treating what happened there so far as seen."""
    task = tasks[name]
    agent = live[pane_id]
    # The old pane may still carry the name, and Herdr names are unique.
    for other in live.values():
        if other.get("name") == name and other["pane_id"] != pane_id:
            herdr("agent", "rename", other["pane_id"], "--clear")
    herdr("agent", "rename", pane_id, name)
    old = task["pane_id"]
    task["pane_id"] = pane_id
    task["workspace_id"] = agent["workspace_id"]
    task["tab_id"] = agent["tab_id"]
    task.pop("closed_at", None)
    mark_seen(task, live)
    turn, _ = last_turn(task, agent)
    task["seen"]["turn"] = turn
    record("attach", name, pane_id=pane_id, previous=old)


def pane_owner(tasks: dict[str, dict[str, Any]], pane_id: str) -> str | None:
    return next((n for n, t in tasks.items() if t["pane_id"] == pane_id), None)


def cmd_attach(args: argparse.Namespace) -> int:
    if args.hook:
        try:
            attach_hook(json.loads(sys.stdin.read() or "{}"))
        except Exception:  # a session start must never fail on moto
            pass
        return 0
    if not args.agent:
        raise MotoError("Name the task to attach, or pass --hook")
    pane_id = args.pane or os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        raise MotoError("Pass --pane, or run it from inside the worker's Herdr pane")
    live = live_agents()
    if (live.get(pane_id) or {}).get("agent") != "claude":
        raise MotoError(f"No live Claude agent in pane {pane_id}")
    with tasks_for_update() as tasks:
        task = find_task(tasks, args.agent)
        if task.get("snoozed"):
            raise MotoError(f"{args.agent} is snoozed; bring it back with moto wake")
        owner = pane_owner(tasks, pane_id)
        if owner == args.agent:
            raise MotoError(f"{args.agent} is already in pane {pane_id}")
        if owner:
            raise MotoError(f"Pane {pane_id} belongs to {owner}")
        attach(tasks, args.agent, pane_id, live)
    print(f"Attached {args.agent} to pane {pane_id}")
    return 0


def attach_hook(payload: dict[str, Any]) -> None:
    """Claude's SessionStart hook, for startup and resume.

    A task's own pane records its Claude session id. A session resumed in a
    pane no task owns moves the task with that session id to the pane. Reads
    tasks.json without the lock first, so the usual case costs no Herdr call.
    A fork gets a session id of its own, and the hook skips it anyway.
    """
    pane_id = os.environ.get("HERDR_PANE_ID")
    session = payload.get("session_id")
    if not pane_id or not session or forked():
        return
    tasks = read_tasks()
    owner = pane_owner(tasks, pane_id)
    if not owner and driver_cwd(payload):
        # A pane no task owns, running in MOTO_HOME, is the driver. A scheduled
        # job needs this to know where to send what it finds.
        write_driver(pane_id=pane_id, session=session)
    if owner:
        if tasks[owner].get("session") != session:
            with tasks_for_update() as tasks:
                if owner in tasks and tasks[owner]["pane_id"] == pane_id:
                    tasks[owner]["session"] = session
        return
    if not any(
        t.get("session") == session and not t.get("snoozed") for t in tasks.values()
    ):
        return
    # Herdr lists the agent by the time Claude runs this hook.
    live = live_agents()
    if pane_id not in live:
        return
    with tasks_for_update() as tasks:
        name = next(
            (
                n
                for n, t in tasks.items()
                if t.get("session") == session and not t.get("snoozed")
            ),
            None,
        )
        if name and not pane_owner(tasks, pane_id):
            attach(tasks, name, pane_id, live)


def session_dir(cwd: str) -> Path:
    """Where Claude keeps the sessions that ran in this folder."""
    return CLAUDE_HOME / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)


def last_title(session: Path) -> str | None:
    title = None
    with session.open(errors="replace") as lines:
        for line in lines:
            if '"customTitle"' not in line:
                continue
            try:
                title = json.loads(line).get("customTitle") or title
            except ValueError:
                pass
    return title


def newest_session(cwd: str, title: str) -> Path | None:
    """The transcript of the newest Claude session in this folder named title."""
    sessions = sorted(
        session_dir(cwd).glob("*.jsonl"), key=lambda s: s.stat().st_mtime, reverse=True
    )
    return next((s for s in sessions if last_title(s) == title), None)


def transcript(task: dict[str, Any], agent: dict[str, Any] | None) -> Path | None:
    """The worker's transcript: its recorded session's, else the newest one named
    after it. A fork of the worker copies the name, so the session id comes first."""
    session = task.get("session")
    path = session_dir(task["cwd"]) / f"{session}.jsonl"
    if session and path.is_file():
        return path
    return newest_session(task["cwd"], task_title(task, agent))


def find_session(cwd: str, title: str) -> str:
    """The id of the newest Claude session in this folder that is named title."""
    directory = session_dir(cwd)
    if not directory.is_dir():
        raise MotoError(f"No Claude sessions recorded for {cwd} in {directory}")
    if session := newest_session(cwd, title):
        return session.stem
    raise MotoError(f"No Claude session in {directory} is named {title!r}")


def task_title(task: dict[str, Any], agent: dict[str, Any] | None) -> str:
    """The worker's Claude session name, which spawn records and Claude shows as the pane title."""
    if title := task.get("title"):
        return title
    if agent and (title := agent.get("terminal_title_stripped")):
        return title
    raise MotoError(
        f"{task['agent']} has no recorded title and no live pane to read one from"
    )


def cmd_snooze(args: argparse.Namespace) -> int:
    reason = " ".join(args.reason).strip()
    live = live_agents()
    with tasks_for_update() as tasks:
        task = find_task(tasks, args.agent)
        if task.get("snoozed"):
            raise MotoError(f"{args.agent} is already snoozed")
        agent = live.get(task["pane_id"])
        if agent and agent.get("agent_status") == "working":
            raise MotoError(f"{args.agent} is mid-turn; snooze it once the turn ends")
        cwd, repo, linked = task["cwd"], task["repo"], owns_worktree(task)
        path = transcript(task, agent)
        if path:
            # A session the user started may have no name; its id is enough.
            title = task.get("title") or (agent or {}).get("terminal_title_stripped")
            session = path.stem
        else:
            title = task_title(task, agent)
            session = find_session(cwd, title)
        if linked:
            branch = task["branch"]
            exists = os.path.isdir(cwd)
            if exists and run(["git", "status", "--porcelain"], cwd=cwd).strip():
                raise MotoError(f"{args.agent}: the worktree has uncommitted changes")
            # All three keep the branch; wake checks it out again at the same path.
            if task.get("adopted"):
                release_adopted(task, True, False)
            elif exists and (workspace := checkout_workspace(cwd)):
                herdr("worktree", "remove", "--workspace", workspace, timeout=120)
            elif exists:
                run(["git", "worktree", "remove", cwd], cwd=repo, timeout=120)
        else:
            # The main checkout, or a worktree an adopted task shares, stays as
            # it is, on whatever branch it is on.
            try:
                branch = run(
                    ["git", "symbolic-ref", "--quiet", "--short", "HEAD"], cwd=cwd
                ).strip()
            except MotoError:
                branch = None  # detached HEAD
            try:
                herdr("tab", "close", task["tab_id"])
            except MotoError:
                pass  # the tab is already gone
        task["snoozed"] = {
            "session": session,
            "title": title,
            "reason": reason,
            "repo": repo,
            "cwd": cwd,
            "branch": branch,
            "worktree": linked,
            "at": time.time(),
        }
        record("snooze", args.agent, **task["snoozed"])
    print(f"Snoozed {args.agent} (session {session}); bring it back with moto wake")
    return 0


def cmd_wake(args: argparse.Namespace) -> int:
    text = " ".join(args.text).strip()
    tasks = read_tasks()
    sender = message_sender(tasks, args.agent, text)
    task = find_task(tasks, args.agent)
    snooze: dict[str, Any] | None = task.get("snoozed")
    if not snooze:
        raise MotoError(f"{args.agent} is not snoozed")
    session = snooze["session"]
    repo = snooze.get("repo") or task["repo"]
    cwd = snooze.get("cwd") or task["cwd"]
    linked = snooze.get("worktree", bool(task.get("branch")))
    # claude --resume finds a session only from the folder it ran in.
    if not (session_dir(cwd) / f"{session}.jsonl").is_file():
        raise MotoError(f"Session {session} is not in {session_dir(cwd)}")
    # A checkout that stayed may be a worktree an adopted task shared, not the repo.
    checkout = repo if linked else cwd
    command = ["spawn-session", "--json", "--repo", checkout, "--name", task["agent"]]
    if linked:
        command += ["--worktree", snooze.get("branch") or task["branch"], "--path", cwd]
    elif not os.path.isdir(cwd):
        raise MotoError(f"The checkout {cwd} is gone")
    if title := snooze.get("title") or task.get("title"):
        command += ["--title", title]
    command += ["--resume", session]
    # claude --resume starts on the default model, not the one the session used.
    for flag in MODEL_FLAGS:
        if value := task.get(flag):
            command += [f"--{flag}", value]
    stdin = f"{tag(sender)} {text}\n" if text else ""
    output = run(command, timeout=600, stdin=stdin)
    try:
        info: dict[str, Any] = json.loads(output)
    except ValueError as error:
        raise MotoError(f"spawn-session printed no JSON: {output.strip()}") from error
    if info["cwd"] != cwd:
        print(
            f"moto: the worktree came back at {info['cwd']}, not {cwd}", file=sys.stderr
        )
    live = live_agents()
    with tasks_for_update() as tasks:
        task = find_task(tasks, args.agent)
        for key in ("pane_id", "workspace_id", "tab_id", "cwd"):
            task[key] = info[key]
        task["title"] = title or task.get("title")
        task["session"] = session
        task.pop("closed_at", None)
        del task["snoozed"]
        resume(task, live)
        if text:
            task["told"] = time.time()
        record(
            "wake",
            args.agent,
            session=session,
            message=text or None,
            cwd=info["cwd"],
            **{"from": sender or "driver"},
            pane_id=info["pane_id"],
        )
    print(f"Woke {args.agent} on session {session}: moto watch covers it again")
    return 0


def afk_path() -> Path:
    return state_dir() / "afk.json"


def read_afk() -> dict[str, Any] | None:
    try:
        return json.loads(afk_path().read_text())
    except (OSError, ValueError):
        return None


def clock(ts: float) -> str:
    return time.strftime("%H:%M", time.localtime(ts))


def cmd_afk(args: argparse.Namespace) -> int:
    """Record that the user is away, with their note exactly as written."""
    note = " ".join(args.text).strip()
    with tasks_for_update():
        away = read_afk()
        if away and not note:
            print(f"Already away since {clock(away['since'])}; the note is unchanged.")
            return 0
        since = away["since"] if away else time.time()
        previous = away["note"] if away else None
        afk_path().write_text(json.dumps({"since": since, "note": note}) + "\n")
        record("afk", "driver", note=note, since=since, previous=previous)
    verb = "Replaced the note" if away else "Away"
    print(f"{verb} since {clock(since)}: {note or 'no note, so no instructions'}")
    return 0


def cmd_back(_: argparse.Namespace) -> int:
    """End away mode and print what happened since it started."""
    with tasks_for_update() as tasks:
        away = read_afk()
        if away is None:
            raise MotoError("Not away; moto afk starts away mode")
        afk_path().unlink()
        record("back", "driver", since=away["since"], note=away["note"])
        brief = return_brief(away, read_events(), tasks)
    print("\n".join(brief))
    return 0


def return_brief(
    away: dict[str, Any], events: list[dict[str, Any]], tasks: dict[str, dict[str, Any]]
) -> list[str]:
    """The events since away mode started, in four groups, oldest first in each."""
    since = away["since"]
    recent = [e for e in events if e.get("ts", 0) >= since]
    prs: dict[str, str] = {}  # PR URL → the line for it, for tasks still open
    actions: list[str] = []
    finished: list[str] = []
    for event in recent:
        name, kind, at = event["agent"], event["event"], clock(event["ts"])
        if kind == "pr" and name in tasks:
            prs[event["pr"]] = f"{at} {name}: {event['pr']}"
        # A handback is addressed to the driver, whose actions on it show as
        # log-action lines, so it gets no line of its own.
        elif kind == "report" and event.get("kind") in FINISHED:
            finished.append(f"{at} {name} {event['kind']}: {event['text']}")
            if (match := PR_URL.search(event["text"])) and name in tasks:
                prs.setdefault(match.group(0), f"{at} {name}: {match.group(0)}")
        elif kind in ("close", "drop"):
            finished.append(
                f"{at} {name}: {'closed' if kind == 'close' else 'dropped'}"
            )
        elif kind == "action":
            actions.append(f"{at} {name}: {event['text']}")
    # A worker's question waits until the driver writes to that worker again.
    answered = {e["agent"]: e["ts"] for e in recent if e["event"] in ("tell", "wake")}
    questions = [
        (
            report["at"],
            f"{clock(report['at'])} {name} {report['kind']}: {report['text']}",
        )
        for name, task in tasks.items()
        if (report := task.get("report"))
        and report["kind"] in ("question", "blocked")
        and report["at"] >= since
        and answered.get(name, 0) < report["at"]
    ]
    try:
        ask = json.loads((state_dir() / "driver.json").read_text())
        questions.append((ask["at"], f"{clock(ask['at'])} driver: {ask['text']}"))
    except (OSError, ValueError, KeyError):
        pass
    lines = [
        f"Away {clock(since)} to {clock(time.time())}. Note: {away['note'] or 'none'}"
    ]
    for title, group in (
        ("PRs ready for review", list(prs.values())),
        ("Questions waiting on the user", [line for _, line in sorted(questions)]),
        ("What the driver did under the note", actions),
        ("Tasks finished or closed", finished),
    ):
        lines += ["", f"{title}:"] + ([f"  {line}" for line in group] or ["  none"])
    return lines


def cmd_log_action(args: argparse.Namespace) -> int:
    """Log something the driver did, for the return brief and the history."""
    text = " ".join(args.text).strip()
    with tasks_for_update():
        record("action", args.agent or "driver", text=text)
    print("Logged.")
    return 0


def read_events() -> list[dict[str, Any]]:
    try:
        lines = (state_dir() / "events.jsonl").read_text().splitlines()
    except FileNotFoundError:
        return []
    events: list[dict[str, Any]] = []
    for line in lines:
        try:
            events.append(json.loads(line))
        except ValueError:
            continue
    return events


def cmd_log(args: argparse.Namespace) -> int:
    """Print the event log, or one task's lines of it."""
    try:
        lines = (state_dir() / "events.jsonl").read_text().splitlines()
    except FileNotFoundError:
        lines = []
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if args.agent in (None, event.get("agent")):
            print(line)
    return 0


def put_first(workspace: str) -> None:
    """Make this workspace the top of the sidebar, so its agent is number 1."""
    herdr_request("workspace.move", {"workspace_id": workspace, "insert_index": 0})


def cmd_pin(_: argparse.Namespace) -> int:
    """Move the driver's workspace to the top of the sidebar, if it is open."""
    if workspace := checkout_workspace(str(MOTO_HOME.resolve())):
        put_first(workspace)
    return 0


def cmd_focus(_: argparse.Namespace) -> int:
    """Focus the driver session, starting it in its home folder if none is open."""
    home = MOTO_HOME.resolve()
    workspace = checkout_workspace(str(home))
    if workspace is None:
        if not home.is_dir():
            raise MotoError(f"moto home not found: {home}")
        pane = herdr("workspace", "create", "--cwd", str(home), "--label", "moto")[
            "root_pane"
        ]
        workspace = pane["workspace_id"]
        try:
            herdr(
                "agent",
                "start",
                "driver",
                "--kind",
                "claude",
                "--pane",
                pane["pane_id"],
                "--",
                "--plugin-dir",
                str(WATCH_MOD),
                timeout=90,
            )
        except MotoError:
            pass  # a first start stops at Claude's trust prompt, which is now in view
    put_first(workspace)
    herdr("workspace", "focus", workspace)
    agents = [
        a
        for a in herdr("agent", "list")["agents"]
        if a.get("workspace_id") == workspace
    ]
    if agents:
        # Focusing the agent alone leaves the client on its current tab.
        herdr("tab", "focus", agents[0]["tab_id"])
        herdr("agent", "focus", agents[0]["pane_id"])
    return 0


def skill_folders() -> list[Path]:
    """Where moto skills live, the folder whose skills win last."""
    return [CORE_SKILLS, MOTO_HOME / "skills"]


def cmd_link(_: argparse.Namespace) -> int:
    """Symlink every moto-* skill into Claude's skills folder.

    A link is moto's when it points into a skill folder. moto replaces or
    removes only its own links and links whose target is gone, so Home
    Manager's links and anything else stay as they are.
    """
    folders = [folder.resolve() for folder in skill_folders()]
    wanted: dict[str, Path] = {}
    for folder in folders:
        for skill in sorted(folder.glob("moto-*/SKILL.md")):
            wanted[skill.parent.name] = skill.parent
    target = CLAUDE_HOME / "skills"
    target.mkdir(parents=True, exist_ok=True)
    changes: list[str] = []
    refused: list[str] = []
    for entry in sorted(target.glob("moto-*")):
        if not entry.is_symlink():
            if entry.name in wanted:
                refused.append(f"{entry} is not a symlink")
            continue
        points_to = entry.readlink()
        mine = points_to.parent in folders
        home_manager = points_to.is_relative_to("/nix/store")
        if not mine and (entry.exists() or home_manager):
            if entry.name in wanted:
                refused.append(f"{entry} points to {points_to}, not a moto skill")
            continue
        if wanted.get(entry.name) == points_to:
            continue
        entry.unlink()
        if entry.name not in wanted:
            changes.append(f"Removed {entry.name}, which pointed to {points_to}")
    for name, source in wanted.items():
        link = target / name
        if link.is_symlink() or link.exists():
            continue  # already right, or refused above
        link.symlink_to(source, target_is_directory=True)
        changes.append(f"Linked {name} to {source}")
    print("\n".join(changes) or f"All {len(wanted)} moto skills were already linked.")
    for line in refused:
        print(f"moto link: skipped, {line}", file=sys.stderr)
    return 1 if refused else 0


def jobs_dir() -> Path:
    """Where job files live, beside the Epidemic skills in MOTO_HOME."""
    return MOTO_HOME / "jobs"


def read_jobs() -> dict[str, dict[str, Any]]:
    """Each job's scheduling state: last run, last outcome and pending note."""
    try:
        data = json.loads((state_dir() / "jobs.json").read_text())
    except FileNotFoundError:
        return {}
    except ValueError as error:
        raise MotoError(f"{state_dir() / 'jobs.json'} is not valid JSON") from error
    return data.get("jobs", {})


@contextmanager
def jobs_for_update() -> Generator[dict[str, dict[str, Any]]]:
    """Job state under its own lock, written back on exit if it changed.

    Its own lock, not the task lock, because a job's state changes while it
    spawns a worker, and spawning takes the task lock itself.
    """
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    with open(directory / "jobs.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        jobs = read_jobs()
        before = json.dumps(jobs, sort_keys=True)
        yield jobs
        if json.dumps(jobs, sort_keys=True) != before:
            path = directory / "jobs.json"
            tmp = path.with_suffix(".tmp")
            tmp.write_text(json.dumps({"jobs": jobs}, indent=2) + "\n")
            tmp.replace(path)


def job_event(event: str, name: str, **fields: Any) -> None:
    """Append a job event to the same log the tasks use, so moto log prints it."""
    with tasks_for_update():
        record(event, name, **fields)


def parse_times(values: Any) -> list[tuple[int, int]]:
    """The HH:MM strings in a job's `at`, as hour and minute pairs."""
    if not isinstance(values, list) or not values:
        raise ValueError("at must be a non-empty list of HH:MM times")
    given = cast("list[Any]", values)
    times: list[tuple[int, int]] = []
    for value in given:
        hour, _, minute = str(value).partition(":")
        if not hour.isdigit() or not minute.isdigit():
            raise ValueError(f"{value!r} is not an HH:MM time")
        if not (0 <= int(hour) <= 23 and 0 <= int(minute) <= 59):
            raise ValueError(f"{value!r} is not a time of day")
        times.append((int(hour), int(minute)))
    return sorted(set(times))


def parse_days(values: Any) -> set[int]:
    """The weekdays a job may run on, as Monday 0 to Sunday 6.

    Takes names, comma lists and ranges: mon, mon-fri, "sat,sun". A range reads
    forwards and wraps, so fri-mon is Friday through Monday.
    """
    if values is None:
        return set(range(7))
    if not isinstance(values, list):
        raise ValueError('days must be a list, as in ["mon-fri"]')
    given = cast("list[Any]", values)
    days: set[int] = set()
    for value in given:
        for part in str(value).replace(" ", "").lower().split(","):
            if not part:
                continue
            start, _, end = part.partition("-")
            if start not in WEEKDAYS or (end and end not in WEEKDAYS):
                raise ValueError(f"{part!r} is not a weekday or a range of them")
            first = WEEKDAYS[start]
            span = (WEEKDAYS[end] - first) % 7 if end else 0
            days.update((first + step) % 7 for step in range(span + 1))
    if not days:
        raise ValueError("days names no weekday")
    return days


def job_problem(job: dict[str, Any]) -> str | None:
    """Why a job file cannot be used, or None. Rejects rather than guesses."""
    try:
        parse_times(job.get("at"))
        parse_days(job.get("days"))
    except ValueError as error:
        return str(error)
    deliver = job.get("deliver")
    if deliver not in ("driver", "worker"):
        return 'deliver must be "driver" or "worker"'
    if not str(job.get("brief") or "").strip():
        return "no brief, and no .md file of the same name beside it"
    if deliver == "worker" and not job.get("repo"):
        return "a worker job needs a repo"
    if deliver == "worker" and not job.get("title"):
        return "a worker job needs a title, the Claude session name"
    stale = job.get("stale_after")
    if stale is not None and (not isinstance(stale, int) or stale <= 0):
        return "stale_after must be a whole number of minutes"
    unknown = set(job) - JOB_FIELDS
    if unknown:
        return f"unknown field(s): {', '.join(sorted(unknown))}"
    return None


def load_jobs() -> tuple[dict[str, dict[str, Any]], list[str]]:
    """Every usable job file, and one line per file that is not.

    A job without a brief follows the .md file of the same name beside it, so
    the brief points the agent at that file rather than inlining it.
    A broken file is reported and skipped rather than stopping the tick, so one
    bad edit cannot silence every other job.
    """
    jobs: dict[str, dict[str, Any]] = {}
    problems: list[str] = []
    directory = jobs_dir()
    if not directory.is_dir():
        return jobs, problems
    for path in sorted(directory.glob("*.toml")):
        try:
            job = tomllib.loads(path.read_text())
        except (OSError, ValueError) as error:
            problems.append(f"{path.name}: {error}")
            continue
        job["name"] = str(job.get("name") or path.stem)
        source = "inline"
        notes = path.with_suffix(".md")
        if not str(job.get("brief") or "").strip() and notes.is_file():
            job["brief"] = f"Follow {directory.name}/{notes.name}."
            source = notes.name
        if problem := job_problem(job):
            problems.append(f"{path.name}: {problem}")
            continue
        # Set after the check, which rejects fields a job file may not carry.
        job["brief_source"] = source
        jobs[job["name"]] = job
    return jobs, problems


def occurrence(job: dict[str, Any], now: float, ahead: bool) -> float | None:
    """The job's next run after now, or its last one at or before it."""
    times = parse_times(job.get("at"))
    days = parse_days(job.get("days"))
    today = datetime.fromtimestamp(now)
    for step in range(8):
        day = (today + timedelta(days=step if ahead else -step)).date()
        if day.weekday() not in days:
            continue
        for hour, minute in sorted(times, reverse=not ahead):
            when = datetime.combine(day, dt_time(hour, minute)).timestamp()
            if (when > now) if ahead else (when <= now):
                return when
    return None


def due(
    job: dict[str, Any], state: dict[str, Any], now: float
) -> tuple[float | None, str | None]:
    """The occurrence a job owes, and why it will be recorded missed instead.

    A job whose time passed while the laptop slept runs on the next tick, since
    the occurrence is read off the wall clock. stale_after opts out of that.
    """
    when = occurrence(job, now, ahead=False)
    if when is None or float(state.get("ran_at") or 0) >= when:
        return None, None
    stale = job.get("stale_after")
    if stale and now - when > float(stale) * 60:
        return when, f"missed by {age(now - when)}"
    return when, None


def run_gate(job: dict[str, Any]) -> tuple[str, str]:
    """A job's gate verdict and the text it produced.

    Shepherd's contract, copied deliberately: exit 0 runs the job, exit 75
    skips this occurrence, and anything else is a broken gate. A broken gate
    must not silently kill a schedule, so it is never treated as a skip; what
    happens instead depends on the delivery mode. The gate's stdout is kept and
    handed to the job, so a check that queried GitHub is not run twice.
    """
    gate = str(job.get("gate") or "").strip()
    if not gate:
        return "run", ""
    cwd = MOTO_HOME if MOTO_HOME.is_dir() else None
    try:
        # Its own process group, so a timeout kills what the gate started too.
        process = subprocess.Popen(
            ["sh", "-c", gate],
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
    except OSError as error:
        return "broken", f"the gate could not start: {error}"
    try:
        out, err = process.communicate(timeout=GATE_TIMEOUT)
    except subprocess.TimeoutExpired:
        with suppress(OSError, ProcessLookupError):
            os.killpg(os.getpgid(process.pid), signal.SIGKILL)
        process.communicate()
        return "broken", f"the gate still ran after {GATE_TIMEOUT}s, so it was killed"
    if process.returncode == 0:
        return "run", out.strip()
    if process.returncode == GATE_SKIP:
        return "skip", out.strip()
    detail = (err or out).strip() or "no output"
    return "broken", f"the gate exited {process.returncode}: {detail}"


def driver_path() -> Path:
    return state_dir() / "driver.json"


def read_driver() -> dict[str, Any]:
    """Where the driver is, and its open question if it has one."""
    try:
        return json.loads(driver_path().read_text())
    except (OSError, ValueError):
        return {}


def write_driver(**fields: Any) -> None:
    """Merge into the driver record, keeping the fields already there.

    The pane and session outlive a question, so moto ask --clear drops the
    question's own fields rather than the file.
    """
    state_dir().mkdir(parents=True, exist_ok=True)
    driver_path().write_text(json.dumps(read_driver() | fields) + "\n")


def driver_cwd(payload: dict[str, Any]) -> bool:
    """Whether a Claude session started in the driver's own checkout."""
    try:
        return Path(str(payload.get("cwd") or "")).resolve() == MOTO_HOME.resolve()
    except OSError:
        return False


def wake_driver(name: str, text: str) -> str:
    """Leave the driver a note, which the moto-watch mod's next pass hands over.

    One note per job: a newer run replaces an unread one, because a review
    queue's value is the current list and two stale lists are worse than one
    fresh one. The replaced note stays in the event log.
    """
    replaced = False
    with jobs_for_update() as jobs:
        state = jobs.setdefault(name, {})
        replaced = bool(state.get("note"))
        state["note"] = {"text": f"{JOB_TAG} {text}", "at": time.time()}
    if replaced:
        job_event("note-replaced", name)
    return "left a note for the driver"


def pending_notes() -> list[tuple[str, dict[str, Any]]]:
    return [
        (name, state["note"])
        for name, state in sorted(read_jobs().items())
        if state.get("note")
    ]


def take_notes() -> str | None:
    """Every pending note, removed as it is handed over, or None if there are none.

    Removing on delivery is what keeps a note from reaching the driver twice.
    """
    notes = pending_notes()
    if not notes:
        return None
    with jobs_for_update() as jobs:
        for name, _ in notes:
            jobs.get(name, {}).pop("note", None)
    for name, _ in notes:
        job_event("note-read", name)
    return "\n\n".join(note["text"] for _, note in notes)


def job_brief(job: dict[str, Any], gate_output: str, broken: str | None) -> str:
    """What a job hands the driver or a worker: its brief, then what it found."""
    parts = [str(job["brief"]).strip()]
    if broken:
        parts.append(f"The job's check failed, so this ran anyway: {broken}")
    elif gate_output:
        parts.append(f"What the job's check found:\n\n{gate_output}")
    return "\n\n".join(parts)


def deliver(name: str, job: dict[str, Any], verdict: str, output: str) -> str:
    """Hand a due job to the driver or to a new worker, and say what happened.

    A broken gate wakes the driver either way. For a worker job it leaves a note
    instead of spawning, because starting an agent on a broken premise is worse
    than not starting one.
    """
    broken = output if verdict == "broken" else None
    text = job_brief(job, output, broken)
    if job["deliver"] == "driver" or broken:
        lead = f"The scheduled job {name} fired."
        return wake_driver(name, f"{lead}\n\n{text}")
    spec = {key: job.get(key) for key in ("repo", "worktree", "base", "name", "title")}
    spec["name"] = job.get("agent") or name
    info = start_worker(spec, f"{JOB_TAG} {text}\n\n{JOB_FOOTER}\n", None)
    return f"started {info['agent']}"


def run_job(name: str, job: dict[str, Any], when: float, trigger: str) -> str:
    """Run one job: stamp it, gate it, deliver it, and record the outcome.

    The stamp and the lock come before the gate, never after, so a loop killed
    between the check and the spawn cannot fire the same occurrence twice.
    """
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    with open(directory / f"job-{name}.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "still running, so this occurrence is skipped"
        with jobs_for_update() as jobs:
            jobs.setdefault(name, {})["ran_at"] = when
        verdict, output = run_gate(job)
        if verdict == "skip":
            outcome = "nothing to do"
        else:
            try:
                outcome = deliver(name, job, verdict, output)
            except (MotoError, OSError, subprocess.TimeoutExpired) as error:
                outcome = f"failed: {error}"
            if verdict == "broken":
                outcome = f"broken gate, {outcome}"
        with jobs_for_update() as jobs:
            jobs.setdefault(name, {})["outcome"] = {"text": outcome, "at": time.time()}
        job_event("job", name, outcome=outcome, verdict=verdict, trigger=trigger)
        return outcome


def tick(now: float) -> list[str]:
    """One pass over the job files: everything due, run. One line per thing done."""
    jobs, problems = load_jobs()
    lines = [f"job file {problem}" for problem in problems]
    state = read_jobs()
    for name, job in sorted(jobs.items()):
        if job.get("enabled") is False:
            continue
        when, missed = due(job, state.get(name, {}), now)
        if when is None:
            continue
        if missed:
            with jobs_for_update() as live:
                live.setdefault(name, {})["ran_at"] = when
                live[name]["outcome"] = {"text": missed, "at": now}
            job_event("job", name, outcome=missed, verdict="missed", trigger="schedule")
            lines.append(f"{name}: {missed}")
            continue
        lines.append(f"{name}: {run_job(name, job, when, 'schedule')}")
    return lines


def job_beat_path() -> Path:
    return state_dir() / "jobs.beat"


def job_loop_problem() -> str | None:
    """Why no job loop is ticking, or None when one is.

    The loop runs in a Herdr pane and nothing restarts it, so a dead loop has to
    look different from a quiet morning.
    """
    try:
        pid = int(job_beat_path().read_text().split()[0])
        silent = time.time() - job_beat_path().stat().st_mtime
    except (OSError, ValueError, IndexError):
        return "no moto job loop is running"
    try:
        if "moto" not in run(["ps", "-p", str(pid), "-o", "command="]):
            return "no moto job loop is running"
    except MotoError:
        return "no moto job loop is running"
    if silent > JOB_BEAT_STALE_SECONDS:
        return f"moto job loop (pid {pid}) last ticked {age(silent)} ago"
    return None


def job_rows(now: float) -> list[dict[str, Any]]:
    jobs, problems = load_jobs()
    state = read_jobs()
    rows = [
        {
            "name": name,
            "enabled": job.get("enabled") is not False,
            "deliver": job["deliver"],
            "brief": job["brief_source"],
            "next": occurrence(job, now, ahead=True),
            "outcome": state.get(name, {}).get("outcome"),
            "note": state.get(name, {}).get("note"),
        }
        for name, job in sorted(jobs.items())
    ]
    return rows + [{"name": problem, "broken": True} for problem in problems]


def print_jobs(now: float) -> None:
    rows = job_rows(now)
    if not rows:
        return
    print("\nJobs:")
    if problem := job_loop_problem():
        print(f"  {problem}")
    for row in rows:
        if row.get("broken"):
            print(f"{row['name']} · unusable job file")
            continue
        when = row["next"]
        nxt = clock(when) if when else "never"
        state = "" if row["enabled"] else " · disabled"
        brief = f"brief {row['brief']}"
        print(f"{row['name']} · {row['deliver']} · {brief} · next {nxt}{state}")
        if outcome := row["outcome"]:
            print(f"  last ({age(now - outcome['at'])} ago): {outcome['text']}")
        if row["note"]:
            print("  a note is waiting for the driver")


def cmd_job_list(args: argparse.Namespace) -> int:
    now = time.time()
    if args.json:
        print(json.dumps(job_rows(now), indent=2))
        return 0
    rows = job_rows(now)
    if not rows:
        print(f"No job files in {jobs_dir()}.")
        return 0
    print_jobs(now)
    return 0


def cmd_job_run(args: argparse.Namespace) -> int:
    jobs, problems = load_jobs()
    if args.name not in jobs:
        hint = f" ({'; '.join(problems)})" if problems else ""
        raise MotoError(f"No job named {args.name} in {jobs_dir()}{hint}")
    print(f"{args.name}: {run_job(args.name, jobs[args.name], time.time(), 'manual')}")
    return 0


def cmd_job_tick(_: argparse.Namespace) -> int:
    for line in tick(time.time()) or ["nothing due"]:
        print(line)
    return 0


def cmd_job_loop(args: argparse.Namespace) -> int:
    """The long-lived scheduler, which watchexec restarts on every edit."""
    signal.signal(signal.SIGTERM, exit_on_signal)
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    with open(directory / "job-loop.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another moto job loop is already running.")
            return 0
        print(f"moto job loop: every {args.every}s over {jobs_dir()}", flush=True)
        try:
            while True:
                job_beat_path().write_text(f"{os.getpid()}\n")
                for line in tick(time.time()):
                    print(f"{clock(time.time())} {line}", flush=True)
                time.sleep(args.every)
        finally:
            job_beat_path().unlink(missing_ok=True)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    commands = root.add_subparsers(dest="command", required=True)

    spawn = commands.add_parser("spawn", help="Start a worker; brief on stdin")
    spawn.add_argument("--repo", required=True, help="Repo name under ~/code or a path")
    spawn.add_argument("--worktree", metavar="BRANCH", help="Work in a linked worktree")
    spawn.add_argument("--base", help="Base ref for a new worktree")
    spawn.add_argument("--name", help="Herdr agent name")
    spawn.add_argument(
        "--title",
        required=True,
        help="Claude session name: up to three lowercase words, as in 'ABC-123 summary'",
    )
    spawn.add_argument(
        "--resume",
        metavar="SESSION_ID",
        help="Resume an earlier Claude session as the worker",
    )
    spawn.add_argument(
        "--model",
        help="Claude model for the worker: an alias such as sonnet, or a full name",
    )
    spawn.add_argument("--effort", choices=EFFORTS, help="Claude effort level")
    spawn.add_argument(
        "--pane",
        metavar="PANE_ID",
        help="Adopt this pane instead of opening one, for a caller that built"
        + " the workspace itself, such as pr-review --worktree",
    )
    spawn.add_argument(
        "--to-driver",
        action="store_true",
        help="From a worker: hand the task to the driver, which watches it and"
        + " takes its reports, instead of supervising it yourself",
    )
    spawn.add_argument("--json", action="store_true", help="Print the new task as JSON")
    spawn.set_defaults(handler=cmd_spawn)

    tell = commands.add_parser(
        "tell",
        help="Prompt a worker, tagged [driver] or with the worker that started it",
    )
    tell.add_argument("agent")
    tell.add_argument("text", nargs="*", help="The message; default: stdin")
    tell.set_defaults(handler=cmd_tell)

    ask = commands.add_parser(
        "ask", help="Show the driver's question to the user in the sidebar"
    )
    ask.add_argument("text", nargs="*")
    ask.add_argument("--clear", action="store_true", help="Remove the question")
    ask.set_defaults(handler=cmd_ask)

    listing = commands.add_parser(
        "list", help="Workers with live state, PR and last report"
    )
    listing.add_argument("--json", action="store_true")
    listing.set_defaults(handler=cmd_list)

    report = commands.add_parser(
        "report",
        help="Run by a worker to report to the driver; wrap, handback and"
        + " snooze also end a hold",
    )
    report.add_argument("kind", choices=REPORT_KINDS)
    report.add_argument("text", nargs="+")
    report.add_argument("--agent", help="Task name; default: the task in this pane")
    report.set_defaults(handler=cmd_report)

    watch = commands.add_parser(
        "watch", help="One pass, as JSON, of what needs the driver"
    )
    watch.set_defaults(handler=cmd_watch)

    close = commands.add_parser("close", help="Remove a worker's tab and worktree")
    close.add_argument("agent")
    close.add_argument(
        "--force",
        action="store_true",
        help="Remove even with unsaved work, a busy pane or the user's new prompts",
    )
    close.set_defaults(handler=cmd_close)

    hold = commands.add_parser("hold", help="Keep a task but stop watching it")
    hold.add_argument("agent")
    hold.set_defaults(handler=cmd_hold)

    resume_ = commands.add_parser(
        "resume", help="Watch a held task again; a snoozed one needs wake"
    )
    resume_.add_argument("agent")
    resume_.set_defaults(handler=cmd_resume)

    attach_ = commands.add_parser(
        "attach",
        help="Move a task to the pane its Claude session was resumed in",
    )
    attach_.add_argument("agent", nargs="?")
    attach_.add_argument("--pane", help="Herdr pane id; default: this pane")
    attach_.add_argument(
        "--hook",
        action="store_true",
        help="Claude's SessionStart hook: record this pane's session, or attach"
        + " the task that ran it; silent, and always exits 0",
    )
    attach_.set_defaults(handler=cmd_attach)

    snooze = commands.add_parser(
        "snooze",
        help="Park a blocked task: save its Claude session, remove its worktree"
        + " (keeping the branch) and close its workspace",
    )
    snooze.add_argument("agent")
    snooze.add_argument("reason", nargs="+", help="Why it waits, shown in moto list")
    snooze.set_defaults(handler=cmd_snooze)

    wake = commands.add_parser(
        "wake",
        help="Bring a snoozed task back: restore its worktree, resume its session",
    )
    wake.add_argument("agent")
    wake.add_argument("text", nargs="*", help="What changed, sent as with tell")
    wake.set_defaults(handler=cmd_wake)

    drop = commands.add_parser("drop", help="Stop tracking a worker, leaving it open")
    drop.add_argument("agent")
    drop.set_defaults(handler=cmd_drop)

    log = commands.add_parser(
        "log", help="Print events.jsonl, the append-only history of every task"
    )
    log.add_argument("agent", nargs="?", help="Only this task's events")
    log.set_defaults(handler=cmd_log)

    afk = commands.add_parser(
        "afk",
        help="Record that the user is away, with their note word for word;"
        + " new words replace the note",
    )
    afk.add_argument("text", nargs="*", help="The user's note; may be empty")
    afk.set_defaults(handler=cmd_afk)

    back = commands.add_parser(
        "back", help="End away mode and print what happened while the user was away"
    )
    back.set_defaults(handler=cmd_back)

    log_action = commands.add_parser(
        "log-action", help="Log something the driver did, for the return brief"
    )
    log_action.add_argument("text", nargs="+")
    log_action.add_argument("--agent", help="The task it concerns; default: driver")
    log_action.set_defaults(handler=cmd_log_action)

    focus = commands.add_parser("focus", help="Jump to the driver session")
    focus.set_defaults(handler=cmd_focus)

    pin = commands.add_parser("pin", help="Move the driver's workspace to the top")
    pin.set_defaults(handler=cmd_pin)

    link = commands.add_parser(
        "link", help="Symlink the moto-* skills into ~/.claude/skills"
    )
    link.set_defaults(handler=cmd_link)

    job = commands.add_parser("job", help="Scheduled jobs: work that starts on a clock")
    job_commands = job.add_subparsers(dest="job_command", required=True)
    job_loop = job_commands.add_parser(
        "loop", help="The scheduler; ticks until stopped"
    )
    job_loop.add_argument(
        "--every",
        type=int,
        default=JOB_TICK_SECONDS,
        metavar="SECONDS",
        help="Seconds between ticks (default: %(default)s)",
    )
    job_loop.set_defaults(handler=cmd_job_loop)
    job_tick = job_commands.add_parser("tick", help="One pass: run everything due")
    job_tick.set_defaults(handler=cmd_job_tick)
    job_run = job_commands.add_parser(
        "run", help="Run a job now, whatever its schedule says"
    )
    job_run.add_argument("name")
    job_run.set_defaults(handler=cmd_job_run)
    job_list = job_commands.add_parser(
        "list", help="Jobs with next run and last outcome"
    )
    job_list.add_argument("--json", action="store_true")
    job_list.set_defaults(handler=cmd_job_list)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        if (
            forked()
            and args.command not in FORK_SAFE
            and not getattr(args, "hook", False)
        ):
            raise MotoError(
                "This session is a fork, neither the driver nor a moto worker, so it"
                + f" cannot run moto {args.command}. Answer the user in this pane."
            )
        return args.handler(args)
    except subprocess.TimeoutExpired as error:
        print(
            f"moto: {error.cmd[0]} timed out; inspect Herdr before retrying",
            file=sys.stderr,
        )
    except (MotoError, OSError) as error:
        print(f"moto: {error}", file=sys.stderr)
        if args.command == "focus":
            try:
                herdr("notification", "show", f"moto: {error}", "--sound", "none")
            except (MotoError, OSError, subprocess.TimeoutExpired):
                pass
    return 1


if __name__ == "__main__":
    sys.exit(main())
