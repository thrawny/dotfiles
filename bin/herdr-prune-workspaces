#!/usr/bin/env python3
"""Close Herdr workspaces with nothing in them.

A workspace is empty when every pane is an idle shell: no agent, and the shell
itself is the only foreground process, so no editor, server or watcher. The
focused workspace and the one labelled background always stay.

A repo workspace with linked worktree workspaces is a group, and Herdr closes
it only together with them. A group closes only when every member is empty;
otherwise all of it stays.

Without --apply it prints what it would close and closes nothing.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from collections.abc import Callable
from typing import Any

KEEP = {"background"}


class HerdrError(Exception):
    pass


def herdr(*args: str) -> dict[str, Any]:
    binary = os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr") or "herdr"
    command = f"herdr {' '.join(args[:2])}"
    try:
        done = subprocess.run(
            [binary, *args], capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise HerdrError(f"{command}: {error}") from error
    if done.returncode != 0:
        raise HerdrError(f"{command}: {(done.stderr or done.stdout).strip()}")
    try:
        return json.loads(done.stdout)["result"]
    except (ValueError, KeyError) as error:
        raise HerdrError(f"{command} returned no result") from error


def idle_shell(pane: dict[str, Any], process: dict[str, Any]) -> bool:
    """True when the pane runs no agent and its shell waits at the prompt."""
    if pane.get("agent"):
        return False
    shell = process.get("shell_pid")
    foreground = process.get("foreground_processes") or []
    return (
        shell is not None
        and process.get("foreground_process_group_id") == shell
        and bool(foreground)
        and all(p.get("pid") == shell for p in foreground)
    )


def empty_workspaces(
    workspaces: list[dict[str, Any]],
    panes: list[dict[str, Any]],
    process_of: Callable[[str], dict[str, Any]],
) -> list[tuple[dict[str, Any], str]]:
    """The workspaces to close, each with the cwd of its first pane.

    process_of is asked only about panes without an agent, in workspaces that
    may be closed, and stops at a workspace's first busy pane.
    """
    found = []
    for workspace in workspaces:
        if workspace.get("focused") or workspace.get("label") in KEEP:
            continue
        own = [p for p in panes if p["workspace_id"] == workspace["workspace_id"]]
        if own and all(
            not p.get("agent") and idle_shell(p, process_of(p["pane_id"])) for p in own
        ):
            found.append((workspace, own[0].get("cwd") or "-"))
    return found


def closures(
    workspaces: list[dict[str, Any]], found: list[tuple[dict[str, Any], str]]
) -> list[tuple[dict[str, Any], str, list[dict[str, Any]] | None]]:
    """The closes to make: each workspace, its cwd, and its other group members.

    The members are None for a workspace closed on its own. A group closes
    through its first repo workspace, so a group without one closes member by
    member.
    """
    cwd_of = {w["workspace_id"]: cwd for w, cwd in found}
    members: dict[str, list[dict[str, Any]]] = {}
    for workspace in workspaces:
        worktree = workspace.get("worktree") or {}
        if worktree.get("repo_key"):
            members.setdefault(worktree["repo_key"], []).append(workspace)
    group_of = {}
    for group in members.values():
        if any(w["worktree"].get("is_linked_worktree") for w in group):
            for workspace in group:
                group_of[workspace["workspace_id"]] = group

    planned = []
    for workspace in workspaces:
        workspace_id = workspace["workspace_id"]
        group = group_of.get(workspace_id)
        if group is None:
            if workspace_id in cwd_of:
                planned.append((workspace, cwd_of[workspace_id], None))
            continue
        if not all(w["workspace_id"] in cwd_of for w in group):
            continue
        primaries = [w for w in group if not w["worktree"].get("is_linked_worktree")]
        if primaries and workspace is primaries[0]:
            linked = [w for w in group if w not in primaries]
            planned.append((workspace, cwd_of[workspace_id], linked))
        elif workspace in primaries or not primaries:
            planned.append((workspace, cwd_of[workspace_id], None))
    return planned


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--apply", action="store_true", help="close them, rather than list them"
    )
    args = parser.parse_args()
    try:
        workspaces = herdr("workspace", "list")["workspaces"]
        panes = herdr("pane", "list")["panes"]
        found = empty_workspaces(
            workspaces,
            panes,
            lambda pane_id: herdr("pane", "process-info", "--pane", pane_id)[
                "process_info"
            ],
        )
    except HerdrError as error:
        print(f"herdr-prune-workspaces: {error}", file=sys.stderr)
        return 1

    failed = False
    for workspace, cwd, linked in closures(workspaces, found):
        name = workspace.get("label") or workspace["workspace_id"]
        if linked:
            name += " with " + ", ".join(w.get("label") or w["workspace_id"] for w in linked)
        if not args.apply:
            print(f"would close {name} {cwd}")
            continue
        command = ["workspace", "close", workspace["workspace_id"]]
        if linked is not None:
            command.append("--group")
        try:
            herdr(*command)
        except HerdrError as error:
            print(f"herdr-prune-workspaces: {name}: {error}", file=sys.stderr)
            failed = True
            continue
        print(f"closed {name} {cwd}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
