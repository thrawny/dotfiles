#!/usr/bin/env python3
"""Portless's private Tailscale adapter. No operator or sudo privileges required."""

import json
import socket
import sys

SOCKET = "/run/portless-tailscale.sock"
MAX_RESPONSE = 1024 * 1024


def main() -> int:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(25)
            connection.connect(SOCKET)
            connection.sendall(json.dumps(sys.argv[1:]).encode() + b"\n")
            with connection.makefile("rb") as stream:
                raw = stream.readline(MAX_RESPONSE + 1)
            if len(raw) > MAX_RESPONSE:
                raise ValueError("Oversized response from preview service")
            response = json.loads(raw)
        sys.stdout.write(response["stdout"])
        sys.stderr.write(response["stderr"])
        return response["code"]
    except (OSError, ValueError, KeyError) as error:
        print(f"Portless preview service unavailable: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
