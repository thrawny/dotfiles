#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: open-url <url>" >&2
}

if [[ $# -lt 1 || -z "${1:-}" ]]; then
  usage
  exit 64
fi

url="$1"

# Fullscreen TUIs open clicked links from inside their own sandbox. Ask the
# host to route them; never expose the compositor socket or silently create
# a new browser window when the broker is unavailable.
if [[ "${SANDBOX:-}" == 1 ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  exec python3 -I "$script_dir/desktop-broker" open-url -- "$url"
fi

# This router focuses the destination itself. Forwarding activation metadata
# inherited from a long-lived panel or layer-shell popup can make Chromium
# defer ProcessSingleton requests until that popup releases focus.
unset XDG_ACTIVATION_TOKEN DESKTOP_STARTUP_ID

# Outside Hyprland, or before hyprctl/jq are available, we cannot find or
# focus a window. Open a fresh Helium window instead.
open_detached() {
  exec helium --new-window "$url"
}

open_url_with_wtype() (
  local clipboard_file clipboard_type clipboard_types had_clipboard=false
  clipboard_file=$(mktemp)

  restore_clipboard() {
    trap - EXIT
    if [[ "$had_clipboard" == true ]]; then
      wl-copy --type "$clipboard_type" <"$clipboard_file" || true
    else
      wl-copy --clear || true
    fi
    rm -f "$clipboard_file"
  }
  trap restore_clipboard EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  clipboard_types=$(wl-paste --list-types 2>/dev/null || true)
  if [[ -n "$clipboard_types" ]]; then
    for clipboard_type in \
      'text/plain;charset=utf-8' \
      'text/plain;charset=UTF-8' \
      'UTF8_STRING' \
      'text/plain' \
      'image/png' \
      'text/uri-list'; do
      if grep -Fxq "$clipboard_type" <<<"$clipboard_types"; then
        break
      fi
      clipboard_type=""
    done

    if [[ -z "$clipboard_type" ]]; then
      clipboard_type=$(head -n1 <<<"$clipboard_types")
    fi

    wl-paste --no-newline --type "$clipboard_type" >"$clipboard_file"
    had_clipboard=true
  fi

  wtype -M ctrl -k t -m ctrl
  printf '%s' "$url" | wl-copy --type 'text/plain;charset=utf-8'
  sleep 0.1
  wtype -M ctrl -k v -m ctrl
  sleep 0.1
  wtype -k Return
)

# Addresses come from hyprctl JSON, not user input. Match them against
# live window objects: Hyprland's Lua dispatch does not accept legacy
# `hyprctl dispatch focuswindow address:...` syntax.
hypr_window_action() {
  local address="$1" action="$2"
  hyprctl eval "for _,w in ipairs(hl.get_windows()) do if tostring(w.address) == '$address' then hl.dispatch(hl.dsp.$action) break end end" >/dev/null
}
hypr_focus_window() {
  hypr_window_action "$1" 'focus({window=w})'
}
hypr_move_window() {
  hypr_window_action "$1" 'window.move({window=w,workspace="name:web",follow=false})'
}

# Prefer a browser on the active workspace, then one on web.
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  clients=$(hyprctl -j clients 2>/dev/null || true)
  active=$(hyprctl -j activeworkspace 2>/dev/null || true)
  if [[ -n "$clients" && -n "$active" ]]; then
    current=$(jq -r '.name' <<<"$active")
    address=$(jq -r --arg current "$current" '
      [.[] | select((.class | ascii_downcase) == "helium" and .workspace.name == $current)]
      | sort_by(.focusHistoryID) | .[0].address // empty' <<<"$clients")
    if [[ -z "$address" ]]; then
      address=$(jq -r '
        [.[] | select((.class | ascii_downcase) == "helium" and .workspace.name == "web")]
        | sort_by(.focusHistoryID) | .[0].address // empty' <<<"$clients")
    fi
    if [[ -n "$address" ]]; then
      hypr_focus_window "$address"
      sleep 0.2
      if command -v wtype >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
        open_url_with_wtype
        exit 0
      fi
      exec helium --new-tab "$url"
    fi
    # Focus web before launch and move the newly created window explicitly:
    # Chromium can otherwise reactivate the workspace of its existing process.
    known=$(jq -c '[.[] | select((.class | ascii_downcase) == "helium") | .address]' <<<"$clients")
    hyprctl eval 'hl.dispatch(hl.dsp.focus({workspace="name:web"}))' >/dev/null
    helium --new-window "$url" >/dev/null 2>&1 &
    for _ in {1..300}; do
      fresh=$(hyprctl -j clients 2>/dev/null || true)
      new=$(jq -r --argjson known "$known" '[.[] | select((.class | ascii_downcase) == "helium" and (.address as $a | $known | index($a) | not))] | .[0].address // empty' <<<"${fresh:-[]}" 2>/dev/null || true)
      if [[ -n "$new" ]]; then
        hypr_move_window "$new"
        hypr_focus_window "$new"
        exit 0
      fi
      sleep 0.1
    done
    echo "open-url: timed out waiting for a new Helium window" >&2
    exit 1
  fi
fi

open_detached
