#!/usr/bin/env bash

[[ "${TRACE}" ]] && set -x
set -euo pipefail

error() {
  echo "Error: $*" >&2
  exit 1
}

# Lua long strings preserve quotes and backslashes in project paths.
lua_string() {
  local equals=""
  while [[ "$1" == *"]${equals}]"* ]]; do
    equals+="="
  done
  printf '[%s[%s]%s]' "$equals" "$1" "$equals"
}

# hyprctl reports Lua errors on stdout; preserve them on failure.
hypr_request() {
  local output exit_code
  if output=$(hyprctl "$@" 2>&1); then
    return 0
  else
    exit_code=$?
    printf '%s\n' "$output" >&2
    return "$exit_code"
  fi
}

show_usage() {
  echo "Usage: hyprland-project [--name NAME] [--terminals COUNT] [directory]"
  echo ""
  echo "Create a Hyprland workspace for a project with terminals."
  echo "Workspace name is derived from the directory basename unless overridden."
  echo ""
  echo "Options:"
  echo "  --name NAME        Override the workspace name"
  echo "  --terminals COUNT  Number of terminals to spawn (default: 3)"
  echo "  -h, --help         Show this help"
  echo ""
  echo "Arguments:"
  echo "  directory    Project directory (default: current directory)"
}

main() {
  local workspace_name=""
  local terminals=3
  local project_dir="$PWD"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        show_usage
        exit 0
        ;;
      --name)
        [[ $# -ge 2 ]] || error "Missing value for --name"
        workspace_name="$2"
        shift 2
        ;;
      --terminals)
        [[ $# -ge 2 ]] || error "Missing value for --terminals"
        [[ "$2" =~ ^[0-9]+$ ]] || error "--terminals must be a non-negative integer"
        terminals="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -*)
        error "Unknown option: $1"
        ;;
      *)
        [[ "$project_dir" == "$PWD" ]] || error "Only one directory argument is supported"
        project_dir="$1"
        shift
        ;;
    esac
  done

  if [[ $# -gt 0 ]]; then
    [[ "$project_dir" == "$PWD" ]] || error "Only one directory argument is supported"
    project_dir="$1"
    shift
  fi

  [[ $# -eq 0 ]] || error "Unexpected arguments: $*"

  project_dir=$(cd "$project_dir" && pwd)

  if [[ ! -d "$project_dir" ]]; then
    error "Directory does not exist: $project_dir"
  fi

  if [[ -z "$workspace_name" ]]; then
    workspace_name=$(basename "$project_dir")
  fi

  # Register in the Lua-owned map (config/hypr/lua/projectdirs.lua). Register
  # before the existing-workspace fast path so reopening a project refreshes
  # the map after a compositor restart.
  hypr_request eval "set_project_dir($(lua_string "$workspace_name"), $(lua_string "$project_dir"))"

  # Reuse an existing project; new projects get the first free positive ID.
  # Creating name:foo directly would assign a negative internal ID instead.
  local workspaces workspace_id
  workspaces=$(hyprctl workspaces -j)
  workspace_id=$(jq -r --arg n "$workspace_name" \
    '[.[] | select(.name == $n) | .id][0] // empty' <<< "$workspaces")
  if [[ -n "$workspace_id" ]]; then
    hypr_request dispatch "hl.dsp.focus({workspace = $(lua_string "$workspace_id")})"
    exit 0
  fi

  workspace_id=1
  while jq -e --argjson id "$workspace_id" \
    'any(.[]; .id == $id)' <<< "$workspaces" >/dev/null; do
    workspace_id=$((workspace_id + 1))
  done
  hypr_request dispatch "hl.dsp.focus({workspace = $(lua_string "$workspace_id")})"
  hypr_request dispatch "hl.dsp.workspace.rename({workspace = $workspace_id, name = $(lua_string "$workspace_name")})"

  local terminal_cmd
  printf -v terminal_cmd 'ghostty +new-window --working-directory=%q' "$project_dir"
  for ((i = 0; i < terminals; i++)); do
    hypr_request dispatch "hl.dsp.exec_cmd($(lua_string "$terminal_cmd"))"
  done
}

main "$@"
