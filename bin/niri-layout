#!/usr/bin/env bash

[[ "${TRACE}" ]] && set -x
set -euo pipefail

set_output_power() {
  local output="$1"
  local state="$2"

  # Layouts are shared across machines/docks, so don't fail if an output is
  # currently disconnected or named differently by the kernel/dock.
  niri msg output "$output" "$state" >/dev/null 2>&1 || true
}

work_output() {
  local output
  output=$(niri msg -j outputs | jq -er '
    [.[] | select(.make == "Philips Consumer Electronics Company") | .name]
    | if length == 1 then .[0] else empty end
  ') || {
    echo "Work layout requires exactly one connected Philips monitor." >&2
    return 1
  }
  printf '%s\n' "$output"
}

position_work_outputs() {
  local output="$1"
  local position x y
  # Use logical dimensions so centering also works with display scaling.
  position=$(niri msg -j outputs | jq -er --arg output "$output" '
    .[$output].logical as $monitor | .["eDP-1"].logical as $laptop
    | if ($monitor.width > 0 and $monitor.height > 0 and $laptop.width > 0)
      then [((($monitor.width - $laptop.width) / 2) | round), $monitor.height] | @tsv
      else error("Work layout requires active Philips and laptop outputs") end
  ')
  read -r x y <<< "$position"
  niri msg output "$output" position set 0 0
  niri msg output eDP-1 position set "$x" "$y"
}

main() {
  local layout="${1:?Usage: niri-layout <laptop|home|work>}"

  case "$layout" in
    laptop)
      set_output_power eDP-1 on
      niri-move-workspaces eDP-1
      niri-set-column-width 0.5
      ;;
    home)
      # Everything on DP-8 (LG), except web on DP-2 (AOC)
      niri-move-workspaces DP-8 --except web
      niri msg action move-workspace-to-monitor --reference web DP-2
      niri msg action move-workspace-to-index --reference main 1
      niri msg action move-workspace-to-index --reference dotfiles 2
      # Home is clamshell: keep the laptop panel disabled so focus-monitor
      # bindings (e.g. Mod+N) can't land on the hidden eDP output.
      set_output_power eDP-1 off
      niri-set-column-width 0.5
      ;;
    work)
      # Connector names change across docks. Find the Philips by identity.
      local output
      output=$(work_output)
      # Main on the laptop panel; everything else on the Philips ultrawide.
      set_output_power eDP-1 on
      niri msg output "$output" on
      position_work_outputs "$output"
      niri-move-workspaces "$output" --except main
      niri msg action move-workspace-to-monitor --reference main eDP-1
      niri-set-column-width 0.33333
      ;;
    *)
      echo "Unknown layout: $layout" >&2
      echo "Available: laptop, home, work" >&2
      exit 1
      ;;
  esac
}

main "$@"
