#!/usr/bin/env bash

[[ "${TRACE:-}" ]] && set -x
set -euo pipefail

sandboxed=false
if [[ "${1:-}" == "--sandbox" ]]; then
  sandboxed=true
  shift
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: pi-worktree-new [--sandbox] <branch> [pi args...]" >&2
  exit 1
fi

branch="$1"
shift
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# Suppress git-worktree-new's Niri launcher because Pi should take over the
# current terminal in the new worktree.
NIRI_SOCKET= "$script_dir/git-worktree-new" "$branch"
worktree_dir=$("$script_dir/git-worktree-go" "$branch")

cd "$worktree_dir"
if [[ "$sandboxed" == true ]]; then
  exec sandbox pi --name "$branch" "$@"
else
  exec pi --name "$branch" "$@"
fi
