#!/usr/bin/env bash
# Focus the Herdr agent that needs attention most, ranked blocked > finished
# since you last looked > merely quiet. Working agents are never targets, so an
# empty queue is a real signal rather than a shrug. Pressing again advances past
# the agent you are on, wrapping at the end, which walks the whole queue.
#
# Herdr only ever reports idle, working, blocked, or unknown (see `herdr pane
# report-agent`), so the "done" its UI shows never reaches the API. We rebuild
# it: state_change_seq climbs on every transition, so an idle agent whose seq is
# higher than when we last sent you there has finished something unseen.
set -euo pipefail
[[ -z "${TRACE:-}" ]] || set -x

herdr="${HERDR_BIN_PATH:-herdr}"
state_file="${HERDR_PLUGIN_STATE_DIR:-$HOME/.local/state/herdr-next-agent}/seen.json"

agents=$("$herdr" agent list 2>/dev/null) || exit 0

seen=$(cat "$state_file" 2>/dev/null) || seen="{}"
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$seen" || seen="{}"

# The pane that invoked the action is authoritative, and unlike the focused
# agent it is set even when the current pane runs a plain shell.
pivot="${HERDR_PANE_ID:-}"
if [[ -z $pivot ]]; then
  pivot=$(jq -r '[.result.agents[] | select(.focused) | .pane_id][0] // ""' <<<"$agents")
fi

read -r workspace tab pane <<<"$(jq -r --arg pivot "$pivot" --argjson seen "$seen" '
  # A pane we have never visited counts as unseen: assuming you have already
  # looked at something you have not is the worse of the two mistakes.
  def tier: if .agent_status == "blocked" then 0
    elif .agent_status != "idle" then null
    elif ($seen[.pane_id] // -1) < .state_change_seq then 1
    else 2 end;
  [ .result.agents[] | . + { tier: tier } | select(.tier != null) ]
  # Lowest state_change_seq first, so the agent that has been quiet longest wins
  # its tier and nothing starves behind a fresher interrupt.
  | sort_by([.tier, .state_change_seq])
  | if length == 0 then
      ""
    else
      (map(.pane_id) | index($pivot)) as $i
      | (if $i == null then .[0] else .[($i + 1) % length] end)
      | "\(.workspace_id) \(.tab_id) \(.pane_id)"
    end
' <<<"$agents")"

if [[ -z ${pane:-} ]]; then
  "$herdr" notification show "Nothing needs you" --sound none >/dev/null
  exit 0
fi

# Both the pane you are leaving and the one you are landing on have now been
# looked at. Panes that no longer exist drop out rather than accumulating.
mkdir -p "$(dirname "$state_file")"
jq --arg pivot "$pivot" --arg target "$pane" --argjson seen "$seen" '
  ([.result.agents[] | { key: .pane_id, value: .state_change_seq }] | from_entries) as $now
  | ($seen | with_entries(select(.key | in($now))))
  | reduce ([$pivot, $target] | .[] | select(. != "")) as $id (.; .[$id] = ($now[$id] // .[$id]))
' <<<"$agents" >"$state_file.tmp" && mv "$state_file.tmp" "$state_file"

# Focusing the agent alone only moves the server's idea of focus: herdr 0.9
# leaves the attached client on whatever workspace and tab it was showing, so
# the jump has to be spelled out from the outside in.
"$herdr" workspace focus "$workspace" >/dev/null
"$herdr" tab focus "$tab" >/dev/null
"$herdr" agent focus "$pane" >/dev/null
