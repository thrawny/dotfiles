#!/usr/bin/env bash
# Prototype: summon an agent-thread window to the current workspace.
#
# Picker rows come from agent-switch sessions joined with live niri windows.
# Selection semantics:
#   - window parked in the nirius scratchpad -> summon it here (show + tile)
#   - window visible anywhere -> go to it (focus-window switches workspace)
#
# THREAD_SUMMON_ALL=1 lists every window (for testing in a nested niri
# session where no real agent sessions exist).

[[ "${TRACE:-}" ]] && set -x
set -euo pipefail

windows=$(niri msg --json windows)
workspaces=$(niri msg --json workspaces)
focused_ws_id=$(jq -r '.[] | select(.is_focused) | .id' <<< "$workspaces")

scratch_ids=$(nirius list-scratchpad 2>/dev/null | sed -n 's/^id: \([0-9]*\),.*/\1/p' || true)

if [[ "${THREAD_SUMMON_ALL:-}" == "1" ]]; then
  sessions='{}'
else
  sessions=$(agent-switch list 2>/dev/null | jq '.sessions' || echo '{}')
fi

# Rows: <window-id>\t<aligned pretty columns>
rows=$(jq -rn \
  --argjson windows "$windows" \
  --argjson workspaces "$workspaces" \
  --argjson sessions "$sessions" \
  --argjson ws_id "$focused_ws_id" \
  --arg scratch "$scratch_ids" '
  def rpad($n): tostring | .[0:$n] as $s | $s + ((" " * ($n - ($s | length))) // "");
  def ws_label($id):
    (($workspaces[] | select(.id == $id) | (.name // (.idx | tostring))) // "?");
  def where($w):
    if ($scratch | split("\n") | index($w.id | tostring)) then "parked"
    elif $w.workspace_id == $ws_id then "here"
    else ws_label($w.workspace_id)
    end;
  def rank: {"waiting": 0, "responding": 1, "idle": 2}[.state] // 3;

  [ $windows[] as $w
    | select($w.title != "thread-summon")
    | ($sessions[$w.id | tostring]) as $s
    | if $s != null then
        { id: $w.id, agent: $s.agent, state: $s.state,
          project: ($s.cwd // "?" | sub(".*/"; "")),
          where: where($w), title: $w.title }
      elif ($sessions | length) == 0 then
        { id: $w.id, agent: ($w.app_id // "?"), state: "-",
          project: "-", where: where($w), title: $w.title }
      else
        empty
      end
  ]
  | sort_by(rank, .project)
  | .[]
  | (if .state == "waiting" then "[33m"
     elif .state == "responding" then "[34m"
     else "" end) as $c
  | "\(.id)\t\(.project | rpad(24))\(.agent | rpad(8))\($c)\(.state | rpad(12))[0m\(.where | rpad(16))[2m\(.title | rpad(60))[0m"
')

if [[ -z "$rows" ]]; then
  echo "no agent threads found" >&2
  sleep 1
  exit 0
fi

header="$(printf '%-24s%-8s%-12s%-16s%s' PROJECT AGENT STATE WHERE TITLE)"

set +e
selected=$(fzf --prompt="thread> " --height=100% --ansi --no-multi --cycle \
  --info=hidden --delimiter='\t' --with-nth=2 --nth=2 \
  --header="$header" <<< "$rows")
rc=$?
set -e
[[ $rc -ne 0 || -z "$selected" ]] && exit 0

win_id=$(cut -f1 <<< "$selected")

if grep -qx "$win_id" <<< "$scratch_ids"; then
  nirius scratchpad-show --id "$win_id"
  # Tiling does double duty: summoned threads join the area tiled (not
  # floating), and tiling evicts the window from niriusd's scratchpad
  # member list — otherwise niriusd drags it back whenever the
  # bottom-most workspace changes (e.g. the user visits the scratch
  # workspace).
  niri msg action move-window-to-tiling --id "$win_id"
else
  # Visible thread: go to it (focus-window switches workspace if needed).
  niri msg action focus-window --id "$win_id"
fi
