#!/usr/bin/env -S uv run --script
#
# /// script
# dependencies = ["markdown-it-py", "pygments"]
# ///
"""Render a blueprint source file to a self-contained HTML artifact.

Usage:
    blueprint-html lab/foo.blueprint.md                   # -> lab/foo.html
    blueprint-html foo.blueprint.md -o out.html

Source format: markdown with YAML-ish frontmatter (title, tier, description)
and typed fences — callstack, filetree, contract, signatures, mockup, mermaid.
See the blueprint skill's ARTIFACT-FORMAT.md for the grammar.

Lenient by design: unknown fence types and missing metadata produce stderr
warnings, never errors.
"""

import argparse
import html
import re
import sys
from datetime import date
from pathlib import Path

from markdown_it import MarkdownIt
from pygments import highlight
from pygments.formatters import HtmlFormatter
from pygments.lexers import get_lexer_by_name
from pygments.style import Style
from pygments.token import (
    Comment,
    Error,
    Generic,
    Keyword,
    Name,
    Number,
    Operator,
    String,
)
from pygments.util import ClassNotFound

DIFF_FENCES = {"callstack", "filetree", "contract", "signatures"}
MARKER_CLASS = {"+": "add", "-": "del", "~": "mod"}
COMMENT_RE = re.compile(r"(\s#\s?.*)$")
ANCHOR_RE = re.compile(r"([\w./-]+\.\w+:\d+)")


def _bp_style(bg: str, muted: str, kw: str, lit: str, ink: str) -> type[Style]:
    return type(
        "BpStyle",
        (Style,),
        {
            "background_color": bg,
            "styles": {
                Comment: f"italic {muted}",
                Keyword: f"bold {kw}",
                Keyword.Type: f"bold {kw}",
                Name.Builtin: kw,
                Name.Function: ink,
                Name.Class: ink,
                String: lit,
                Number: lit,
                Name.Decorator: lit,
                Operator: muted,
                Generic.Inserted: kw,
                Generic.Deleted: lit,
                Error: lit,
            },
        },
    )


BP_LIGHT = _bp_style("#f4f3ef", "#6f6e66", "#1c5cab", "#8a4b12", "#26251f")
BP_DARK = _bp_style("#1d2026", "#94927f", "#7fb2f0", "#f0a97a", "#e6e4dd")
FRAG_FMT = HtmlFormatter(nowrap=True, nobackground=True)
SIG_LEXER = get_lexer_by_name("typescript", stripnl=False)


def style_sheet(style: type[Style], prefix: str = ".hl") -> str:
    raw = HtmlFormatter(style=style, nobackground=True).get_style_defs(prefix)
    return "\n".join(
        line
        for line in raw.splitlines()
        if line.startswith(prefix + " .") and ".hll" not in line
    )


warnings: list[str] = []


def warn(msg: str) -> None:
    warnings.append(msg)
    print(f"blueprint-html: warning: {msg}", file=sys.stderr)


def parse_frontmatter(text: str) -> tuple[dict[str, str], str]:
    meta: dict[str, str] = {}
    if not text.startswith("---\n"):
        return meta, text
    end = text.find("\n---", 4)
    if end == -1:
        return meta, text
    for line in text[4:end].splitlines():
        if ":" in line and not line.lstrip().startswith("#"):
            key, _, value = line.partition(":")
            meta[key.strip()] = value.strip().strip("\"'")
    return meta, text[end + 4 :]


def render_diff_line(line: str, lexer=None) -> str:
    marker = line[:1]
    cls = MARKER_CLASS.get(marker, "ctx")
    body, comment = line, ""
    m = COMMENT_RE.search(line)
    if m:
        body = line[: m.start()]
        comment = ANCHOR_RE.sub(
            r'<span class="anchor">\1</span>', html.escape(m.group(1))
        )
        comment = f'<span class="comment">{comment}</span>'
    if lexer is not None and body.strip():
        prefix, code = (marker, body[1:]) if cls != "ctx" else ("", body)
        body_html = html.escape(prefix) + highlight(code, lexer, FRAG_FMT).rstrip("\n")
    else:
        body_html = html.escape(body)
    # newline lives inside the span: keeps copy-paste byte-exact and avoids
    # whitespace-only anonymous blocks doubling the line height under pre
    return f'<span class="ln {cls}">{body_html}{comment}\n</span>'


def render_diff_block(kind: str, content: str) -> str:
    lexer = SIG_LEXER if kind == "signatures" else None
    lines = "".join(
        render_diff_line(ln, lexer) for ln in content.rstrip("\n").split("\n")
    )
    return (
        f'<div class="block"><span class="badge">{kind}</span>'
        f'<pre class="diffish hl">{lines}</pre></div>\n'
    )


def render_mockup(content: str) -> str:
    return (
        '<div class="block"><span class="badge">mockup</span>'
        f'<iframe class="mockup" sandbox="" srcdoc="{html.escape(content, quote=True)}">'
        "</iframe></div>\n"
    )


def make_fence_renderer(default_fence):
    def fence(self, tokens, idx, options, env):
        token = tokens[idx]
        kind = token.info.strip().split(" ")[0] if token.info else ""
        if kind in DIFF_FENCES:
            return render_diff_block(kind, token.content)
        if kind == "mockup":
            return render_mockup(token.content)
        if kind == "mermaid":
            return (
                '<div class="figure mermaid-figure">'
                f'<pre class="mermaid">{html.escape(token.content)}</pre></div>\n'
            )
        if kind:
            try:
                lexer = get_lexer_by_name(kind, stripnl=False)
            except ClassNotFound:
                warn(f"unknown fence type '{kind}' rendered as plain code")
            else:
                code = highlight(token.content, lexer, FRAG_FMT)
                return f'<pre class="hl"><code>{code}</code></pre>\n'
        return default_fence(tokens, idx, options, env)

    return fence


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def build_markdown() -> MarkdownIt:
    md = MarkdownIt("commonmark").enable("table").enable("strikethrough")
    md.add_render_rule("fence", make_fence_renderer(md.renderer.rules.get("fence")))
    return md


def render_body(md: MarkdownIt, body: str) -> tuple[str, list[tuple[str, str]]]:
    tokens = md.parse(body)
    toc: list[tuple[str, str]] = []
    for i, token in enumerate(tokens):
        if token.type == "heading_open" and token.tag == "h2":
            title = tokens[i + 1].content
            slug = slugify(title)
            token.attrSet("id", slug)
            toc.append((slug, title))
    return md.renderer.render(tokens, md.options, {}), toc


LIGHT_VARS = """--bg:#fdfdfc; --fg:#1c1c1a; --muted:#6f6e66; --line:#e4e2da;
  --accent:#3b5bdb; --add:#1c5cab; --add-bg:#dbe8fa; --del:#ad4600; --del-bg:#fbe4d5;
  --mod:#45443e; --mod-bg:#eae8e0; --code-bg:#f4f3ef;"""
DARK_VARS = """--bg:#14161a; --fg:#e6e4dd; --muted:#94927f; --line:#2b2e35;
  --accent:#7b9aff; --add:#7fb2f0; --add-bg:#122840; --del:#f0894a; --del-bg:#3a2410;
  --mod:#cfcdc2; --mod-bg:#282b32; --code-bg:#1d2026;"""

CSS = (
    ":root { " + LIGHT_VARS + " }\n"
    ':root[data-theme="dark"] { ' + DARK_VARS + " }\n"
    "@media (prefers-color-scheme: dark) {\n"
    '  :root:not([data-theme="light"]) { '
    + DARK_VARS
    + " } }"
    + """
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--fg);
  font:16px/1.6 system-ui,-apple-system,sans-serif; }
main { display:grid; padding:1.5rem 0 4rem;
  grid-template-columns:
    [full-start] minmax(1.25rem,1fr)
    [wide-start] minmax(0,4rem)
    [content-start] minmax(0,52rem) [content-end]
    minmax(0,4rem) [wide-end] minmax(1.25rem,1fr) [full-end]; }
main > * { grid-column: content; }
main > .figure { grid-column: wide; }
main > .mermaid-figure { grid-column: full; padding-inline:1.25rem; }
.figure { position:relative; margin:1.2rem 0; padding:.6rem 0; overflow-x:auto;
  overscroll-behavior-x:contain; }
.mermaid-figure svg { display:block; margin-inline:auto;
  max-width:100% !important; height:auto !important; }
.figbtn { position:absolute; top:.2rem; right:.2rem; font:.7rem/1 system-ui;
  padding:.3rem .6rem; border:1px solid var(--line); border-radius:6px;
  background:var(--code-bg); color:var(--muted); cursor:pointer; }
dialog.zoom { width:96vw; height:92vh; max-width:none; max-height:none;
  border:0; padding:0; overflow:auto; background:var(--bg); }
dialog.zoom svg { width:auto !important; max-width:none !important; }
dialog.zoom::backdrop { background:rgb(0 0 0 / .5); }
header.meta { border-bottom:1px solid var(--line); padding:1.5rem 0 1rem; margin-bottom:1.5rem; }
header.meta h1 { margin:0 0 .35rem; font-size:1.6rem; line-height:1.25; }
header.meta p { margin:.25rem 0; color:var(--muted); }
.tier { display:inline-block; font-size:.72rem; font-weight:600; text-transform:uppercase;
  letter-spacing:.06em; color:var(--accent); border:1px solid var(--accent);
  border-radius:99px; padding:.1rem .6rem; margin-bottom:.5rem; }
nav.toc { font-size:.9rem; border:1px solid var(--line); border-radius:8px;
  padding:.75rem 1rem; margin-bottom:1.5rem; }
nav.toc a { color:var(--accent); text-decoration:none; margin-right:1rem;
  display:inline-block; }
h2 { margin-top:2.2rem; padding-top:.6rem; border-top:1px solid var(--line);
  font-size:1.25rem; }
h3 { font-size:1.05rem; }
a { color:var(--accent); }
code { background:var(--code-bg); border-radius:4px; padding:.1em .35em;
  font:.86em/1.5 ui-monospace,'CaskaydiaMono Nerd Font',monospace; }
pre { background:var(--code-bg); border-radius:8px; padding: .9rem 1rem;
  overflow-x:auto; font:.82rem/1.55 ui-monospace,'CaskaydiaMono Nerd Font',monospace; }
pre code { background:none; padding:0; font:inherit; }
.block { position:relative; margin:1rem 0; }
.badge { position:absolute; top:.45rem; right:.7rem; font-size:.68rem; font-weight:600;
  text-transform:uppercase; letter-spacing:.07em; color:var(--muted); }
pre.diffish { padding-top:1.5rem; }
pre.diffish .ln { display:block; white-space:pre;
  border-left:3px solid transparent; padding-left:.5rem; }
.ln.add { color:var(--add); background:var(--add-bg); border-left-color:var(--add); }
.ln.del { color:var(--del); background:var(--del-bg); border-left-color:var(--del);
  border-left-style:double; }
.ln.mod { color:var(--mod); background:var(--mod-bg); border-left-color:var(--mod);
  border-left-style:dashed; }
.comment { color:var(--muted); font-style:italic; }
.comment .anchor { color:var(--muted); font-style:normal; font-weight:600;
  text-decoration:underline dotted; }
iframe.mockup { width:100%; min-height:22rem; border:1px solid var(--line);
  border-radius:8px; background:#fff; margin-top:1.4rem; }
pre.mermaid { text-align:left; }
table { border-collapse:collapse; width:100%; display:block; overflow-x:auto;
  font-size:.92rem; }
th, td { border:1px solid var(--line); padding:.45rem .7rem; text-align:left; }
th { background:var(--code-bg); }
blockquote { margin:1rem 0; padding:.1rem 1rem; border-left:3px solid var(--line);
  color:var(--muted); }
footer { margin-top:3rem; font-size:.8rem; color:var(--muted); }
.themebtn { position:fixed; top:.75rem; right:.75rem; z-index:10;
  font:1rem/1 system-ui; padding:.35rem .55rem; border:1px solid var(--line);
  border-radius:8px; background:var(--code-bg); color:var(--muted); cursor:pointer; }
"""
)

CSS_HL = (
    style_sheet(BP_LIGHT)
    + "\n"
    + style_sheet(BP_DARK, ':root[data-theme="dark"] .hl')
    + "\n@media (prefers-color-scheme: dark) {\n"
    + style_sheet(BP_DARK, ':root:not([data-theme="light"]) .hl')
    + "\n}\n"
)

FAVICON = (
    "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>"
    "<rect width='64' height='64' rx='12' fill='%231c5cab'/>"
    "<path d='M16 20h32M16 30h24M16 40h28M16 50h18' stroke='%23fdfdfc'"
    " stroke-width='5' stroke-linecap='round'/></svg>"
)

THEME_JS = """
<script>
  const root = document.documentElement;
  let saved = null;
  try { saved = localStorage.getItem("bp-theme"); } catch {}
  if (saved === "light" || saved === "dark") root.dataset.theme = saved;
  addEventListener("DOMContentLoaded", () => {
    document.getElementById("themebtn").onclick = () => {
      const dark = root.dataset.theme
        ? root.dataset.theme === "dark"
        : matchMedia("(prefers-color-scheme: dark)").matches;
      const next = dark ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("bp-theme", next); } catch {}
      dispatchEvent(new CustomEvent("bp-theme"));
    };
  });
</script>
"""

MERMAID_JS = """
<script type="module">
try {
  const { default: mermaid } = await import(
    "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
  const pres = [...document.querySelectorAll("pre.mermaid")];
  const srcs = pres.map(p => p.textContent);
  const natural = { useMaxWidth: false };
  const dark = () => document.documentElement.dataset.theme
    ? document.documentElement.dataset.theme === "dark"
    : matchMedia("(prefers-color-scheme: dark)").matches;
  const render = async () => {
    mermaid.initialize({ startOnLoad: false, theme: dark() ? "dark" : "neutral",
      sequence: { ...natural, actorMargin: 60, messageFontSize: 14 },
      flowchart: natural, class: natural, state: natural, er: natural,
      gantt: natural, journey: natural, timeline: natural });
    pres.forEach((p, i) => {
      p.textContent = srcs[i];
      p.removeAttribute("data-processed");
    });
    await mermaid.run({ querySelector: "pre.mermaid" });
  };
  await render();
  addEventListener("bp-theme", render);
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (!document.documentElement.dataset.theme) render();
  });
  const dlg = Object.assign(document.createElement("dialog"), { className: "zoom" });
  document.body.append(dlg);
  dlg.addEventListener("click", () => dlg.close());
  for (const fig of document.querySelectorAll(".mermaid-figure")) {
    if (!fig.querySelector("svg")) continue;
    const open = () => {
      const svg = fig.querySelector("svg");
      if (svg) { dlg.replaceChildren(svg.cloneNode(true)); dlg.showModal(); }
    };
    const b = document.createElement("button");
    b.className = "figbtn";
    b.textContent = "\\u26f6";
    b.title = "Maximize";
    b.onclick = open;
    fig.append(b);
    fig.addEventListener("dblclick", open);
  }
} catch { /* offline: diagrams stay readable as text */ }
</script>
"""


def render_page(meta: dict[str, str], body_html: str, toc, src: Path) -> str:
    title = meta.get("title") or src.stem.removesuffix(".blueprint")
    tier = meta.get("tier", "")
    description = meta.get("description", "")
    tier_html = f'<span class="tier">{html.escape(tier)}</span>' if tier else ""
    desc_html = f"<p>{html.escape(description)}</p>" if description else ""
    toc_html = ""
    if len(toc) >= 4:
        links = "".join(f'<a href="#{s}">{html.escape(t)}</a>' for s, t in toc)
        toc_html = f'<nav class="toc">{links}</nav>'
    mermaid_js = MERMAID_JS if 'class="mermaid"' in body_html else ""
    return f"""<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(title)}</title>
<link rel="icon" href="{FAVICON}">
<style>{CSS}{CSS_HL}</style>
{THEME_JS}
<button id="themebtn" class="themebtn" title="Toggle light/dark">&#9680;</button>
<main>
<header class="meta">
{tier_html}
<h1>{html.escape(title)}</h1>
{desc_html}
</header>
{toc_html}
{body_html}
<footer>Blueprint rendered from <code>{html.escape(str(src))}</code>
on {date.today().isoformat()} — source file is the single source of truth.</footer>
</main>
{mermaid_js}
</html>
"""


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("src", type=Path, help="blueprint source markdown file")
    parser.add_argument("-o", "--out", type=Path, help="output HTML path")
    args = parser.parse_args()

    text = args.src.read_text()
    meta, body = parse_frontmatter(text)
    if "title" not in meta:
        warn(f"no title in frontmatter, using '{args.src.stem}'")

    body_html, toc = render_body(build_markdown(), body)
    page = render_page(meta, body_html, toc, args.src)

    out = args.out or Path("lab") / f"{args.src.stem.removesuffix('.blueprint')}.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page)
    print(out)


if __name__ == "__main__":
    main()
