#!/usr/bin/env -S uv run --script
#
# /// script
# dependencies = ["markdown-it-py"]
# ///
"""Render a blueprint source file to a self-contained HTML artifact.

Usage:
    blueprint-html docs/plans/foo.blueprint.md            # -> lab/foo.html
    blueprint-html foo.blueprint.md -o out.html

Source format: markdown with YAML-ish frontmatter (title, tier, description)
and typed fences — callstack, filetree, contract, signatures, mockup, mermaid.
See the blueprint skill's ARTIFACT-FORMAT.md for the grammar.

Lenient by design: unknown fence types and missing metadata produce stderr
warnings, never errors.
"""

import argparse
import html
import re
import sys
from datetime import date
from pathlib import Path

from markdown_it import MarkdownIt

DIFF_FENCES = {"callstack", "filetree", "contract", "signatures"}
MARKER_CLASS = {"+": "add", "-": "del", "~": "mod"}
COMMENT_RE = re.compile(r"(\s#\s?.*)$")
ANCHOR_RE = re.compile(r"([\w./-]+\.\w+:\d+)")

warnings: list[str] = []


def warn(msg: str) -> None:
    warnings.append(msg)
    print(f"blueprint-html: warning: {msg}", file=sys.stderr)


def parse_frontmatter(text: str) -> tuple[dict[str, str], str]:
    meta: dict[str, str] = {}
    if not text.startswith("---\n"):
        return meta, text
    end = text.find("\n---", 4)
    if end == -1:
        return meta, text
    for line in text[4:end].splitlines():
        if ":" in line and not line.lstrip().startswith("#"):
            key, _, value = line.partition(":")
            meta[key.strip()] = value.strip().strip("\"'")
    return meta, text[end + 4 :]


def render_diff_line(line: str) -> str:
    marker = line[:1]
    cls = MARKER_CLASS.get(marker, "ctx")
    body, comment = line, ""
    m = COMMENT_RE.search(line)
    if m:
        body = line[: m.start()]
        comment = ANCHOR_RE.sub(
            r'<span class="anchor">\1</span>', html.escape(m.group(1))
        )
        comment = f'<span class="comment">{comment}</span>'
    return f'<span class="ln {cls}">{html.escape(body)}{comment}</span>'


def render_diff_block(kind: str, content: str) -> str:
    lines = "\n".join(render_diff_line(ln) for ln in content.rstrip("\n").split("\n"))
    return (
        f'<div class="block"><span class="badge">{kind}</span>'
        f'<pre class="diffish">{lines}</pre></div>\n'
    )


def render_mockup(content: str) -> str:
    return (
        '<div class="block"><span class="badge">mockup</span>'
        f'<iframe class="mockup" sandbox="" srcdoc="{html.escape(content, quote=True)}">'
        "</iframe></div>\n"
    )


def make_fence_renderer(default_fence):
    def fence(self, tokens, idx, options, env):
        token = tokens[idx]
        kind = token.info.strip().split(" ")[0] if token.info else ""
        if kind in DIFF_FENCES:
            return render_diff_block(kind, token.content)
        if kind == "mockup":
            return render_mockup(token.content)
        if kind == "mermaid":
            return f'<pre class="mermaid">{html.escape(token.content)}</pre>\n'
        if kind and kind not in {
            "text",
            "sql",
            "ts",
            "js",
            "py",
            "go",
            "rust",
            "json",
            "yaml",
            "diff",
            "sh",
            "bash",
            "lua",
        }:
            warn(f"unknown fence type '{kind}' rendered as plain code")
        return default_fence(tokens, idx, options, env)

    return fence


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def build_markdown() -> MarkdownIt:
    md = MarkdownIt("commonmark").enable("table").enable("strikethrough")
    md.add_render_rule("fence", make_fence_renderer(md.renderer.rules.get("fence")))
    return md


def render_body(md: MarkdownIt, body: str) -> tuple[str, list[tuple[str, str]]]:
    tokens = md.parse(body)
    toc: list[tuple[str, str]] = []
    for i, token in enumerate(tokens):
        if token.type == "heading_open" and token.tag == "h2":
            title = tokens[i + 1].content
            slug = slugify(title)
            token.attrSet("id", slug)
            toc.append((slug, title))
    return md.renderer.render(tokens, md.options, {}), toc


CSS = """
:root { --bg:#fdfdfc; --fg:#1c1c1a; --muted:#6f6e66; --line:#e4e2da;
  --accent:#3b5bdb; --add:#0a7a33; --add-bg:#e9f7ee; --del:#c22525; --del-bg:#fbeaea;
  --mod:#996a00; --mod-bg:#fdf4dd; --code-bg:#f4f3ef; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#14161a; --fg:#e6e4dd; --muted:#94927f; --line:#2b2e35;
    --accent:#7b9aff; --add:#5dd882; --add-bg:#12331d; --del:#ff7d7d; --del-bg:#3a1a1a;
    --mod:#e8c35c; --mod-bg:#33290f; --code-bg:#1d2026; } }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--fg);
  font:16px/1.6 system-ui,-apple-system,sans-serif; }
main { max-width:52rem; margin:0 auto; padding:1.5rem 1.25rem 4rem; }
header.meta { border-bottom:1px solid var(--line); padding:1.5rem 0 1rem; margin-bottom:1.5rem; }
header.meta h1 { margin:0 0 .35rem; font-size:1.6rem; line-height:1.25; }
header.meta p { margin:.25rem 0; color:var(--muted); }
.tier { display:inline-block; font-size:.72rem; font-weight:600; text-transform:uppercase;
  letter-spacing:.06em; color:var(--accent); border:1px solid var(--accent);
  border-radius:99px; padding:.1rem .6rem; margin-bottom:.5rem; }
nav.toc { font-size:.9rem; border:1px solid var(--line); border-radius:8px;
  padding:.75rem 1rem; margin-bottom:1.5rem; }
nav.toc a { color:var(--accent); text-decoration:none; margin-right:1rem;
  display:inline-block; }
h2 { margin-top:2.2rem; padding-top:.6rem; border-top:1px solid var(--line);
  font-size:1.25rem; }
h3 { font-size:1.05rem; }
a { color:var(--accent); }
code { background:var(--code-bg); border-radius:4px; padding:.1em .35em;
  font:.86em/1.5 ui-monospace,'CaskaydiaMono Nerd Font',monospace; }
pre { background:var(--code-bg); border-radius:8px; padding: .9rem 1rem;
  overflow-x:auto; font:.82rem/1.55 ui-monospace,'CaskaydiaMono Nerd Font',monospace; }
pre code { background:none; padding:0; font:inherit; }
.block { position:relative; margin:1rem 0; }
.badge { position:absolute; top:.45rem; right:.7rem; font-size:.68rem; font-weight:600;
  text-transform:uppercase; letter-spacing:.07em; color:var(--muted); }
pre.diffish { padding-top:1.5rem; }
pre.diffish .ln { display:block; white-space:pre; }
.ln.add { color:var(--add); background:var(--add-bg); }
.ln.del { color:var(--del); background:var(--del-bg); }
.ln.mod { color:var(--mod); background:var(--mod-bg); }
.comment { color:var(--muted); font-style:italic; }
.comment .anchor { color:var(--accent); font-style:normal; }
iframe.mockup { width:100%; min-height:22rem; border:1px solid var(--line);
  border-radius:8px; background:#fff; margin-top:1.4rem; }
pre.mermaid { text-align:left; }
table { border-collapse:collapse; width:100%; display:block; overflow-x:auto;
  font-size:.92rem; }
th, td { border:1px solid var(--line); padding:.45rem .7rem; text-align:left; }
th { background:var(--code-bg); }
blockquote { margin:1rem 0; padding:.1rem 1rem; border-left:3px solid var(--line);
  color:var(--muted); }
footer { margin-top:3rem; font-size:.8rem; color:var(--muted); }
"""

MERMAID_JS = """
<script type="module">
try {
  const { default: mermaid } = await import(
    "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
  const dark = matchMedia("(prefers-color-scheme: dark)").matches;
  mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "neutral" });
  await mermaid.run({ querySelector: "pre.mermaid" });
} catch { /* offline: diagrams stay readable as text */ }
</script>
"""


def render_page(meta: dict[str, str], body_html: str, toc, src: Path) -> str:
    title = meta.get("title") or src.stem.removesuffix(".blueprint")
    tier = meta.get("tier", "")
    description = meta.get("description", "")
    tier_html = f'<span class="tier">{html.escape(tier)}</span>' if tier else ""
    desc_html = f"<p>{html.escape(description)}</p>" if description else ""
    toc_html = ""
    if len(toc) >= 4:
        links = "".join(f'<a href="#{s}">{html.escape(t)}</a>' for s, t in toc)
        toc_html = f'<nav class="toc">{links}</nav>'
    mermaid_js = MERMAID_JS if 'class="mermaid"' in body_html else ""
    return f"""<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(title)}</title>
<style>{CSS}</style>
<main>
<header class="meta">
{tier_html}
<h1>{html.escape(title)}</h1>
{desc_html}
</header>
{toc_html}
{body_html}
<footer>Blueprint rendered from <code>{html.escape(str(src))}</code>
on {date.today().isoformat()} — source file is the single source of truth.</footer>
</main>
{mermaid_js}
</html>
"""


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("src", type=Path, help="blueprint source markdown file")
    parser.add_argument("-o", "--out", type=Path, help="output HTML path")
    args = parser.parse_args()

    text = args.src.read_text()
    meta, body = parse_frontmatter(text)
    if "title" not in meta:
        warn(f"no title in frontmatter, using '{args.src.stem}'")

    body_html, toc = render_body(build_markdown(), body)
    page = render_page(meta, body_html, toc, args.src)

    out = args.out or Path("lab") / f"{args.src.stem.removesuffix('.blueprint')}.html"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page)
    print(out)


if __name__ == "__main__":
    main()
