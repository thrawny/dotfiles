#!/usr/bin/env bash
# Keep clipboard bytes out of shell arguments and logs.
set -euo pipefail
umask 077
mode="${1:-}"
db="${CLIPHIST_DB_PATH:-${XDG_CACHE_HOME:-$HOME/.cache}/cliphist/db}"
case "$mode" in
  store)
    [[ "${CLIPBOARD_STATE:-data}" != sensitive ]] || exit 0
    exec cliphist -db-path "$db" store
    ;;
  list)
    # A fresh history has no database yet; this is not a backend failure.
    [[ -e "$db" ]] || exit 0
    exec cliphist -db-path "$db" list
    ;;
  copy|delete)
    entry_id="${2:-}"
    [[ "$entry_id" =~ ^[0-9]+$ ]] || { echo 'Invalid clipboard entry ID' >&2; exit 2; }
    if [[ "$mode" == delete ]]; then
      printf '%s' "$entry_id" | cliphist -db-path "$db" delete
    else
      # Decode first: an expired/deleted ID must not clear the current clipboard.
      decoded=$(mktemp)
      trap 'rm -f "$decoded"' EXIT
      printf '%s' "$entry_id" | cliphist -db-path "$db" decode > "$decoded"
      wl-copy < "$decoded"
    fi
    ;;
  *)
    echo 'Usage: shell-clipboard store|list|copy ID|delete ID' >&2
    exit 2
    ;;
esac
