#!/usr/bin/env bash
# Prototype: one-keystroke dismiss for agent-thread windows.
#
# Parks the focused window in the nirius scratchpad (floats + hides it).
# Summoned windows are un-adopted from the scratchpad by thread-summon,
# so parking is always a plain toggle. If the focused window is already
# a scratchpad member (we are standing in the scratch workspace), do
# nothing rather than un-adopting it in place.

[[ "${TRACE:-}" ]] && set -x
set -euo pipefail

focused_id=$(niri msg --json focused-window | jq -r '.id // empty')
[[ -z "$focused_id" ]] && exit 0

if nirius list-scratchpad 2>/dev/null | sed -n 's/^id: \([0-9]*\),.*/\1/p' | grep -qx "$focused_id"; then
  exit 0
fi

nirius scratchpad-toggle
