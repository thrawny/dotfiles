#!/usr/bin/env bash

[[ "${TRACE}" ]] && set -x
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: git-worktree-new <branch> [git worktree add args...]" >&2
  exit 1
fi

branch="$1"; shift
root=$(git rev-parse --show-toplevel)
repo=$(basename "$root")
wt_dir="${root}/../${repo}-worktrees/${branch}"

if [[ ! -d "$wt_dir" ]]; then
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$wt_dir" "$branch" "$@"
  else
    # With no explicit arguments, branch from main rather than the current HEAD.
    if [[ $# -eq 0 ]]; then
      set -- main
    fi
    git worktree add -b "$branch" "$wt_dir" "$@"
  fi
fi

# Seed local files git does not carry. An existing worktree keeps its own
# copies: it may have edited them, and Claude records permissions granted there
# in settings.local.json. moto's copy_local_files follows the same rule.
copy_local_file() {
  local dest="${wt_dir}/$1"
  [[ -e "$dest" ]] && return 0
  mkdir -p "$(dirname "$dest")"
  cp "${root}/$1" "$dest"
}

while IFS= read -r -d '' src; do
  copy_local_file "${src#"${root}/"}"
done < <(fd -H -I -0 -t f -E .git '^\.(env|env\..*|envrc|envrc\..*|secrets.*)$' "$root")

if [[ -f "${root}/.claude/settings.local.json" ]]; then
  copy_local_file .claude/settings.local.json
fi

if [[ -n "${NIRI_SOCKET:-}" ]] && command -v niri >/dev/null 2>&1; then
  niri-project --terminals 1 "$wt_dir"
else
  printf '%s\n' "$wt_dir"
fi
