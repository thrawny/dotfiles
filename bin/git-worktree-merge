#!/usr/bin/env bash

[[ "${TRACE}" ]] && set -x
set -uo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: git-worktree-merge <branch> [--remove]" >&2
  exit 1
fi

branch="$1"
shift

remove=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --remove) remove=true ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

root=$(git rev-parse --show-toplevel)
repo=$(basename "$root")
wt_dir="${root}/../${repo}-worktrees/${branch}"

if [[ ! -d "$wt_dir" ]]; then
  echo "Worktree not found: $wt_dir" >&2
  exit 1
fi

cd "$root"

if ! git show-ref --verify --quiet "refs/heads/$branch"; then
  echo "Branch '$branch' not found" >&2
  exit 1
fi

original_branch=$(git rev-parse --abbrev-ref HEAD)
# Print the rebase state directory of worktree $1, if it is mid-rebase.
rebase_state() {
  local state state_dir
  for state in rebase-merge rebase-apply; do
    state_dir=$(git -C "$1" rev-parse --path-format=absolute --git-path "$state") || return 1
    [[ -d "$state_dir" ]] && printf '%s\n' "$state_dir"
  done
  return 0
}
rebase_in_progress() {
  [[ -n "$(rebase_state "$1")" ]]
}

# Git refuses to switch to a branch checked out in another worktree, so rebase
# it where it is checked out: normally its own worktree, from git-worktree-new.
# A worktree in the middle of rebasing the branch lists as detached; its rebase
# state still names the branch.
rebase_dir=$root
while IFS= read -r line; do
  case "$line" in
    "worktree "*) listed_dir=${line#worktree } ;;
    "branch refs/heads/$branch") rebase_dir=$listed_dir ;;
    detached)
      while IFS= read -r state_dir; do
        if [[ "$(<"$state_dir/head-name")" == "refs/heads/$branch" ]]; then
          rebase_dir=$listed_dir
        fi
      done < <(rebase_state "$listed_dir" 2>/dev/null)
      ;;
  esac
done < <(git worktree list --porcelain)

# --remove deletes wt_dir, so the branch must live there or in this checkout.
if [[ "$rebase_dir" != "$root" && "$(cd "$rebase_dir" && pwd -P)" != "$(cd "$wt_dir" && pwd -P)" ]]; then
  echo "Branch '$branch' is checked out at $rebase_dir, not $wt_dir" >&2
  exit 1
fi

interrupted=true
rebasing=false

cleanup() {
  if [[ "$interrupted" == true ]]; then
    echo "Error occurred, cleaning up..." >&2
    
    # Abort the rebase this command started, never one already in progress.
    if [[ "$rebasing" == true ]] && rebase_in_progress "$rebase_dir"; then
      git -C "$rebase_dir" rebase --abort 2>/dev/null || true
    fi
    
    # Return to original branch
    if [[ "$original_branch" != "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" ]]; then
      git checkout "$original_branch" 2>/dev/null || true
    fi
    
    echo "Aborted due to error" >&2
    exit 1
  fi
}
trap cleanup EXIT

# Pre-flight checks

if ! git diff-index --quiet HEAD --; then
  echo "Working tree has uncommitted changes. Commit or stash them first." >&2
  exit 1
fi

echo "Fetching latest origin/main..."
if ! git fetch origin main; then
  echo "Failed to fetch origin/main" >&2
  exit 1
fi

if ! git rev-parse --verify --quiet origin/main >/dev/null; then
  echo "origin/main does not exist" >&2
  exit 1
fi

# This command rebases in rebase_dir and checks out main here. Either move
# would strand a rebase already paused in that checkout.
for checkout in "$root" "$rebase_dir"; do
  if ! state_dirs=$(rebase_state "$checkout"); then
    echo "Could not inspect rebase state in $checkout" >&2
    exit 1
  fi
  if [[ -n "$state_dirs" ]]; then
    echo "A rebase is already in progress in $checkout" >&2
    exit 1
  fi
done

echo "Rebasing $branch onto origin/main..."
rebasing=true
# Autostash (on in this repo's git config) would rebase a dirty worktree and
# could leave its edits conflicted after the merge reports success.
if ! git -C "$rebase_dir" rebase --no-autostash origin/main "$branch"; then
  echo "Rebase failed. Aborting..." >&2
  exit 1
fi

echo "Checking out main..."
if ! git checkout main; then
  echo "Failed to checkout main" >&2
  exit 1
fi

echo "Fast-forward merging $branch..."
if ! git merge --ff-only "$branch"; then
  echo "Merge failed (not fast-forwardable - did main change during rebase?)" >&2
  exit 1
fi

# Success - clear error flag
interrupted=false
trap - EXIT

if [[ "$remove" == true ]]; then
  # Index flags can hide tracked edits from Git's removal guard.
  if ! indexed_files=$(git -C "$wt_dir" ls-files -v); then
    echo "Could not inspect index flags; keeping worktree: $wt_dir" >&2
    exit 1
  fi
  if grep -qE '^[a-zS] ' <<< "$indexed_files"; then
    echo "Keeping worktree with assume-unchanged or skip-worktree files: $wt_dir" >&2
    exit 1
  fi
  # Git's removal guard allows ignored files, which may still contain local work.
  if ! ignored_files=$(git -C "$wt_dir" ls-files --others --ignored --exclude-standard --directory); then
    echo "Could not inspect ignored files; keeping worktree: $wt_dir" >&2
    exit 1
  fi
  if [[ -n "$ignored_files" ]]; then
    echo "Keeping worktree with ignored files: $wt_dir" >&2
    exit 1
  fi
  echo "Removing worktree $branch..."
  # Preserve Git's refusal to remove local work or a locked worktree.
  git worktree remove "$wt_dir" || exit 1
  # Prune stale worktree references
  git worktree prune || exit 1
  git branch -d "$branch" || exit 1
  echo "Worktree and branch removed"
fi

echo "Merge complete: $branch -> main"
