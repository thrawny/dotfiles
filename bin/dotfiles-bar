#!/usr/bin/env bash
# Switch only this Hyprland session's bar; keep Waybar until Quickshell is ready.
set -euo pipefail
[[ "${SANDBOX:-}" != 1 ]] || { echo 'Run the desktop bar on the host.' >&2; exit 1; }
[[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || { echo 'Hyprland session required.' >&2; exit 1; }
shell_dir="${DOTFILES_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")/shell}"
mode="${1:-quickshell}"

start_waybar() {
  if ! pgrep -u "$(id -u)" -f '^[^ ]*waybar[^ ]* .*config-hyprland' >/dev/null; then
    hyprctl dispatch 'hl.dsp.exec_cmd("waybar -c " .. os.getenv("HOME") .. "/.config/waybar/config-hyprland -s " .. os.getenv("HOME") .. "/.config/waybar/style-hyprland.css")'
  fi
}

case "$mode" in
  quickshell)
    # --no-duplicate also recognizes the same config started by shell::dev.
    if ! quickshell -p "$shell_dir" --no-duplicate --daemonize; then
      start_waybar
      exit 1
    fi
    ready=false
    for ((attempt = 0; attempt < 25; attempt++)); do
      if [[ "$(timeout 1 quickshell ipc -p "$shell_dir" call shell ping 2>/dev/null || true)" == ready ]]; then
        ready=true
        break
      fi
      sleep 0.2
    done
    if [[ "$ready" != true ]]; then
      echo 'Quickshell did not become ready; keeping Waybar.' >&2
      quickshell kill -p "$shell_dir" || true
      start_waybar
      exit 1
    fi
    # Match the Hyprland bar only, never other users' or Niri's Waybar.
    pkill -u "$(id -u)" -f '^[^ ]*waybar[^ ]* .*config-hyprland' || true
    ;;
  waybar)
    start_waybar
    quickshell kill -p "$shell_dir" || true
    ;;
  *)
    echo 'Usage: dotfiles-bar [quickshell|waybar]' >&2
    exit 2
    ;;
esac
