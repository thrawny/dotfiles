#!/usr/bin/env bash
# Pick an open PR labelled ready-for-review and waiting on your team, and open
# it as a codediff review in that repo's Herdr workspace. The team, label and
# extra repos come from the private work config, read with work-config.
# Nothing is checked out: `:CodeReview pr` fetches refs/pull/N/head into a
# temporary ref, diffs it against the merge base, and deletes the ref again, so
# a repo already on a feature branch is left alone.
set -euo pipefail
[[ -z "${TRACE:-}" ]] || set -x

# fzf's bindings re-run this script, and a Herdr plugin popup does not get the
# interactive shell's PATH. Call this script and work-config by path.
self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")
work_config="$(dirname "$self")/work-config"

team=$("$work_config" github.review_team) || {
  echo "pr-review: set github.review_team (org/team) in $("$work_config" --path)" >&2
  exit 1
}
org=${team%%/*}
code_dir="${CODE_DIR:-$HOME/code}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pr-review"
# The team's repos change far less often than their PRs, and finding them
# takes a code search, which GitHub limits to a few calls a minute.
repos_cache="$cache_dir/repos.txt"
members_cache="$cache_dir/members.txt"
repos_ttl_minutes=1440
# The search costs about a second and a half, which is long enough to feel in a
# popup. Stale by a few minutes is fine for a review queue.
cache_ttl_minutes=5
herdr_bin="${HERDR_BIN_PATH:-herdr}"
jira_base=$("$work_config" jira.browse_url || true)
# Adding this label is what the team uses to say a PR is open for review, so an
# unlabelled PR is still being worked on and does not belong in the queue. The
# label is a per-team convention, not an org rule, so a repo that has never
# created it cannot use it; there every PR that asks for a review counts.
review_label=$("$work_config" github.review_label || echo ready-for-review)

# Repos where CODEOWNERS names the team but the team has no write access, so
# GitHub never adds it as a reviewer and the team search misses their PRs.
# Every PR in them that is ready for review joins the queue instead.
extra_repos=$("$work_config" github.extra_review_repos | tr '\n' ' ' || true)

# Bots open most of the PRs the team is asked to review, and none of them are
# what this picker is for. -b brings them back for a dependency sweep. GraphQL
# names a bot without the [bot] that REST adds, so match on the bare name.
bot_authors='dependabot renovate github-actions'

usage() {
  cat <<'USAGE'
Usage: pr-review [-r] [-b] [-a] [-c] [REPO] [NUMBER]

Pick a ready-for-review PR requesting review from your team (github.review_team
in the work config) and open it in codediff, in that repo's Herdr workspace.

  -r, --refresh   Ignore the cached PR list
      --json      Print the same PRs as JSON and exit, for a caller that reads
                  them rather than a person picking one
  -b, --bots      Include dependabot and other bot PRs
  -c, --skip-commented
                  Leave out PRs you have commented on. A plain comment does
                  not clear the team's review request the way a review does
  -a, --all       List every open PR in the team's repos, reviewed, labelled
                  or not, your own included. ctrl-a toggles it in the picker
  -j, --jira      Open the Jira ticket for REPO NUMBER instead of reviewing
  -w, --worktree  Check the PR branch out in a Herdr worktree, with Claude Code
                  and Neovim side by side, instead of reviewing
      --no-focus  Open the review in the background, leaving focus where it
                  is, for a caller such as a scheduled job
  -h, --help      Show this help

With REPO and NUMBER, skip the picker and open that PR directly.
USAGE
}

refresh=0
include_bots=0
skip_commented=0
all=0
print_rows=0
print_json=0
preview=0
jira=0
worktree=0
# A review the user opens should take focus; one a scheduled job opens should
# not pull them out of what they are doing.
focus=--focus
args=()
while (($#)); do
  case "$1" in
    -r | --refresh) refresh=1 ;;
    -b | --bots) include_bots=1 ;;
    -c | --skip-commented) skip_commented=1 ;;
    -a | --all) all=1 ;;
    -j | --jira) jira=1 ;;
    -w | --worktree) worktree=1 ;;
    --no-focus) focus=--no-focus ;;
    # fzf runs the preview as its own process, so it re-enters the script too.
    --preview) preview=1 ;;
    # fzf's reload bindings re-run this script for the list, so the row
    # building has to be reachable without the picker.
    --print-rows) print_rows=1 ;;
    --json) print_json=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *) args+=("$1") ;;
  esac
  shift
done

# Each list has its own cache, so toggling between them is instant.
if ((all)); then
  cache="$cache_dir/all.json"
else
  cache="$cache_dir/prs.json"
fi

die() {
  printf 'pr-review: %s\n' "$1" >&2
  exit 1
}

# fzf's execute-silent swallows output, so a failed keypress inside the picker
# has nowhere to report except a Herdr toast.
report() {
  printf 'pr-review: %s\n' "$1" >&2
  if "$herdr_bin" status >/dev/null 2>&1; then
    "$herdr_bin" notification show "$1" --sound none >/dev/null 2>&1 || true
  fi
}

# The worktree runs from the picker, which closes as soon as it exits, so a
# failure there needs the toast to be seen at all.
fail() {
  report "$1"
  exit 1
}

for tool in gh jq fzf; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done

# gh search prs cannot return a PR's review decision or check status, so both
# lists go through GraphQL. The PR fields are shared, and flatten turns them
# into the shape gh search prints.
pr_fields='number title isDraft updatedAt reviewDecision
  author { login }
  comments(last: 100) { nodes { viewerDidAuthor } }
  labels(first: 20) { nodes { name } }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }'
# shellcheck disable=SC2016 # jq, not shell
flatten='def flatten:
  . + { checks: .commits.nodes[0].commit.statusCheckRollup.state,
        commented: any(.comments.nodes[]?; .viewerDidAuthor) }
  | del(.commits, .labels, .comments);'

# The search also says whether the repo has the label, which sets ready for
# build_rows to filter on. The label filter runs here rather than in the
# query, since the query cannot tell a PR that is not ready from a repo
# without the label.
search_prs() {
  # shellcheck disable=SC2016 # $q and $label are GraphQL variables
  gh api graphql -f q="is:pr is:open -author:@me $1" -f label="$review_label" -f query='
    query($q: String!, $label: String!) {
      search(type: ISSUE, query: $q, first: 100) {
        nodes { ... on PullRequest {
          repository { name label(name: $label) { name } }
          latestReviews(first: 50) { nodes { author { login } } }
          '"$pr_fields"'
        } }
      }
    }' --jq "$flatten"' .data.search.nodes | map(
      . + { ready: (.repository.label == null
                    or (.repository.label.name as $l | any(.labels.nodes[]; .name == $l))),
            reviewers: [.latestReviews.nodes[].author.login] }
      | del(.repository.label, .latestReviews) | flatten)'
}

# The team's members change about as often as its repos.
team_members() {
  if ! cache_is_fresh "$members_cache" "$repos_ttl_minutes"; then
    local tmp
    tmp=$(mktemp "$members_cache.XXXXXX")
    gh api "orgs/$org/teams/${team#*/}/members" --paginate --jq '.[].login' >"$tmp" || {
      rm -f "$tmp"
      return 1
    }
    mv "$tmp" "$members_cache"
  fi
  jq -R . "$members_cache" | jq -s .
}

# A PR you opened yourself still requests the team, but it is not yours to
# review. A PR in an extra repo can match both searches, so keep one copy.
# Without extra repos the second search would cover all of GitHub.
# A review from anyone on the team clears the team's request, which is what
# takes a reviewed PR out of the first search. Extra repos have no request to
# clear, so a PR a teammate has reviewed there is left out by hand.
# Each search takes two or three seconds, so they run side by side.
review_prs() {
  local repo repo_query='' members='[]' dir team_pid extra_pid=''
  for repo in $extra_repos; do
    repo_query+=" repo:$org/$repo"
  done
  dir=$(mktemp -d "$cache_dir/review.XXXXXX")
  fetch_dir=$dir
  echo '[]' >"$dir/extra.json"
  search_prs "team-review-requested:$team" >"$dir/team.json" &
  team_pid=$!
  if [[ -n $repo_query ]]; then
    search_prs "$repo_query" >"$dir/extra.json" &
    extra_pid=$!
    members=$(team_members) || return 1
  fi
  wait "$team_pid" || return 1
  [[ -z $extra_pid ]] || wait "$extra_pid" || return 1
  jq --argjson members "$members" \
    'map(select(any(.reviewers[]; IN($members[])) | not))' "$dir/extra.json" |
    jq -s 'add | unique_by([.repository.name, .number])' "$dir/team.json" -
  rm -rf "$dir"
}

# The repos the team owns as a whole, where a CODEOWNERS line for * names it.
# The team's own repo list is no use here: it holds every repo the team can
# write to, and misses repos it owns without access. Code search finds those.
# A shared repo where the team owns a few paths is mostly other teams' PRs, so
# it stays out. Extra repos always count.
discover_repos() {
  local names name q='' i=0 tmp
  names=$(gh api -X GET search/code -f per_page=100 \
    -f q="\"@$team\" org:$org filename:CODEOWNERS" --jq '.items[].repository.name' | sort -u) ||
    die 'gh code search failed; check gh auth status'
  for name in $names; do
    q+=" r$i: repository(owner: \"$org\", name: \"$name\") { name isArchived"
    q+=' a: object(expression: "HEAD:.github/CODEOWNERS") { ... on Blob { text } }'
    q+=' b: object(expression: "HEAD:CODEOWNERS") { ... on Blob { text } }'
    q+=' c: object(expression: "HEAD:docs/CODEOWNERS") { ... on Blob { text } } }'
    i=$((i + 1))
  done
  local owned=''
  if [[ -n $q ]]; then
    owned=$(gh api graphql -f query="query {$q }" | jq -r --arg owner "@$team" '
      .data[] | select(.isArchived | not)
      | select([.a, .b, .c] | map(.text // "") | join("\n") | split("\n")
               | any(.[]; (startswith("* ") or startswith("*\t"))
                          and any(splits("\\s+"); . == $owner)))
      | .name') || die 'could not read CODEOWNERS; check gh auth status'
  fi
  tmp=$(mktemp "$repos_cache.XXXXXX")
  { printf '%s\n' "$owned"; tr ' ' '\n' <<<"$extra_repos"; } | sed '/^$/d' | sort -u >"$tmp"
  mv "$tmp" "$repos_cache"
}

# One query for every repo times GitHub out, so each repo gets its own, all at
# once. That takes about as long as the slowest repo, a second or two.
all_prs() {
  cache_is_fresh "$repos_cache" "$repos_ttl_minutes" || discover_repos
  local repo dir pid pids=() failed=0
  dir=$(mktemp -d "$cache_dir/all.XXXXXX")
  fetch_dir=$dir
  while IFS= read -r repo; do
    # shellcheck disable=SC2016 # $owner and $name are GraphQL variables
    gh api graphql -f owner="$org" -f name="$repo" -f query='
      query($owner: String!, $name: String!) {
        repository(owner: $owner, name: $name) {
          pullRequests(states: OPEN, first: 50, orderBy: {field: UPDATED_AT, direction: DESC}) {
            nodes { repository { name } '"$pr_fields"' }
          }
        }
      }' --jq '.data.repository.pullRequests.nodes' >"$dir/$repo.json" &
    pids+=("$!")
  done <"$repos_cache"
  for pid in "${pids[@]}"; do
    wait "$pid" || failed=1
  done
  if ((failed)); then
    rm -rf "$dir"
    return 1
  fi
  if ((${#pids[@]})); then
    jq -s "$flatten"' add | map(flatten)' "$dir"/*.json
  else
    echo '[]'
  fi
  rm -rf "$dir"
}

fetch_prs() {
  mkdir -p "$cache_dir"
  fetch_tmp=$(mktemp "$cache.XXXXXX")
  fetch_dir=''
  # Closing the popup mid-fetch would otherwise leave the temp files behind.
  trap 'rm -rf "$fetch_tmp" "$fetch_dir"' EXIT
  trap 'exit 1' HUP INT TERM
  if ((all)); then
    all_prs >"$fetch_tmp" || die 'gh query failed; check gh auth status'
  else
    review_prs >"$fetch_tmp" || die 'gh search failed; check gh auth status'
  fi
  mv "$fetch_tmp" "$cache"
  trap - EXIT HUP INT TERM
}

# Takes the file and its TTL in minutes.
cache_is_fresh() {
  [[ -s $1 ]] || return 1
  [[ -z $(find "$1" -mmin "+$2" -print 2>/dev/null) ]]
}

open_url() {
  if command -v open >/dev/null; then
    open "$1"
  else
    xdg-open "$1"
  fi
}

# Team convention puts the ticket in the PR title, as in feat(ABC-123): ...
# Bots and small changes have no ticket, and the branch name is the next best
# place to look before giving up.
# No ticket is an ordinary answer here, not a failure, so the empty grep does
# not take the script down with it.
ticket_in() {
  grep -oE '[A-Z][A-Z0-9]+-[0-9]+' <<<"$1" | head -1 || true
}

open_jira() {
  local repo=$1 number=$2 ticket
  [[ $number =~ ^[0-9]+$ ]] || die "not a PR number: $number"
  ticket=$(ticket_in "$(gh pr view --repo "$org/$repo" "$number" --json title --jq .title)")
  if [[ -z $ticket ]]; then
    ticket=$(ticket_in "$(gh pr view --repo "$org/$repo" "$number" --json headRefName --jq .headRefName)")
  fi
  if [[ -z $ticket ]]; then
    report "No Jira ticket in $repo#$number"
    exit 1
  fi
  if [[ -z $jira_base ]]; then
    report "No Jira site: log in with jira-cli or set jira.browse_url"
    exit 1
  fi
  open_url "$jira_base/$ticket"
}

# gh prints the PR's fields as key:value lines, then `--`, then the markdown
# body. The fields read as YAML, so highlight them that way and leave the body
# to the markdown lexer. bat is optional; without it the preview is plain.
show_preview() {
  local repo=$1 number=$2 text head_text body_text
  text=$(gh pr view --repo "$org/$repo" "$number" 2>&1) || {
    printf '%s\n' "$text"
    return 0
  }
  if ! command -v bat >/dev/null; then
    printf '%s\n' "$text"
    return 0
  fi
  # Tabs after the field names would read as indentation to the YAML lexer.
  head_text=$(sed -n '1,/^--$/p' <<<"$text" | sed '/^--$/d; s/:\t/: /')
  body_text=$(sed -n '/^--$/,$p' <<<"$text" | sed '1d')
  bat --color=always --style=plain --language=yaml <<<"$head_text"
  if [[ -n $body_text ]]; then
    printf '\n'
    bat --color=always --style=plain --language=markdown <<<"$body_text"
  fi
}

ensure_clone() {
  local repo=$1 dir=$2
  if [[ ! -d $dir ]]; then
    # stderr, since after fzf's become() stdout is the picker's selection.
    printf 'Cloning %s/%s…\n' "$org" "$repo" >&2
    gh repo clone "$org/$repo" "$dir" >/dev/null || die "could not clone $org/$repo"
  fi
}

open_review() {
  local repo=$1 number=$2
  [[ $number =~ ^[0-9]+$ ]] || die "not a PR number: $number"
  local dir="$code_dir/$repo"
  ensure_clone "$repo" "$dir"

  # Outside Herdr there is no workspace to open, so review in place.
  if ! "$herdr_bin" status >/dev/null 2>&1; then
    cd "$dir"
    exec nvim "+CodeReview pr $number"
  fi

  local workspace pane
  workspace=$(find_workspace "$dir")
  if [[ -n $workspace ]]; then
    # A repo's workspace usually has work in progress in it, so a review gets
    # its own tab rather than taking over a pane.
    [[ $focus == --focus ]] && "$herdr_bin" workspace focus "$workspace" >/dev/null
    pane=$("$herdr_bin" tab create --workspace "$workspace" --cwd "$dir" \
      --label "$repo#$number" "$focus" | jq -r '.result.root_pane.pane_id')
  else
    pane=$("$herdr_bin" workspace create --cwd "$dir" --label "$repo" "$focus" |
      jq -r '.result.root_pane.pane_id')
  fi
  [[ -n $pane && $pane != null ]] || die 'Herdr did not report a pane to run in'

  # The shell in a fresh pane may not have drawn its prompt yet. Typed-ahead
  # input survives that, but a moment's grace keeps the command off the banner.
  sleep 0.3
  "$herdr_bin" pane run "$pane" "nvim '+CodeReview pr $number'" >/dev/null
}

# Check the PR's branch out in a Herdr worktree workspace, grouped under the
# repo's own, with Claude Code on the left and Neovim on the right. Unlike
# open_review this leaves a real branch behind, so the review can run tests or
# push a fix. Herdr puts the checkout under ~/.herdr/worktrees/<repo>/<branch>.
open_worktree() {
  local repo=$1 number=$2
  [[ $number =~ ^[0-9]+$ ]] || fail "not a PR number: $number"
  local dir="$code_dir/$repo"
  ensure_clone "$repo" "$dir"
  "$herdr_bin" status >/dev/null 2>&1 || fail 'a worktree review needs Herdr'

  local pr branch
  pr=$(gh pr view --repo "$org/$repo" "$number" --json headRefName,isCrossRepository) ||
    fail "could not read $repo#$number"
  # A fork's branch is not on origin, and its name can clash with one that is.
  if [[ $(jq -r .isCrossRepository <<<"$pr") == true ]]; then
    branch="pr-$number"
  else
    branch=$(jq -r .headRefName <<<"$pr")
  fi

  local sha
  if [[ $branch == "pr-$number" ]]; then
    git -C "$dir" fetch --quiet origin "pull/$number/head" || fail "could not fetch $repo#$number"
    sha=$(git -C "$dir" rev-parse FETCH_HEAD)
  else
    git -C "$dir" fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" ||
      fail "could not fetch $branch"
    sha=$(git -C "$dir" rev-parse "origin/$branch")
  fi

  # A checkout already on the branch may hold unpushed work, so only
  # fast-forward it to the PR, and leave it be when that is not possible.
  local existing
  existing=$("$herdr_bin" worktree list --cwd "$dir" |
    jq -c --arg b "$branch" '.result.worktrees[] | select(.branch == $b)' | head -1)
  if [[ -n $existing ]]; then
    local open_ws checkout
    checkout=$(jq -r .path <<<"$existing")
    git -C "$checkout" merge --quiet --ff-only "$sha" >/dev/null 2>&1 ||
      report "$branch could not fast-forward to the PR; opening it as it is"
    open_ws=$(jq -r '.open_workspace_id // empty' <<<"$existing")
    if [[ -n $open_ws ]]; then
      [[ $focus == --focus ]] && "$herdr_bin" workspace focus "$open_ws" >/dev/null
      return 0
    fi
    split_claude_nvim "$("$herdr_bin" worktree open --cwd "$dir" \
      --path "$checkout" --label "$repo#$number" "$focus")" "$number" "$repo" "$branch"
    return 0
  fi

  if ! git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$dir" branch --quiet "$branch" "$sha"
    [[ $branch == "pr-$number" ]] ||
      git -C "$dir" branch --quiet --set-upstream-to "origin/$branch" "$branch"
  elif git -C "$dir" merge-base --is-ancestor "$branch" "$sha"; then
    git -C "$dir" update-ref "refs/heads/$branch" "$sha"
  else
    # Local commits the PR does not have. Keep them and say so.
    report "$branch has local commits not on the PR; opening it as it is"
  fi

  split_claude_nvim "$("$herdr_bin" worktree create --cwd "$dir" --branch "$branch" \
    --label "$repo#$number" "$focus")" "$number" "$repo" "$branch"
}

# Start the review agent through moto when moto is installed, so the session is
# a task the driver can see, report to and clean up. Without moto, or when the
# spawn fails, the pane still gets a plain Claude: a review the driver cannot
# track beats no review.
start_review_agent() {
  local pane=$1 number=$2 repo=$3 branch=$4 title word='[a-z0-9][a-z0-9-]*'
  if ! command -v moto >/dev/null 2>&1; then
    "$herdr_bin" pane run "$pane" claude >/dev/null
    return 0
  fi
  title="review $repo $number"
  # moto titles are one to three lowercase words; an odd repo name falls back.
  [[ $title =~ ^$word\ $word\ $word$ ]] || title="pr review $number"
  if moto spawn --json --repo "$repo" --worktree "$branch" --pane "$pane" \
    --title "$title" >/dev/null <<BRIEF
Review pull request $org/$repo#$number. Its branch is checked out in this
worktree, and Neovim is open on the diff in the pane beside you.

Run the \`tono\` skill on the PR and report what it finds. Post nothing to
GitHub: the user reads the findings here and decides what to say on the PR.

Report done once the review is written, then wait for the user in this pane.
BRIEF
  then
    return 0
  fi
  report 'moto could not take this review, so it runs as an untracked session'
  "$herdr_bin" pane run "$pane" claude >/dev/null
}

# Takes the JSON Herdr prints for a new worktree workspace, and the PR number
# for Neovim to open the review on.
split_claude_nvim() {
  local number=$2 repo=$3 branch=$4 left right checkout
  left=$(jq -r '.result.root_pane.pane_id // empty' <<<"$1")
  checkout=$(jq -r '.result.worktree.path // empty' <<<"$1")
  [[ -n $left && -n $checkout ]] || fail 'Herdr did not report a pane to run in'
  right=$("$herdr_bin" pane split "$left" --direction right --cwd "$checkout" --no-focus |
    jq -r '.result.pane.pane_id')
  # Same grace as open_review, for the prompts of two fresh shells.
  sleep 0.3
  "$herdr_bin" pane run "$right" "nvim '+CodeReview pr $number'" >/dev/null
  start_review_agent "$left" "$number" "$repo" "$branch"
}

# Workspaces have no cwd of their own, so match on the saved cwd of their panes.
# foreground_cwd moves as programs navigate and would match the wrong workspace.
#
# One matching pane is not enough. A shell that cd'd into another repo, or a
# review tab opened here for it, leaves a pane pointing at a repo the workspace
# is not about, and matching on that lands the next review in the wrong place.
# So a workspace has to carry the repo's name, or hold the repo in most of its
# panes, before it counts.
find_workspace() {
  local dir=$1 name workspace label pane_cwd total matched best='' best_matched=0
  name=$(basename "$dir")
  while IFS=$'\t' read -r workspace label; do
    total=0
    matched=0
    while IFS= read -r pane_cwd; do
      total=$((total + 1))
      [[ -d $pane_cwd ]] || continue
      if [[ "$(cd "$pane_cwd" && pwd -P)" == "$dir" ]]; then
        matched=$((matched + 1))
      fi
    done < <("$herdr_bin" pane list --workspace "$workspace" |
      jq -r '.result.panes[] | .cwd // empty')
    if [[ $label == "$name" ]] && ((matched > 0)); then
      printf '%s\n' "$workspace"
      return 0
    fi
    if ((matched * 2 > total && matched > best_matched)); then
      best=$workspace
      best_matched=$matched
    fi
  done < <("$herdr_bin" workspace list |
    jq -r '.result.workspaces[] | [.workspace_id, (.label // "")] | @tsv')
  [[ -z $best ]] || printf '%s\n' "$best"
  return 0
}

if ((${#args[@]} == 2)); then
  if ((preview)); then
    show_preview "${args[0]#*/}" "${args[1]}"
  elif ((jira)); then
    open_jira "${args[0]#*/}" "${args[1]}"
  elif ((worktree)); then
    open_worktree "${args[0]#*/}" "${args[1]}"
  else
    open_review "${args[0]#*/}" "${args[1]}"
  fi
  exit 0
elif ((${#args[@]} != 0)); then
  usage >&2
  exit 2
fi

# An out-of-date list opens at once and refreshes in the background, since
# fetching takes a few seconds. The refresh waits for fzf to load the old rows,
# then reload-sync keeps them on screen until the new ones are in; unbinding
# load stops the refresh from setting itself off again. fzf's reload asks for
# rows, so it waits.
stale=0
if ((refresh)); then
  fetch_prs
elif ! cache_is_fresh "$cache" "$cache_ttl_minutes"; then
  if ((print_rows)) || ((print_json)) || [[ ! -s $cache ]]; then
    fetch_prs
  else
    stale=1
  fi
fi

# The PRs build_rows shows, as JSON rather than a table of icons and colors.
# A scheduled job hands these to an agent, which needs the fields, not columns.
build_json() {
  jq --arg bots "$bot_authors" --arg org "$org" --argjson include_bots "$include_bots" \
    --argjson all "$all" --argjson skip_commented "$skip_commented" '
  ($bots | split(" ")) as $bots
  | map(select($all == 1 or .ready != false))
  | map(select($include_bots == 1 or (.author.login | sub("\\[bot\\]$"; "") | IN($bots[]) | not)))
  | map(select($skip_commented == 0 or .commented != true))
  | sort_by(.updatedAt) | reverse
  | map({ repo: .repository.name,
          number,
          title,
          author: .author.login,
          updatedAt,
          isDraft,
          ready,
          reviewDecision,
          checks,
          url: "https://github.com/\($org)/\(.repository.name)/pull/\(.number)" })
' "$cache"
}

build_rows() {
  jq -r --arg bots "$bot_authors" --argjson include_bots "$include_bots" \
    --argjson all "$all" --argjson skip_commented "$skip_commented" '
  # column counts bytes, so the rows line up only while every icon takes the
  # same number of bytes and every color code the same number of digits. An
  # old cache without the fields shows "–", and holds only labelled PRs, so a
  # missing ready counts as ready. The all list shows every PR, ready or not.
  # A missing commented counts as not commented, until the next refresh.
  def paint: "\u001b[\(.[0])m\(.[1])\u001b[0m";
  ($bots | split(" ")) as $bots
  | map(select($all == 1 or .ready != false))
  | map(select($include_bots == 1 or (.author.login | sub("\\[bot\\]$"; "") | IN($bots[]) | not)))
  | map(select($skip_commented == 0 or .commented != true))
  | sort_by(.updatedAt) | reverse
  | .[]
  | [ .repository.name,
      (.number | tostring),
      ({ APPROVED: ["32", "✓"],
         CHANGES_REQUESTED: ["31", "✗"],
         REVIEW_REQUIRED: ["33", "○"] }[.reviewDecision // ""]
        // ["90", "–"] | paint),
      ({ SUCCESS: ["32", "✓"],
         FAILURE: ["31", "✗"],
         ERROR: ["31", "✗"],
         PENDING: ["33", "●"],
         EXPECTED: ["33", "●"] }[.checks // ""]
        // ["90", "–"] | paint),
      (.updatedAt | fromdateiso8601 | strflocaltime("%Y-%m-%d %H:%M")),
      .author.login,
      ((if .isDraft then "[draft] " else "" end) + .title)
    ] | @tsv
' "$cache" | column -t -s $'\t'
}

rows=$(build_rows)
# An empty old list would close the picker before the refresh could land.
if [[ -z $rows ]] && ((stale)); then
  fetch_prs
  stale=0
  rows=$(build_rows)
fi

if ((print_json)); then
  build_json
  exit 0
fi

if ((print_rows)); then
  printf '%s\n' "$rows"
  exit 0
fi

if [[ -z $rows ]]; then
  if ((all)); then
    echo "No open PRs in $team's repos."
  else
    echo "No $review_label PRs waiting on $team."
  fi
  # In a popup the message would vanish with the pane before it could be read.
  [[ -t 0 ]] && read -r -n 1 -s -p 'Press any key to close… '
  exit 0
fi

# The picker's reloads re-run this script, so they pass the same filters on.
flags_suffix=''
((include_bots)) && flags_suffix=' --bots'
((skip_commented)) && flags_suffix+=' --skip-commented'
prompt='review> '
all_suffix=''
if ((all)); then
  prompt='all> '
  all_suffix=' --all'
fi
start=()
((stale)) && start=(--bind="load:unbind(load)+reload-sync($self --print-rows --refresh$all_suffix$flags_suffix)")

# The prompt is the only state the picker keeps, so the toggle and the refresh
# read the current list off it.
toggle="[[ \$FZF_PROMPT == 'all> ' ]] &&
  echo 'change-prompt(review> )+reload($self --print-rows$flags_suffix)' ||
  echo 'change-prompt(all> )+reload($self --print-rows --all$flags_suffix)'"
refresh_list="[[ \$FZF_PROMPT == 'all> ' ]] &&
  echo 'reload($self --print-rows --refresh --all$flags_suffix)' ||
  echo 'reload($self --print-rows --refresh$flags_suffix)'"

# ctrl-j and ctrl-k move through the list, so the Jira ticket goes on ctrl-t.
# ctrl-w gives up fzf's delete-word for the worktree; become() replaces fzf so
# the popup closes when the worktree is open, as it does after enter.
selection=$(fzf --prompt="$prompt" --height=100% --ansi \
  --header='enter review · ctrl-w worktree · ctrl-a all · ctrl-r refresh · ctrl-o github · ctrl-t jira' \
  --bind="ctrl-a:transform:$toggle" "${start[@]}" \
  --bind="ctrl-w:become($self --worktree {1} {2})" \
  --preview="$self --preview {1} {2}" --preview-window=right,55%,wrap \
  --bind="ctrl-r:transform:$refresh_list" \
  --bind="ctrl-o:execute-silent(gh pr view --repo $org/{1} {2} --web)" \
  --bind="ctrl-t:execute-silent($self --jira {1} {2})" \
  <<<"$rows") || exit 0

[[ -n $selection ]] || exit 0
read -r repo number _ <<<"$selection"
open_review "$repo" "$number"
