#!/usr/bin/env bash
# Prototype: settle the focused agent thread — work is done, keep the
# thread around but out of sight. Marks the window "settled" (nirius
# mark) and parks it in the scratchpad. Settled threads are hidden from
# the default thread-summon picker view; summoning one un-settles it.

[[ "${TRACE:-}" ]] && set -x
set -euo pipefail

focused_id=$(niri msg --json focused-window | jq -r '.id // empty')
[[ -z "$focused_id" ]] && exit 0

if ! nirius list-marked settled 2>/dev/null | sed -n 's/^id: \([0-9]*\),.*/\1/p' | grep -qx "$focused_id"; then
  nirius toggle-mark settled --id "$focused_id"
fi

if ! nirius list-scratchpad 2>/dev/null | sed -n 's/^id: \([0-9]*\),.*/\1/p' | grep -qx "$focused_id"; then
  nirius scratchpad-toggle
fi
