#!/usr/bin/env bash
# Waybar custom module: the live sidebar prototype's highest-priority count.
# Priority: unread Done > Working > open Idle. Settled/archived threads are excluded.
set -euo pipefail

state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
status_file="$state_home/agent-switch/sidebar-proto-waybar.json"

unavailable() {
  printf '%s\n' '{"text":"","tooltip":"sidebar status unavailable","class":"unavailable"}'
}

if [[ ! -r $status_file ]]; then
  unavailable
  exit 0
fi

# The persistent sidebar refreshes this snapshot every two seconds even while
# hidden. Do not leave stale state in Waybar if that process stops.
now=$(date +%s)
modified=$(stat -c %Y "$status_file" 2>/dev/null || printf '0')
if ((now - modified > 10)); then
  unavailable
  exit 0
fi

if ! jq -ce '{text, tooltip, class}' "$status_file" 2>/dev/null; then
  unavailable
fi
