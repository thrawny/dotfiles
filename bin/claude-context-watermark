#!/usr/bin/env bash
# PostToolUse hook: manage Claude's session-scoped auto-handoff.
#
# A claude-handoff-promote tool call copies this session's existing auto-handoff
# into the current worktree for the manual /handoff flow. All other tool calls
# estimate current context occupancy from the last assistant usage block in the
# transcript and inject an additionalContext warning at each configured
# checkpoint so the model writes and then refreshes an auto-handoff shortly
# before auto-compact. The companion SessionStart hook
# (claude-handoff-takeoff) injects that file back after compaction.
#
# Env:
#   CLAUDE_CODE_AUTO_COMPACT_WINDOW   token window to measure against (default 300000)
#   CLAUDE_CONTEXT_WATERMARK_PCTS     space/comma-separated checkpoints (default "85 88")
set -uo pipefail

emit_context() {
  jq -n --arg ctx "$1" \
    '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $ctx}}'
}

promote_handoff() {
  local input=$1 session cwd handoff_dir source git_root destination

  session=$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null) || return 0
  cwd=$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null) || return 0
  [[ -n "$session" && "$session" != */* && -d "$cwd" ]] || {
    emit_context "Auto-handoff promotion failed because the hook received no valid session or working directory. Continue the /handoff flow by writing a fresh handoff.md."
    return 0
  }

  git_root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || {
    emit_context "No Git worktree was found for the manual handoff. Stop and tell the user; do not write handoff.md outside a worktree."
    return 0
  }

  handoff_dir=${XDG_STATE_HOME:-$HOME/.local/state}/claude/handoffs
  source=$handoff_dir/$session.md
  destination=$git_root/handoff.md
  if [[ ! -s "$source" ]]; then
    emit_context "No auto-handoff exists for this session. Continue the /handoff flow by extracting a fresh handoff from the current conversation, using the user's supplied goal if present."
    return 0
  fi

  cp -f -- "$source" "$destination" 2>/dev/null || {
    emit_context "The session auto-handoff exists but could not be copied to ${destination}. Stop and report the error; do not silently regenerate it."
    return 0
  }

  emit_context "Promoted this session's existing auto-handoff to ${destination}. Treat it as the draft for the manual /handoff: apply the user's supplied goal as authoritative, reconcile only meaningful changes since the snapshot (including files, tests, and live state), then stop. Do not regenerate the handoff from scratch."
}

main() {
  local input tool_name tool_command transcript session usage window pct
  local thresholds threshold trigger_pct state_dir state_file last_threshold handoff_dir

  input=$(cat) || return 0
  tool_name=$(jq -r '.tool_name // empty' <<<"$input" 2>/dev/null) || return 0
  tool_command=$(jq -r '.tool_input.command // empty' <<<"$input" 2>/dev/null) || return 0
  if [[ "$tool_name" == "Bash" && "$tool_command" == "claude-handoff-promote" ]]; then
    promote_handoff "$input"
    return 0
  fi

  transcript=$(jq -r '.transcript_path // empty' <<<"$input" 2>/dev/null) || return 0
  session=$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null) || return 0
  [[ -f "$transcript" && -n "$session" && "$session" != */* ]] || return 0

  # The last assistant message's usage block reflects the input size of the
  # most recent API call, i.e. current context occupancy. Zero-usage blocks
  # (compact boundaries, synthetic entries) are skipped.
  usage=$(
    tail -n 500 "$transcript" 2>/dev/null | jq -rs '
      [ .[]
        | select(.type == "assistant")
        | .message.usage
        | select(. != null and .input_tokens != null)
        | (.input_tokens
           + (.cache_read_input_tokens // 0)
           + (.cache_creation_input_tokens // 0)
           + (.output_tokens // 0))
        | select(. > 0)
      ]
      | last // empty
    ' 2>/dev/null
  ) || return 0
  [[ "$usage" =~ ^[0-9]+$ ]] || return 0

  window=${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-300000}
  [[ "$window" =~ ^[1-9][0-9]*$ ]] || return 0
  pct=$((usage * 100 / window))

  # Warn at exact checkpoints rather than broad 10% bands. Claude reserves
  # headroom and can compact before 90%, so the defaults create at 85% and
  # refresh at 88%. If usage drops after compaction, reset for the next climb.
  thresholds=${CLAUDE_CONTEXT_WATERMARK_PCTS:-"85 88"}
  thresholds=${thresholds//,/ }

  state_dir=${TMPDIR:-/tmp}/claude-context-watermark
  mkdir -p "$state_dir" 2>/dev/null || return 0
  state_file=$state_dir/$session
  last_threshold=$(cat "$state_file" 2>/dev/null) || last_threshold=0
  [[ "$last_threshold" =~ ^[0-9]+$ ]] || last_threshold=0
  if ((pct + 20 < last_threshold)); then
    echo 0 >"$state_file" 2>/dev/null
    return 0
  fi

  trigger_pct=0
  for threshold in $thresholds; do
    [[ "$threshold" =~ ^[0-9]+$ ]] || continue
    ((threshold > 0 && threshold < 100)) || continue
    if ((pct >= threshold && threshold > last_threshold && threshold > trigger_pct)); then
      trigger_pct=$threshold
    fi
  done
  ((trigger_pct > 0)) || return 0
  echo "$trigger_pct" >"$state_file" 2>/dev/null

  handoff_dir=${XDG_STATE_HOME:-$HOME/.local/state}/claude/handoffs
  emit_context "Context usage is at ~${pct}% of the ${window}-token auto-compact window (crossed the ${trigger_pct}% handoff checkpoint). Write a session auto-handoff to ${handoff_dir}/${session}.md now (create the directory if needed), then continue the task. Use these headings: Next goal; Context (decisions and why); Files; Skills; Live state (dev servers, background agents, acpx sessions deliberately left running); Immediate action. Include test/gate results and unresolved errors where relevant. Keep it under ~1000 tokens. This is separate from the manual handoff flow — do not touch any handoff.md in the repo."
}

main
exit 0
