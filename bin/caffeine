#!/usr/bin/env bash
# Toggle or query systemd idle inhibition for use as a waybar custom module.
# Uses systemd-inhibit which hypridle respects (unlike the Wayland idle-inhibit
# protocol which niri drops when the surface is occluded).

PIDFILE="${XDG_RUNTIME_DIR}/caffeine.pid"

# Print the inhibitor's PID if it is still running. The PID file outlives an
# inhibitor that exits on its own, and its PID can be reused by an unrelated
# process, so check the process is still our systemd-inhibit before trusting
# or signalling it.
inhibitor_pid() {
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  tr '\0' '\n' 2>/dev/null <"/proc/$pid/cmdline" | grep -qx -- '--who=caffeine' || return 1
  echo "$pid"
}

case "${1:-status}" in
  toggle)
    if pid=$(inhibitor_pid); then
      kill "$pid"
      rm -f "$PIDFILE"
    else
      systemd-inhibit --what=idle --who=caffeine --why="User requested" sleep infinity &
      echo $! > "$PIDFILE"
    fi
    pkill -RTMIN+8 waybar
    ;;
  status)
    if inhibitor_pid >/dev/null; then
      echo '{"text":"󰅶","tooltip":"Caffeine: ON","class":"activated"}'
    else
      echo '{"text":"󰛊","tooltip":"Caffeine: OFF","class":"deactivated"}'
    fi
    ;;
esac
