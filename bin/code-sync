#!/usr/bin/env bash
# Reconcile gita's repo list with the git checkouts under ~/code, then
# fast-forward the default branch of each one.
#
# gita tracks a fixed list of repos in ~/.config/gita/repos.csv and never
# rescans on its own, so a freshly cloned repo is invisible to it and a deleted
# one lingers as a dead row. Running that reconciliation first, every time, is
# the only reason this wrapper exists instead of a bare `gita pull -a` alias.
#
# Checkouts with no remote are left out of the list: there is nothing to
# fast-forward them from, and gita skips them in `gita freeze` anyway. So are
# linked worktrees: their main checkout updates the branches they share. So is
# every checkout named in the ignore file, ~/.config/code-sync/ignore: one
# directory name per line, # starts a comment. That is for a repo whose local
# default branch is meant to stay where it is, such as a prototype with commits
# that will never reach origin.
#
# Only the default branch is ever updated, and only by fast-forward. A repo
# sitting on a feature branch keeps that branch checked out and its worktree
# untouched; the fetch moves the local default branch behind its back. The one
# exception is a branch whose PR has merged: the repo switches to the freshly
# updated default branch and the merged branch is deleted, as long as the tree
# is clean and the branch holds nothing the PR did not. Linked worktrees get the
# same treatment: one whose branch's PR has merged is removed along with the
# branch, under the same conditions. Nothing here rewrites history or touches a
# dirty tree. A branch moto has snoozed always stays, merged or not: its task
# comes back on it.
#
# With --park, a main checkout left idle on some other branch switches back to
# the freshly updated default branch. The branch stays as it is, unpushed
# commits included: parking is a plain `git switch` and nothing more. A checkout
# stays where it is when its tree is dirty, when an agent in Herdr has its cwd
# there, when a moto task uses it, or when its HEAD moved in the last day. A
# plain shell pane sitting in a checkout does not count as work on it.
#
# The updates are plain git rather than `gita pull`, because gita pull only
# knows how to pull the checked-out branch. `gita` is still what holds the repo
# list and prints the status table.
set -euo pipefail

code_dir=${CODE_DIR:-"$HOME/code"}
# Same precedence gita uses (gita/common.py).
repos_csv=${GITA_PROJECT_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/gita/repos.csv
ignore_file=${XDG_CONFIG_HOME:-$HOME/.config}/code-sync/ignore

usage() {
  cat <<'EOF'
Usage: code-sync [-n] [-s] [-p]

Sync gita's repo list with the git checkouts under $CODE_DIR (default ~/code),
then fast-forward each one's default branch. Checkouts with no remote are left
out, and so are linked worktrees and repos outside $CODE_DIR.

To leave a checkout alone entirely, put its directory name on a line of its
own in ~/.config/code-sync/ignore ($XDG_CONFIG_HOME is honoured). Lines
starting with # are comments. Ignored checkouts drop out of gita's list too.

A repo on some other branch stays on it: only its local default branch moves.
If that branch's PR has merged, the repo switches to the default branch and
deletes the merged one, unless the tree is dirty or the branch has commits the
PR did not. Linked worktrees on a merged PR's branch are removed, with the
same conditions, unless Herdr has them open or they live under $CODE_DIR.
Branches of tasks snoozed with `moto snooze` are always kept.

With -p, a checkout that is idle on some other branch switches to its default
branch, keeping the branch and its commits. It stays put when the tree has
changes or untracked files, an agent pane in Herdr is in it, a moto task uses
it, or its HEAD moved in the last 24 hours.

  -n  Print what would change and what would be updated, change nothing.
      With -p, also print which checkouts would be parked and which stay.
  -p, --park
      Switch idle checkouts on other branches to their default branch.
  -s  Print the status table (gita ll) when finished.
  -h  This message.
EOF
}

# How many repos to fetch at once. Sequential fetches over ssh dominate the
# runtime of a ~45 repo sweep; beyond a handful in parallel the remote, not the
# local machine, is the limit.
jobs_max=8

# Name of the branch this repo considers its default. origin/HEAD is what
# `git clone` records, but it goes stale after an upstream rename until someone
# runs `git remote set-head`, so fall back to the two names that are ever used.
default_branch() {
  local repo=$1 head_ref candidate
  if head_ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
    printf '%s\n' "${head_ref#origin/}"
    return 0
  fi
  for candidate in main master; do
    if git -C "$repo" show-ref --quiet --verify "refs/remotes/origin/$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# How long a checkout's HEAD has to sit still before --park may move it.
park_idle_seconds=$((24 * 60 * 60))

# The branches of snoozed moto tasks, one "repo<TAB>branch" line each. moto wake
# checks such a branch out again, so it must outlive even a merged PR.
moto_tasks=${XDG_STATE_HOME:-$HOME/.local/state}/moto/tasks.json
snoozed_branches=''
if [[ -f $moto_tasks ]]; then
  if ! snoozed_branches=$(jq -r '.tasks[]? | select(.snoozed)
      | [.snoozed.repo // .repo, .snoozed.branch // .branch]
      | select(.[1] != null) | @tsv' "$moto_tasks"); then
    printf 'code-sync: cannot read the snoozed branches in %s\n' "$moto_tasks" >&2
    exit 1
  fi
fi

snoozed() {
  local repo=$1 branch=$2
  printf '%s\n' "$snoozed_branches" | grep -Fxq -- "$repo"$'\t'"$branch"
}

have_gh=false
if command -v gh >/dev/null 2>&1; then
  have_gh=true
fi

# The one line of a git failure worth reporting. git leads with several hint:
# lines about how to recover, so the first line of the output is usually not the
# line that says what went wrong.
error_line() {
  local log=$1 line
  # A rejected refspec says `! [rejected] main -> main (non-fast-forward)`,
  # which is git's wording for a local default branch that has its own commits.
  # Say that instead, because the refspec is this script's, not the reader's.
  if [[ $log == *'(non-fast-forward)'* ]]; then
    printf 'local branch has diverged from origin\n'
    return
  fi
  while IFS= read -r line; do
    case $line in
      *fatal:* | *error:*)
        printf '%s\n' "${line#"${line%%[![:space:]]*}"}"
        return
        ;;
    esac
  done <<<"$log"
  printf '%s\n' "${log%%$'\n'*}"
}

# Where the checked-out branch stands against the default branch, for a repo
# that is not on its default branch. Answers one question: is there anything on
# this branch that the default branch does not already have.
branch_report() {
  local repo=$1 default=$2 branch=$3 counts behind ahead
  if [[ $branch == '-' ]]; then
    printf 'detached HEAD\n'
    return
  fi
  if ! counts=$(git -C "$repo" rev-list --left-right --count \
    "refs/remotes/origin/$default...HEAD" 2>/dev/null); then
    printf 'cannot compare with %s\n' "$default"
    return
  fi
  behind=${counts%%[[:space:]]*}
  ahead=${counts##*[[:space:]]}
  if ((ahead == 0)); then
    printf 'merged into %s, branch can go\n' "$default"
    return
  fi
  if ((behind > 0)); then
    printf '%s ahead, %s behind %s\n' "$ahead" "$behind" "$default"
  else
    printf '%s ahead of %s\n' "$ahead" "$default"
  fi
}

# The merged PR whose head is this branch, as "number head_oid". Fails when
# there is none, or when gh is missing or cannot answer.
#
# The PR state is the only reliable signal. A squash merge rewrites the commits,
# so the branch stays ahead of the default branch forever and ancestry never
# sees that the work landed. Branches without a PR are never touched.
merged_pr() {
  local repo=$1 branch=$2 pr
  [[ $have_gh == true ]] || return 1
  pr=$(cd "$repo" && gh pr list --head "$branch" --state merged --limit 1 \
    --json number,headRefOid --jq '.[0] // empty | "\(.number) \(.headRefOid)"' \
    2>/dev/null) || return 1
  [[ -n $pr ]] || return 1
  printf '%s\n' "$pr"
}

# Why a checkout of a merged PR's branch has to stay, or nothing when it can go.
#
# A branch name can be reused after its PR merged, or get commits pushed later.
# Delete only when every local commit is in what the PR merged. If git does not
# have the PR's head commit, the ancestry check fails and the branch stays.
keep_reason() {
  local checkout=$1 head_oid=$2 tip
  tip=$(git -C "$checkout" rev-parse HEAD)
  if [[ $tip != "$head_oid" ]] &&
    ! git -C "$checkout" merge-base --is-ancestor "$tip" "$head_oid" 2>/dev/null; then
    printf 'the branch has commits the PR did not\n'
  elif [[ -n $(git -C "$checkout" status --porcelain) ]]; then
    printf 'the tree has uncommitted changes\n'
  fi
}

# Leave a branch whose PR has merged: switch to the default branch, which the
# fetch has just brought up to date, and delete the branch. Prints a note and
# returns 0 when it did, prints why not and returns 1 when the PR merged but the
# branch stays, and returns 2 with no output when there is no merged PR.
retire_branch() {
  local repo=$1 default=$2 branch=$3 pr number head_oid reason log
  pr=$(merged_pr "$repo" "$branch") || return 2
  number=${pr%% *}
  head_oid=${pr#* }

  if snoozed "$repo" "$branch"; then
    reason='moto has it snoozed'
  else
    reason=$(keep_reason "$repo" "$head_oid")
  fi
  if [[ -n $reason ]]; then
    printf 'PR #%s merged, but %s, kept\n' "$number" "$reason"
    return 1
  fi
  if ! log=$(git -C "$repo" switch --quiet "$default" 2>&1); then
    printf 'PR #%s merged, but switching to %s failed: %s\n' \
      "$number" "$default" "$(error_line "$log")"
    return 1
  fi
  # -D rather than -d: after a squash merge git cannot tell the branch is merged.
  if ! log=$(git -C "$repo" branch -D "$branch" 2>&1); then
    printf 'PR #%s merged, switched to %s, but deleting %s failed: %s\n' \
      "$number" "$default" "$branch" "$(error_line "$log")"
    return 0
  fi
  printf 'PR #%s merged, switched to %s and deleted %s\n' "$number" "$default" "$branch"
}

# Remove the linked worktrees whose branch's PR has merged, and their branches.
# Writes one line per worktree with a merged PR: "worktree", then removed or
# kept, then a note. Worktrees without a merged PR say nothing.
#
# Two kinds of worktree are never removed. One Herdr has open as a workspace
# would leave that workspace pointing at a missing directory. One under
# $code_dir, outside this repo's own directory, was put there on purpose: a
# checkout code-sync tracks as a repo of its own, or part of a multi-service
# stack grouped in one folder.
retire_worktrees() {
  local repo=$1 line wt_path='' wt_branch='' open_paths='' pr number head_oid reason log
  local i git_dirs main_seen=false
  local -a wt_paths=() wt_branches=()

  # Only the main checkout does this. A linked worktree under $code_dir is a
  # repo here too, and both would otherwise act on the same worktrees at once.
  git_dirs=$(git -C "$repo" rev-parse --path-format=absolute --git-dir --git-common-dir) ||
    return 0
  [[ ${git_dirs%%$'\n'*} == "${git_dirs#*$'\n'}" ]] || return 0

  git -C "$repo" worktree prune || true
  while IFS= read -r line; do
    case $line in
      'worktree '*) wt_path=${line#worktree } wt_branch='' ;;
      'branch refs/heads/'*) wt_branch=${line#branch refs/heads/} ;;
      '')
        # The first entry is always the main checkout, whatever its path says.
        if [[ $main_seen == false ]]; then
          main_seen=true
        elif [[ -n $wt_path && -n $wt_branch ]]; then
          wt_paths+=("$wt_path")
          wt_branches+=("$wt_branch")
        fi
        wt_path='' wt_branch=''
        ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain; printf '\n')
  ((${#wt_paths[@]} > 0)) || return 0

  if command -v herdr >/dev/null 2>&1; then
    open_paths=$(herdr worktree list --cwd "$repo" 2>/dev/null |
      jq -r '.result.worktrees[]? | select(.open_workspace_id) | .path' 2>/dev/null) || true
  fi

  for i in "${!wt_paths[@]}"; do
    wt_path=${wt_paths[i]}
    wt_branch=${wt_branches[i]}
    if [[ $wt_path == "$code_dir"/* && $wt_path != "$repo"/* ]]; then
      continue
    fi
    pr=$(merged_pr "$repo" "$wt_branch") || continue
    number=${pr%% *}
    head_oid=${pr#* }

    if printf '%s\n' "$open_paths" | grep -Fxq -- "$wt_path"; then
      reason='Herdr has it open'
    elif snoozed "$repo" "$wt_branch"; then
      reason='moto has it snoozed'
    else
      reason=$(keep_reason "$wt_path" "$head_oid")
    fi
    if [[ -n $reason ]]; then
      printf 'worktree\tkept\tPR #%s merged, but %s, kept worktree %s\n' \
        "$number" "$reason" "$wt_path"
      continue
    fi
    # No --force: git refuses a worktree with untracked files or a lock, and
    # either one is a reason to keep it.
    if ! log=$(git -C "$repo" worktree remove "$wt_path" 2>&1); then
      printf 'worktree\tkept\tPR #%s merged, but removing worktree %s failed: %s\n' \
        "$number" "$wt_path" "$(error_line "$log")"
      continue
    fi
    if ! log=$(git -C "$repo" branch -D "$wt_branch" 2>&1); then
      printf 'worktree\tremoved\tPR #%s merged, removed worktree %s, but deleting %s failed: %s\n' \
        "$number" "$wt_path" "$wt_branch" "$(error_line "$log")"
      continue
    fi
    printf 'worktree\tremoved\tPR #%s merged, removed worktree %s and deleted %s\n' \
      "$number" "$wt_path" "$wt_branch"
  done
}

# Whether any of the newline-separated paths is this directory or lies inside it.
within() {
  local dir=$1 paths=$2 p
  while IFS= read -r p; do
    if [[ -n $p && ($p == "$dir" || $p == "$dir"/*) ]]; then
      return 0
    fi
  done <<<"$paths"
  return 1
}

# When this checkout last saw work, in epoch seconds: the newer of HEAD's last
# reflog entry (a commit, checkout, rebase or reset here) and the commit date of
# HEAD, for a repo that keeps no reflog.
last_activity() {
  local repo=$1 reflog_time commit_time
  commit_time=$(git -C "$repo" log -1 --format=%ct HEAD 2>/dev/null) || commit_time=0
  reflog_time=$(git -C "$repo" log -g -1 --date=unix --format=%gd HEAD 2>/dev/null) ||
    reflog_time=''
  reflog_time=${reflog_time#*@\{}
  reflog_time=${reflog_time%\}}
  if [[ $reflog_time =~ ^[0-9]+$ ]] && ((reflog_time > commit_time)); then
    printf '%s\n' "$reflog_time"
  else
    printf '%s\n' "${commit_time:-0}"
  fi
}

# Why a main checkout on another branch has to stay there, or nothing when
# --park may switch it to the default branch.
park_reason() {
  local repo=$1 default=$2 branch=$3 default_checkout
  if [[ -n $(git -C "$repo" status --porcelain --untracked-files=normal) ]]; then
    printf 'the tree has uncommitted changes or untracked files\n'
  elif within "$repo" "$agent_cwds"; then
    printf 'an agent in Herdr is working in it\n'
  elif within "$repo" "$moto_cwds" || snoozed "$repo" "$branch"; then
    printf 'a moto task uses it\n'
  elif (($(date +%s) - $(last_activity "$repo") < park_idle_seconds)); then
    printf 'it was used in the last 24 hours\n'
  else
    default_checkout=$(checkout_of "$repo" "$default")
    if [[ -n $default_checkout && $default_checkout != "$repo" ]]; then
      printf '%s is checked out in %s\n' "$default" "$default_checkout"
    fi
  fi
}

# The report line for a parked checkout, which keeps the branch name so the
# branch can be found again.
park_line() {
  local repo=$1 default=$2 branch=$3 ahead
  ahead=$(git -C "$repo" rev-list --count "refs/remotes/origin/$default..refs/heads/$branch" \
    2>/dev/null) || ahead='?'
  printf 'on %s (%s ahead) -> %s\n' "$branch" "$ahead" "$default"
}

# Move an idle checkout off its branch onto the default branch, which the fetch
# has just brought up to date. Prints the report line and returns 0 when it did,
# prints why not and returns 1 when the checkout stays.
park_branch() {
  local repo=$1 default=$2 branch=$3 reason log
  reason=$(park_reason "$repo" "$default" "$branch")
  if [[ -n $reason ]]; then
    printf 'not parked: %s\n' "$reason"
    return 1
  fi
  if ! log=$(git -C "$repo" switch --quiet "$default" 2>&1); then
    printf 'not parked: switching to %s failed: %s\n' "$default" "$(error_line "$log")"
    return 1
  fi
  printf 'parked: %s\n' "$(park_line "$repo" "$default" "$branch")"
}

# Where a repo is sitting, for the report. A detached HEAD has no branch name
# to print, so its note already says everything.
where_clause() {
  local branch=$1 note=$2
  if [[ $branch == '-' ]]; then
    printf '%s\n' "$note"
  else
    printf 'on %s (%s)\n' "$branch" "$note"
  fi
}

# The worktree that has this branch checked out, the main checkout included, or
# nothing when no worktree does. git refuses to move a branch's ref from the
# outside while some worktree has it checked out.
checkout_of() {
  local repo=$1 branch=$2 line wt_path=''
  while IFS= read -r line; do
    case $line in
      'worktree '*) wt_path=${line#worktree } ;;
      "branch refs/heads/$branch")
        printf '%s\n' "$wt_path"
        return
        ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain)
}

# Fast-forward one repo's default branch, then write a single tab-separated
# line: result, default branch, checked-out branch, commits gained, whether a
# merged branch was retired or the checkout parked (yes, parked or -), and a note (the branch report, or the
# git error for a failure). The retired field is never empty, because read
# collapses consecutive tabs and would shift the note into it. The worktree lines
# from retire_worktrees follow it. Runs in a background subshell, so these lines
# are how it reports rather than globals or an exit code.
update_repo() {
  local repo=$1 default head_branch before after log exit_code=0 gained note result
  local retired=- retire_status park_status park_note default_checkout
  if ! default=$(default_branch "$repo"); then
    printf 'failed\t-\t-\t0\t-\torigin/HEAD is unset and there is no origin/main or origin/master\n'
    return
  fi

  before=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$default" || true)
  head_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD || printf -- '-')
  default_checkout=$(checkout_of "$repo" "$default")

  # The fetches run without --quiet on purpose. Their output is captured either
  # way and only ever printed for a failure, and --quiet swallows the
  # `! [rejected]` line that says why a refspec did not apply.
  if [[ -n $default_checkout ]]; then
    # Some worktree has the default branch checked out: this one, or a linked
    # worktree when this one is on another branch. Fast-forward it in that
    # worktree. Fetch and merge by hand instead of `git pull --ff-only`, so the
    # repo's own pull.rebase and pull.ff settings cannot change what happens here.
    if log=$(git -C "$repo" fetch origin \
      "+refs/heads/$default:refs/remotes/origin/$default" 2>&1); then
      log=$(git -C "$default_checkout" merge --ff-only --quiet \
        "refs/remotes/origin/$default" 2>&1) || exit_code=$?
    else
      exit_code=$?
    fi
  else
    # No worktree has the default branch checked out, so move its ref directly
    # and leave the worktree on whatever branch it is on. Without a leading + this refspec
    # rejects a non-fast-forward, which is what we want; the remote-tracking ref
    # gets the forced one, since it mirrors the remote and holds no local work.
    log=$(git -C "$repo" fetch origin \
      "+refs/heads/$default:refs/remotes/origin/$default" \
      "refs/heads/$default:refs/heads/$default" 2>&1) || exit_code=$?
  fi

  if ((exit_code != 0)); then
    # One line, not the transcript: 45 repos' worth of git output buries
    # everything else the sweep has to say.
    printf 'failed\t%s\t%s\t0\t-\t%s\n' "$default" "$head_branch" "$(error_line "$log")"
    return
  fi

  after=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$default" || true)
  gained=0
  result=current
  if [[ $after != "$before" ]]; then
    result=updated
    if [[ -n $before ]]; then
      gained=$(git -C "$repo" rev-list --count "$before..$after")
    else
      gained=$(git -C "$repo" rev-list --count "$after")
    fi
  fi

  note=''
  if [[ $head_branch != "$default" && $head_branch != '-' ]]; then
    retire_status=0
    note=$(retire_branch "$repo" "$default" "$head_branch") || retire_status=$?
    if ((retire_status == 0)); then
      retired=yes
      head_branch=$default
    fi
  fi
  if [[ $head_branch != "$default" && -z $note ]]; then
    note=$(branch_report "$repo" "$default" "$head_branch")
  fi
  if [[ $park == true && $head_branch != "$default" && $head_branch != '-' ]]; then
    park_status=0
    park_note=$(park_branch "$repo" "$default" "$head_branch") || park_status=$?
    if ((park_status == 0)); then
      retired=parked
      head_branch=$default
      note=$park_note
    else
      note="$note, $park_note"
    fi
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$result" "$default" "$head_branch" "$gained" "$retired" "$note"
  retire_worktrees "$repo"
}

# getopts knows no long options, so spell them as their short ones first.
short_args=()
for arg in "$@"; do
  case $arg in
    --park) short_args+=(-p) ;;
    --help) short_args+=(-h) ;;
    *) short_args+=("$arg") ;;
  esac
done
set -- ${short_args[@]+"${short_args[@]}"}

dry_run=false
show_status=false
park=false
while getopts ':nsph' opt; do
  case $opt in
    n) dry_run=true ;;
    s) show_status=true ;;
    p) park=true ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v gita >/dev/null 2>&1; then
  cat >&2 <<'EOF'
code-sync: gita is not on PATH.
It is declared in dotfiles (nix/home/shared/packages/workstation.nix);
run the dotfiles switch to pick it up.
EOF
  exit 1
fi

if [[ ! -d $code_dir ]]; then
  printf 'code-sync: %s does not exist\n' "$code_dir" >&2
  exit 1
fi

# What --park needs to tell an idle checkout from one in use: the cwds of agent
# panes in Herdr, and the directories moto tasks work in. A task with no cwd
# works in its repo. Without Herdr on PATH nothing can be open in it, but when
# Herdr is there and cannot answer, there is no telling, so nothing is parked.
agent_cwds=''
moto_cwds=''
if [[ $park == true ]]; then
  if command -v herdr >/dev/null 2>&1; then
    if ! agent_cwds=$(herdr pane list 2>/dev/null | jq -r '.result.panes[]
        | select((.agent // "") != "") | .cwd, .foreground_cwd | values'); then
      printf 'code-sync: cannot list the panes in Herdr, so nothing will be parked\n' >&2
      park=false
    fi
  fi
  if [[ -f $moto_tasks ]]; then
    if ! moto_cwds=$(jq -r '.tasks[]? | (.cwd // .repo), .snoozed.cwd? | values' \
      "$moto_tasks"); then
      printf 'code-sync: cannot read the task directories in %s\n' "$moto_tasks" >&2
      exit 1
    fi
  fi
fi

# Directory names from the ignore file, one per line, comments and blank lines
# dropped.
ignore_names=''
if [[ -f $ignore_file ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    if [[ -n $line ]]; then
      ignore_names+=$line$'\n'
    fi
  done <"$ignore_file"
fi

# Enumerate the checkouts explicitly rather than using `gita add -r`, which
# recurses without limit and would pick up every nested .git it finds (test
# fixtures, vendored deps, worktrees). `gita add -a` is worse: it also builds a
# group per directory level, which a flat ~/code does not want.
names=()
paths=()
ignored=()
remoteless=()
linked=()
for candidate in "$code_dir"/*/; do
  repo=${candidate%/}
  [[ -e ${repo}/.git ]] || continue
  if printf '%s' "$ignore_names" | grep -Fxq -- "${repo##*/}"; then
    ignored+=("${repo##*/}")
    continue
  fi
  # Only main checkouts, where .git is a directory. A linked worktree has a
  # .git file instead, and its main checkout already updates it.
  if [[ -f ${repo}/.git ]]; then
    linked+=("${repo##*/}")
    continue
  fi
  [[ -d ${repo}/.git ]] || continue
  if [[ -z $(git -C "$repo" remote) ]]; then
    remoteless+=("${repo##*/}")
    continue
  fi
  names+=("${repo##*/}")
  paths+=("$repo")
done

if ((${#names[@]} == 0)); then
  printf 'code-sync: no git checkouts with a remote found in %s\n' "$code_dir" >&2
  exit 1
fi

if ((${#ignored[@]} > 0)); then
  printf 'code-sync: ignoring %d checkout(s) listed in %s: %s\n' \
    "${#ignored[@]}" "$ignore_file" "${ignored[*]}"
fi

if ((${#remoteless[@]} > 0)); then
  printf 'code-sync: ignoring %d checkout(s) with no remote: %s\n' \
    "${#remoteless[@]}" "${remoteless[*]}"
fi

if ((${#linked[@]} > 0)); then
  printf 'code-sync: ignoring %d linked worktree(s): %s\n' \
    "${#linked[@]}" "${linked[*]}"
fi

wanted=$(printf '%s\n' "${names[@]}")

# Walk the tracked rows to find what the list holds that ~/code no longer does.
# Rows pointing outside $code_dir belong to something else and are skipped:
# this command promises to touch only what lives under it.
tracked=()
drop_live=() # still a checkout, but unwanted now (ignored, lost its remote, or a linked worktree)
drop_dead=() # path is gone
if [[ -f $repos_csv ]]; then
  while IFS=, read -r row_path row_name _; do
    [[ -n ${row_path:-} && -n ${row_name:-} ]] || continue
    [[ $row_path == "$code_dir"/* ]] || continue
    tracked+=("$row_name")
    if printf '%s\n' "$wanted" | grep -Fxq -- "$row_name"; then
      continue
    fi
    if [[ -e ${row_path}/.git ]]; then
      drop_live+=("$row_name")
    else
      drop_dead+=("$row_name")
    fi
  done <"$repos_csv"
fi

tracked_names=$(printf '%s\n' ${tracked[@]+"${tracked[@]}"})
add_paths=()
add_names=()
for i in "${!names[@]}"; do
  if ! printf '%s\n' "$tracked_names" | grep -Fxq -- "${names[i]}"; then
    add_paths+=("${paths[i]}")
    add_names+=("${names[i]}")
  fi
done

if [[ $dry_run == true ]]; then
  if ((${#add_names[@]} > 0)); then
    printf 'code-sync: would register %d repo(s):\n' "${#add_names[@]}"
    printf '  %s\n' "${add_names[@]}"
  fi
  drop_all=(${drop_live[@]+"${drop_live[@]}"} ${drop_dead[@]+"${drop_dead[@]}"})
  if ((${#drop_all[@]} > 0)); then
    printf 'code-sync: would unregister %d repo(s):\n' "${#drop_all[@]}"
    printf '  %s\n' "${drop_all[@]}"
  fi
  printf 'code-sync: would fast-forward the default branch of %d repo(s) under %s and clean up merged branches and worktrees\n' \
    "${#names[@]}" "$code_dir"
  if [[ $park == true ]]; then
    # Nothing is fetched here, so the counts are against the last fetch. A
    # branch whose PR merged shows as parked, where the real run deletes it.
    for i in "${!names[@]}"; do
      default=$(default_branch "${paths[i]}") || continue
      head_branch=$(git -C "${paths[i]}" symbolic-ref --quiet --short HEAD) || continue
      [[ $head_branch != "$default" ]] || continue
      reason=$(park_reason "${paths[i]}" "$default" "$head_branch")
      if [[ -n $reason ]]; then
        printf '  %-30s on %s, not parked: %s\n' "${names[i]}" "$head_branch" "$reason"
      else
        printf '  %-30s would park: %s\n' "${names[i]}" \
          "$(park_line "${paths[i]}" "$default" "$head_branch")"
      fi
    done
  fi
  exit 0
fi

if ((${#add_paths[@]} > 0)); then
  add_log=$(gita add "${add_paths[@]}" 2>&1) || {
    printf '%s\n' "$add_log" >&2
    printf 'code-sync: gita add failed\n' >&2
    exit 1
  }
  printf 'code-sync: registered %d repo(s): %s\n' "${#add_names[@]}" "${add_names[*]}"
fi

if ((${#drop_live[@]} > 0)); then
  # `gita rm` rather than a hand-edit: it also drops the repo from any group it
  # belongs to, which editing the csv would leave behind as a dangling name.
  gita rm "${drop_live[@]}"
  printf 'code-sync: unregistered %d repo(s): %s\n' "${#drop_live[@]}" "${drop_live[*]}"
fi

if ((${#drop_dead[@]} > 0)); then
  # `gita rm` refuses these: it validates its arguments against the repos it can
  # still find on disk, and these paths are gone. So drop the rows here instead.
  # A `gita rm` above has often already rewritten them away, which makes this a
  # no-op rather than a conflict.
  drop_list=$(printf '%s\n' "${drop_dead[@]}")
  kept=$(mktemp)
  while IFS= read -r row || [[ -n $row ]]; do
    row_name=${row#*,}
    row_name=${row_name%%,*}
    if printf '%s\n' "$drop_list" | grep -Fxq -- "$row_name"; then
      continue
    fi
    printf '%s\n' "$row"
  done <"$repos_csv" >"$kept"
  mv "$kept" "$repos_csv"
  printf 'code-sync: dropped %d dead row(s): %s\n' "${#drop_dead[@]}" "${drop_dead[*]}"
fi

printf 'code-sync: updating %d repo(s) under %s\n' "${#names[@]}" "$code_dir"

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Fetch in batches rather than one repo after another: ~45 round trips to
# GitHub, run in sequence, is most of the wall clock of a sweep. Each job writes
# its own file, which the loop below reads back in the original order, so the
# output does not depend on which fetch finished first.
running=0
for i in "${!names[@]}"; do
  update_repo "${paths[i]}" >"$scratch/$i.out" 2>"$scratch/$i.err" &
  running=$((running + 1))
  if ((running >= jobs_max)); then
    wait
    running=0
  fi
done
wait

updated=0
current=0
failed=0
off_default=0
retired_count=0
parked_count=0
worktrees_removed=0
for i in "${!names[@]}"; do
  result=''
  IFS=$'\t' read -r result default head_branch gained retired note <"$scratch/$i.out" || true
  case $result in
    updated | current | failed) ;;
    *)
      # update_repo itself broke, which leaves no line to parse.
      result=failed
      IFS= read -r note <"$scratch/$i.err" || note='no output'
      ;;
  esac

  case $result in
    failed)
      failed=$((failed + 1))
      printf '  %-30s failed: %s\n' "${names[i]}" "$note"
      ;;
    updated)
      updated=$((updated + 1))
      if [[ $retired == parked ]]; then
        parked_count=$((parked_count + 1))
        printf '  %-30s %s +%s, %s\n' "${names[i]}" "$default" "$gained" "$note"
      elif [[ $retired == yes ]]; then
        retired_count=$((retired_count + 1))
        printf '  %-30s %s +%s, %s\n' "${names[i]}" "$default" "$gained" "$note"
      elif [[ -n $note ]]; then
        off_default=$((off_default + 1))
        printf '  %-30s %s +%s, %s\n' \
          "${names[i]}" "$default" "$gained" "$(where_clause "$head_branch" "$note")"
      else
        printf '  %-30s %s +%s\n' "${names[i]}" "$default" "$gained"
      fi
      ;;
    current)
      current=$((current + 1))
      # A repo on its default branch with nothing to pull says nothing worth a
      # line. One left on another branch does.
      if [[ $retired == parked ]]; then
        parked_count=$((parked_count + 1))
        printf '  %-30s %s\n' "${names[i]}" "$note"
      elif [[ $retired == yes ]]; then
        retired_count=$((retired_count + 1))
        printf '  %-30s %s\n' "${names[i]}" "$note"
      elif [[ -n $note ]]; then
        off_default=$((off_default + 1))
        printf '  %-30s %s\n' "${names[i]}" "$(where_clause "$head_branch" "$note")"
      fi
      ;;
  esac

  while IFS=$'\t' read -r kind wt_result wt_note; do
    [[ $kind == worktree ]] || continue
    if [[ $wt_result == removed ]]; then
      worktrees_removed=$((worktrees_removed + 1))
    fi
    printf '  %-30s %s\n' "${names[i]}" "$wt_note"
  done < <(tail -n +2 "$scratch/$i.out")
done

printf 'code-sync: %d updated, %d already current, %d failed, %d not on the default branch, %d merged branch(es) cleaned up, %d worktree(s) removed' \
  "$updated" "$current" "$failed" "$off_default" "$retired_count" "$worktrees_removed"
if [[ $park == true ]]; then
  printf ', %d parked' "$parked_count"
fi
printf '\n'

if [[ $show_status == true ]]; then
  printf '\n'
  # `gita ll` takes a group name, not repo names, so this covers everything
  # tracked rather than just $code_dir. Harmless for a read-only status table.
  gita ll
fi

if ((failed > 0)); then
  exit 1
fi
