#!/usr/bin/env bash
set -euo pipefail
[[ -z "${TRACE:-}" ]] || set -x

# Desktop launchers close immediately, so report failures through notifications.
failure_detail=""
show_failure() {
  local exit_code=$?
  if (( exit_code != 0 )); then
    printf '\nProject picker failed (exit %s).\n' "$exit_code" >&2
    case "${backend:-}" in
      --hypr|--niri)
        # busctl is already available on NixOS; no extra notification CLI needed.
        busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
          org.freedesktop.Notifications Notify 'susssasa{sv}i' \
          'Project picker' 0 '' 'Could not open project' \
          "${failure_detail:-Project picker failed (exit $exit_code).}" \
          0 1 urgency y 2 -1 >/dev/null || true
        ;;
      *)
        if [[ -t 0 && -t 2 ]]; then
          read -r -p 'Press Enter to close… ' || true
        fi
        ;;
    esac
  fi
  return "$exit_code"
}
trap show_failure EXIT

run_desktop_backend() {
  local output exit_code
  if output=$("$@" 2>&1); then
    [[ -z "$output" ]] || printf '%s\n' "$output"
  else
    exit_code=$?
    failure_detail="${output:-$1 failed (exit $exit_code).}"
    printf '%s\n' "$failure_detail" >&2
    return "$exit_code"
  fi
}

usage() {
  echo 'Usage: project-picker --niri|--hypr|--herdr'
}
if [[ $# -ne 1 ]]; then
  usage >&2
  exit 2
fi
case "$1" in
  --niri|--hypr|--herdr) backend="$1" ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

projects=$({
  while IFS= read -r candidate; do
    git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true
  done < <(zoxide query -l 2>/dev/null || true)
  shopt -s nullglob
  for root in "$HOME/code" "$HOME"/work/*/code; do
    [[ -d "$root" ]] || continue
    while IFS= read -r marker; do
      marker="${marker%/}"
      printf '%s\n' "${marker%/.git}"
    done < <(fd --hidden --no-ignore --max-depth 3 --glob .git "$root")
  done
} | awk 'NF && !seen[$0]++')

set +e
output=$(fzf --prompt='project> ' --height=100% --header='Esc to type a path' --expect=esc <<< "$projects")
exit_code=$?
set -e
key="${output%%$'\n'*}"
dir="${output#*$'\n'}"
if [[ "$key" == esc ]]; then
  read -rep 'path> ' dir || exit 0
elif [[ $exit_code -ne 0 ]]; then
  exit 0
fi
[[ -n "$dir" ]] || exit 0
# Expand only the home shorthand, never execute shell expressions from input.
case "$dir" in
  '~') dir="$HOME" ;;
  '~/'*) dir="$HOME/${dir:2}" ;;
esac
if [[ ! -d "$dir" ]]; then
  failure_detail="Not a directory: $dir"
  printf '%s\n' "$failure_detail" >&2
  exit 1
fi
dir=$(realpath -- "$dir")

case "$backend" in
  --niri) run_desktop_backend niri-project --terminals 1 "$dir" ;;
  --hypr) run_desktop_backend hyprland-project --terminals 1 "$dir" ;;
  --herdr)
    herdr_bin="${HERDR_BIN_PATH:-herdr}"
    # Workspace records have no cwd. Match the saved cwd of their panes,
    # not foreground_cwd, which changes as programs navigate directories.
    workspaces=$("$herdr_bin" workspace list)
    while IFS= read -r workspace; do
      panes=$("$herdr_bin" pane list --workspace "$workspace")
      while IFS= read -r pane_cwd; do
        [[ -d "$pane_cwd" ]] || continue
        if [[ "$(realpath -- "$pane_cwd")" == "$dir" ]]; then
          "$herdr_bin" workspace focus "$workspace"
          exit 0
        fi
      done < <(jq -r '.result.panes[] | .cwd // empty' <<< "$panes")
    done < <(jq -r '.result.workspaces[].workspace_id' <<< "$workspaces")
    "$herdr_bin" workspace create --cwd "$dir" --label "$(basename "$dir")" --focus
    ;;
esac
