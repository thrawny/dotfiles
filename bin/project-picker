#!/usr/bin/env bash
set -euo pipefail
[[ -z "${TRACE:-}" ]] || set -x

usage() {
  echo 'Usage: project-picker --niri|--hypr|--herdr'
}
if [[ $# -ne 1 ]]; then
  usage >&2
  exit 2
fi
case "$1" in
  --niri|--hypr|--herdr) backend="$1" ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

projects=$({
  while IFS= read -r candidate; do
    git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true
  done < <(zoxide query -l 2>/dev/null || true)
  shopt -s nullglob
  for root in "$HOME/code" "$HOME"/work/*/code; do
    [[ -d "$root" ]] || continue
    while IFS= read -r marker; do
      marker="${marker%/}"
      printf '%s\n' "${marker%/.git}"
    done < <(fd --hidden --no-ignore --max-depth 3 --glob .git "$root")
  done
} | awk 'NF && !seen[$0]++')

set +e
output=$(fzf --prompt='project> ' --height=100% --header='Esc to type a path' --expect=esc <<< "$projects")
exit_code=$?
set -e
key="${output%%$'\n'*}"
dir="${output#*$'\n'}"
if [[ "$key" == esc ]]; then
  read -rep 'path> ' dir || exit 0
elif [[ $exit_code -ne 0 ]]; then
  exit 0
fi
[[ -n "$dir" ]] || exit 0
# Expand only the home shorthand, never execute shell expressions from input.
case "$dir" in
  '~') dir="$HOME" ;;
  '~/'*) dir="$HOME/${dir:2}" ;;
esac
if [[ ! -d "$dir" ]]; then
  printf 'Not a directory: %s\n' "$dir" >&2
  exit 1
fi
dir=$(realpath -- "$dir")

case "$backend" in
  --niri) exec niri-project --terminals 1 "$dir" ;;
  --hypr) exec hyprland-project --terminals 1 "$dir" ;;
  --herdr)
    herdr_bin="${HERDR_BIN_PATH:-herdr}"
    # Workspace records have no cwd. Match the saved cwd of their panes,
    # not foreground_cwd, which changes as programs navigate directories.
    workspaces=$("$herdr_bin" workspace list)
    while IFS= read -r workspace; do
      panes=$("$herdr_bin" pane list --workspace "$workspace")
      while IFS= read -r pane_cwd; do
        [[ -d "$pane_cwd" ]] || continue
        if [[ "$(realpath -- "$pane_cwd")" == "$dir" ]]; then
          exec "$herdr_bin" workspace focus "$workspace"
        fi
      done < <(jq -r '.result.panes[] | .cwd // empty' <<< "$panes")
    done < <(jq -r '.result.workspaces[].workspace_id' <<< "$workspaces")
    exec "$herdr_bin" workspace create --cwd "$dir" --label "$(basename "$dir")" --focus
    ;;
esac
