#!/usr/bin/env python3
"""Build and start a local NixOS headless container with Incus."""

from __future__ import annotations

import argparse
import json
import logging
import os
import shlex
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

READINESS_TIMEOUT_SECONDS = 120
logger = logging.getLogger("incus-dev")


def local_ref(name: str) -> str:
    return f"local:{name}"


@dataclass
class Args:
    container: str
    image_variant: str = "headless"


def parse_args(argv: list[str]) -> Args:
    parser = argparse.ArgumentParser(
        prog="incus-dev",
        description="Build and start a local NixOS headless container.",
        epilog="Enter it with: incus exec NAME -- su - thrawny",
    )
    parser.add_argument("container", metavar="name", help="local Incus container name")
    parser.add_argument(
        "--image-variant",
        choices=["headless", "headless-docker", "headless-podman"],
        default="headless",
        help="NixOS image variant (default: headless)",
    )
    ns = parser.parse_args(argv)

    if ":" in ns.container:
        parser.error(
            "remote Incus targets are not supported; incus-dev is for local headless testing"
        )

    return Args(container=ns.container, image_variant=ns.image_variant)


def run(
    args: list[str], *, capture: bool = False, check: bool = True
) -> subprocess.CompletedProcess[str]:
    logger.debug("+ %s", " ".join(shlex.quote(arg) for arg in args))
    return subprocess.run(
        args,
        capture_output=capture,
        check=check,
        text=True,
    )


def out(args: list[str]) -> str:
    return run(args, capture=True).stdout.strip()


def build_headless_image(repo_root: Path, variant: str) -> str:
    result = run(
        [
            "nix",
            "build",
            f"{repo_root}/nix#nixosConfigurations.{variant}.config.system.build.images.incus",
            "--no-link",
            "--print-out-paths",
        ],
        capture=True,
        check=False,
    )
    if result.stderr:
        sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise SystemExit(result.returncode)
    return result.stdout.strip()


def image_property(image_ref: str, key: str) -> str:
    result = run(
        ["incus", "image", "show", local_ref(image_ref)],
        capture=True,
        check=False,
    )
    if result.returncode != 0:
        return ""

    in_properties = False
    for line in result.stdout.splitlines():
        if line == "properties:":
            in_properties = True
            continue
        if in_properties and line and not line[0].isspace():
            break
        if in_properties:
            stripped = line.strip()
            if stripped.startswith(f"{key}:"):
                return stripped.split(":", 1)[1].strip()
    return ""


def image_for_store_path(image_path: str) -> str:
    images = json.loads(out(["incus", "image", "list", "local:", "--format=json"]))
    for image in images:
        if image.get("properties", {}).get("nix_store_path") == image_path:
            return str(image["fingerprint"])
    return ""


def sync_image(alias: str, image_path: str) -> None:
    if image_property(alias, "nix_store_path") == image_path:
        logger.info("Image '%s' already up to date.", alias)
        return

    fingerprint = image_for_store_path(image_path)
    if fingerprint:
        deleted = run(
            ["incus", "image", "alias", "delete", local_ref(alias)],
            capture=True,
            check=False,
        )
        if deleted.returncode == 0:
            logger.info("Replacing stale image alias '%s'.", alias)
        run(["incus", "image", "alias", "create", local_ref(alias), fingerprint])
        logger.info("Aliased existing image as '%s'.", alias)
        return

    if image_property(alias, "nix_store_path"):
        run(["incus", "image", "alias", "delete", local_ref(alias)])
        logger.info("Replacing stale image alias '%s'.", alias)

    logger.info("Importing %s image locally.", alias)
    run(
        [
            "incus",
            "image",
            "import",
            f"{image_path}/metadata.tar.xz",
            f"{image_path}/rootfs.tar.zst",
            "local:",
            f"nix_store_path={image_path}",
            "--alias",
            alias,
            "--reuse",
        ]
    )


def container_exists(container: str) -> bool:
    return (
        run(
            ["incus", "info", local_ref(container)], capture=True, check=False
        ).returncode
        == 0
    )


def wait_until_ready(container: str) -> None:
    deadline = time.monotonic() + READINESS_TIMEOUT_SECONDS
    while True:
        result = run(
            ["incus", "exec", local_ref(container), "--", "true"],
            capture=True,
            check=False,
        )
        if result.returncode == 0:
            return
        if time.monotonic() >= deadline:
            detail = (result.stderr or result.stdout or "no diagnostic output").strip()
            raise SystemExit(f"Timed out waiting for {container}: {detail}")
        time.sleep(0.5)


def ensure_started(container: str) -> None:
    if (
        run(
            ["incus", "exec", local_ref(container), "--", "true"],
            capture=True,
            check=False,
        ).returncode
        != 0
    ):
        result = run(
            ["incus", "start", local_ref(container)], capture=True, check=False
        )
        output = (result.stderr + result.stdout).lower()
        if result.returncode != 0 and "already running" not in output:
            result.check_returncode()
    wait_until_ready(container)


def launch(container: str, image_alias: str) -> None:
    run(
        [
            "incus",
            "init",
            local_ref(image_alias),
            local_ref(container),
            "-c",
            "security.nesting=true",
            "-c",
            "raw.lxc=lxc.apparmor.profile=unconfined",
        ]
    )
    run(
        [
            "incus",
            "config",
            "device",
            "add",
            local_ref(container),
            "tun",
            "unix-char",
            "path=/dev/net/tun",
        ]
    )
    run(["incus", "start", local_ref(container)])
    wait_until_ready(container)


def configure_logging() -> None:
    level_name = os.getenv("LOG_LEVEL", "INFO").upper()
    level = getattr(logging, level_name, logging.INFO)
    logging.basicConfig(level=level, format="%(message)s")


def main(argv: list[str]) -> None:
    configure_logging()
    args = parse_args(argv)

    if container_exists(args.container):
        logger.info("Using existing local Incus container '%s'.", args.container)
        ensure_started(args.container)
    else:
        repo_root = Path(__file__).resolve().parent.parent
        image = build_headless_image(repo_root, args.image_variant)
        sync_image(args.image_variant, image)
        launch(args.container, args.image_variant)

    logger.info("Container '%s' is ready.", args.container)
    logger.info("Enter it with: incus exec %s -- su - thrawny", args.container)


if __name__ == "__main__":
    main(sys.argv[1:])
