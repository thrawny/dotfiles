#!/usr/bin/env bash

# Move all windows of an app to a target AeroSpace workspace.
# Usage: move-aerospace-windows <app-name> <target-workspace>

set -uo pipefail

if [ $# -lt 2 ]; then
    echo "Usage: $0 <app-name> <target-workspace>" >&2
    echo "Example: $0 \"Cursor\" 3" >&2
    exit 1
fi

APP_NAME="$1"
TARGET_WORKSPACE="$2"

echo "Moving all '$APP_NAME' windows to workspace $TARGET_WORKSPACE..."

moved_count=0
while true; do
    if ! windows=$(aerospace list-windows --all --format "%{app-name}|%{workspace}|%{window-id}"); then
        echo "Failed to list windows; moved $moved_count '$APP_NAME' window(s)" >&2
        exit 1
    fi

    # One window of the app outside the target workspace. Compare fields
    # exactly so names such as "C++" are not read as patterns.
    WINDOW_ID=$(awk -F'|' -v app="$APP_NAME" -v ws="$TARGET_WORKSPACE" \
        '$1 == app && $2 != ws { print $3; exit }' <<<"$windows")

    # If no more windows found outside target workspace, break
    if [ -z "$WINDOW_ID" ]; then
        break
    fi

    if ! aerospace move-node-to-workspace --window-id "$WINDOW_ID" "$TARGET_WORKSPACE"; then
        echo "Failed to move window $WINDOW_ID; moved $moved_count '$APP_NAME' window(s)" >&2
        exit 1
    fi
    echo "Moved window $WINDOW_ID"
    moved_count=$((moved_count + 1))

    # Small delay to let aerospace process the move
    sleep 0.1
done

echo "Moved $moved_count '$APP_NAME' window(s) to workspace $TARGET_WORKSPACE"
