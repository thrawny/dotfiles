#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
if [[ "$repo_root" != "$HOME/dotfiles" ]]; then
  echo "install-macos-packages: clone this repository at $HOME/dotfiles" >&2
  exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
  cat >&2 <<'EOF'
install-macos-packages: Homebrew is not available.
Ask IT to install or approve Homebrew, then rerun this command.
The dotfile links do not require Homebrew.
EOF
  exit 1
fi

if [[ ${DOTFILES_SETUP_TESTING:-0} != 1 ]] && [[ $(uname -s) != Darwin || $(uname -m) != arm64 ]]; then
  echo "install-macos-packages: only Apple Silicon macOS is supported" >&2
  exit 1
fi

brew tap neurosnap/tap
brew trust neurosnap/tap
if [[ $(uname -s) == Darwin ]]; then
  brew tap nikitabobko/tap
  brew trust nikitabobko/tap
fi
brew bundle --file "$repo_root/Brewfile"

mkdir -p "$HOME/.npm-global"
NPM_CONFIG_PREFIX="$HOME/.npm-global" npm install --global --ignore-scripts \
  @earendil-works/pi-coding-agent@latest \
  acpx@latest
if [[ ${DOTFILES_SETUP_TESTING:-0} == 1 ]]; then
  npm cache clean --force
fi

# These are source-only integrations rather than Homebrew packages.
if [[ -d "$HOME/.local/share/oh-my-zsh/.git" ]]; then
  git -C "$HOME/.local/share/oh-my-zsh" pull --ff-only
else
  mkdir -p "$HOME/.local/share"
  git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.local/share/oh-my-zsh"
fi

if [[ -d "$HOME/.tmux/plugins/tpm/.git" ]]; then
  git -C "$HOME/.tmux/plugins/tpm" pull --ff-only
else
  mkdir -p "$HOME/.tmux/plugins"
  git clone --depth 1 https://github.com/tmux-plugins/tpm.git "$HOME/.tmux/plugins/tpm"
fi
"$HOME/.tmux/plugins/tpm/bin/install_plugins"

pnpm --dir "$repo_root/config/pi" install --prod --frozen-lockfile

# Plugin installation is repeatable. Mason finishes editor-tool installation
# when Neovim starts if a server or formatter is still absent.
nvim --headless "+Lazy! sync" +qa

# Chrome for Testing is installed outside Brew's package database.
agent-browser install

cat <<'EOF'
Package installation complete.
Authenticate Claude, Codex, Pi, and GitHub from their own CLIs.
Run bin/check-macos for anything still missing.
EOF
