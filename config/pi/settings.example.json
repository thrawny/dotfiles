{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode"],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "delegate": {
        "disabled": false,
        "tools": "inherit",
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "systemPrompt": "Execute the delegated task using the available tools. Follow inherited instructions and return concise results, validation, and any unresolved blockers."
      }
    }
  },
  "theme": "monokai-pi",
  "tuiMode": "fullscreen",
  "diffTheme": "subtle",
  "diffView": "unified",
  "diffColors": {
    "bgAdd": "#004466",
    "bgDel": "#660100",
    "bgAddHighlight": "#005f8e",
    "bgDelHighlight": "#8e0100",
    "bgGutterAdd": "#003355",
    "bgGutterDel": "#440100",
    "bgEmpty": "#222222",
    "fgAdd": "#5ad4e6",
    "fgDel": "#fc618d",
    "fgDim": "#78747d",
    "fgLnum": "#78747d",
    "fgRule": "#5f5b63",
    "fgStripe": "#34313a",
    "fgSafeMuted": "#c8c3cf",
    "shikiTheme": "monokai"
  },
  "shellPath": "/run/current-system/sw/bin/zsh",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra"
  ],
  "packages": [
    "npm:pi-subdir-context",
    "npm:@diegopetrucci/pi-fast",
    "npm:@narumitw/pi-codex-compact",
    "git:github.com/thrawny/pi-codex-web-run",
    "git:github.com/thrawny/pi-diff",
    {
      "source": "npm:pi-subagents@0.79.0",
      "skills": [],
      "prompts": []
    }
  ],
  "lastChangelogVersion": "0.80.6",
  "hideThinkingBlock": true
}
