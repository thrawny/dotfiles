{
	"name": "pi-extensions",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "oxfmt --write extensions tests",
		"lint": "oxlint extensions tests --fix --ignore-pattern '**/node_modules/**'",
		"test": "vitest run tests",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"typebox": "latest",
		"@types/node": "latest",
		"oxfmt": "latest",
		"oxlint": "latest",
		"typescript": "latest",
		"vitest": "latest"
	}
}
