{
  "model": "claude-fable-5-1",
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_TMPDIR": "/tmp/claude",
    "USE_BUILTIN_RIPGREP": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/handoff"
  },
  "permissions": {
    "allow": [],
    "additionalDirectories": [
      "~/code",
      "~/dotfiles"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${HERDR_ENV:-}\" != \"1\" ]; then agent-switch track stop --agent claude; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${HERDR_ENV:-}\" != \"1\" ]; then agent-switch track prompt-submit --agent claude; fi"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${HERDR_ENV:-}\" != \"1\" ]; then agent-switch track notification --agent claude; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${HERDR_ENV:-}\" != \"1\" ]; then agent-switch track session-start --agent claude; fi"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${HERDR_PANE_ID:-}\" ]; then moto attach --hook; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${HERDR_ENV:-}\" != \"1\" ]; then agent-switch track session-end --agent claude; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/dotfiles/config/claude/status_line.py",
    "padding": 0
  },
  "autoCompactEnabled": true,
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "attribution": {
    "commit": "🤖 Generated with Claude Code"
  }
}
