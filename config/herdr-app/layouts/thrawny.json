{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "thrawny-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "thrawny-tabs"
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "pane"
                },
                "reveal": "hover",
                "height": 30,
                "position": "top"
              },
              "background": "background",
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "radius": 10,
              "gap": 8,
              "lone": false
            }
          }
        }
      ],
      "resizable": false,
      "padding": 6,
      "gap": 8
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    8,
    8
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
