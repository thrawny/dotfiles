# Nix configuration task runner

# Default recipe
default:
    @just --list

# Install this flake's binary caches into the system nix.conf
install-nix-caches:
    "$(git rev-parse --show-toplevel)/bin/install-nix-caches"

# Switch configuration (NixOS, nix-darwin, or standalone Home Manager)
switch mode="":
    #!/usr/bin/env bash
    set -euo pipefail
    mode={{quote(mode)}}
    case "$mode" in
        ""|--hm-only) ;;
        *) echo "Usage: just switch [--hm-only]" >&2; exit 2 ;;
    esac
    host=$(hostname | sed 's/\.local$//')
    if [ "$mode" = --hm-only ]; then
        if [ "$(uname -s)" = Darwin ]; then host=$(/usr/sbin/scutil --get LocalHostName); fi
        echo "Switching only Home Manager for $host..."
        nix run --inputs-from . home-manager -- switch -b bak --flake ".#$host"
    elif [ -f /etc/NIXOS ]; then
        echo "NixOS detected, running nixos-rebuild switch..."
        running_kernel=$(uname -r)
        sudo nixos-rebuild switch --flake ".#$host"
        new_kernel=$(readlink /run/current-system/kernel | grep -oP 'linux-\K[^/]+')
        if [ "$running_kernel" != "$new_kernel" ]; then
            echo ""
            echo "⚠️  Kernel changed: $running_kernel -> $new_kernel"
            echo "   Reboot before hibernating to avoid resume issues."
        fi
    elif [ "$(uname -s)" = Darwin ]; then
        if [ "${SANDBOX:-0}" = 1 ]; then
            echo "Run just switch on the Mac, outside the sandbox." >&2
            exit 1
        fi
        host=$(/usr/sbin/scutil --get LocalHostName)
        # Macs with a darwinConfiguration switch the whole system; the rest are
        # Home-Manager-only and fall through to home-manager switch.
        if nix eval ".#darwinConfigurations" --apply "c: c ? \"$host\"" 2>/dev/null | grep -qx true; then
            if ! command -v darwin-rebuild >/dev/null 2>&1; then
                echo "Run just bootstrap-darwin from the repo root first." >&2
                exit 1
            fi
            sudo nix run .#darwin-rebuild -- switch --flake ".#$host"
        else
            echo "No nix-darwin configuration for $host, running home-manager switch..."
            home-manager switch -b bak --flake ".#$host"
        fi
    else
        echo "Standalone Home Manager detected, running home-manager switch..."
        home-manager switch -b bak --flake ".#$host"
    fi

# Build locally and deploy over root SSH so unsigned local closures can be
# imported by the remote Nix daemon without trusting a regular user.
# Falls back to `boot` automatically when NixOS refuses a live switch for
# critical component changes such as dbus -> broker.
deploy target:
    #!/usr/bin/env bash
    set -euo pipefail
    log="$(mktemp)"
    trap 'rm -f "$log"' EXIT

    if nixos-rebuild switch --flake ".#{{ target }}" --build-host "" --target-host "root@{{ target }}" 2>&1 | tee "$log"; then
        exit 0
    fi

    if grep -q "Pre-switch check 'switchInhibitors' failed" "$log"; then
        echo ""
        echo "NixOS refused to live-switch critical system components."
        echo "Installing the same configuration for next boot instead..."
        nixos-rebuild boot --flake ".#{{ target }}" --build-host "" --target-host "root@{{ target }}"
        echo ""
        echo "Installed next boot generation on {{ target }}."
        read -r -p "Reboot {{ target }} now? [y/N] " reply
        case "$reply" in
            [yY]|[yY][eE][sS])
                echo "Rebooting {{ target }}..."
                ssh root@{{ target }} reboot
                ;;
            *)
                echo "Not rebooting. Reboot when ready with:"
                echo "  ssh root@{{ target }} reboot"
                ;;
        esac
        exit 0
    fi

    exit 1

# Explicitly build on this machine and install a remote NixOS generation for next boot
deploy-boot target:
    nixos-rebuild boot --flake ".#{{ target }}" --build-host "" --target-host "root@{{ target }}"

# Dry-run NixOS rebuild (NixOS only)
dry:
    sudo nixos-rebuild dry-run --flake ".#$(hostname)"

# Build and show what changed (NixOS only)
diff:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$(hostname)
    sudo nixos-rebuild build --flake ".#$host" && nvd diff /run/current-system result

# Evaluate config without building (NixOS, nix-darwin, or Home Manager)
eval force="--force=false":
    #!/usr/bin/env bash
    set -euo pipefail
    host=$(hostname | sed 's/\.local$//')
    if [ -f /etc/NIXOS ]; then
        echo "Evaluating NixOS config for $host..."
        run-if-changed --name "nix-eval-$host" "{{ force }}" \
            --include 'flake.nix' \
            --include 'flake.lock' \
            --include '**/*.nix' \
            -- nix eval ".#nixosConfigurations.$host.config.system.build.toplevel" --no-write-lock-file > /dev/null
    elif [ "$(uname -s)" = Darwin ]; then
        host=$(/usr/sbin/scutil --get LocalHostName)
        if nix eval ".#darwinConfigurations" --apply "c: c ? \"$host\"" 2>/dev/null | grep -qx true; then
            echo "Evaluating nix-darwin config for $host..."
            nix eval ".#darwinConfigurations.$host.system.drvPath" --no-write-lock-file > /dev/null
        else
            echo "Evaluating Home Manager config for $host..."
            nix eval ".#homeConfigurations.$host.activationPackage" --no-write-lock-file > /dev/null
        fi
    else
        echo "Evaluating Home Manager config for $host..."
        run-if-changed --name "home-eval-$host" "{{ force }}" \
            --include 'flake.nix' \
            --include 'flake.lock' \
            --include '**/*.nix' \
            -- nix eval ".#homeConfigurations.$host.activationPackage" --no-write-lock-file > /dev/null
    fi
    echo "Config is valid"

# Evaluate the complete M1 system, including integrated Home Manager
eval-darwin:
    nix eval .#darwinConfigurations.thrawnym1.system.drvPath --no-write-lock-file

# Build on Apple Silicon without activating
build-darwin:
    nix build .#darwinConfigurations.thrawnym1.system --no-link

# Lock only the nix-darwin input
lock-darwin:
    nix flake update nix-darwin

# Evaluate a specific NixOS host, or inspect one of its config attributes
eval-host target attr="system.build.toplevel.drvPath":
    nix eval --json ".#nixosConfigurations.{{ target }}.config.{{ attr }}" --no-write-lock-file

# Start the packaged Hermes dashboard offline and verify password authentication
check-hermes-web target="obelisk":
    nix build ".#nixosConfigurations.{{ target }}.config.system.build.hermes-web-check" --no-link -L

# Build a specific NixOS host without activating or deploying it
build-host target:
    nix build ".#nixosConfigurations.{{ target }}.config.system.build.toplevel" --no-link --no-write-lock-file

# Exercise generated Tailscale Serve commands against a concurrent fake daemon
check-tailscale-serve target="obelisk":
    nix build ".#nixosConfigurations.{{ target }}.config.system.build.tailscale-serve-check" --no-link --no-write-lock-file

# Check real advertisements and HTTPS reachability from this client
# Redirects and auth challenges count as reachable, not as authenticated access.
tailscale-serve-health target="obelisk":
    #!/usr/bin/env bash
    set -euo pipefail
    configured="$(nix eval --json '.#nixosConfigurations.{{ target }}.config.services.tailscaleServe.services' --no-write-lock-file)"
    tailnet_domain="$(nix eval --raw '.#nixosConfigurations.{{ target }}.config.dotfiles.tailnetDomain' --no-write-lock-file)"
    advertised="$(ssh 'root@{{ target }}' 'tailscale debug prefs | jq .AdvertiseServices')"
    jq -en --argjson configured "$configured" --argjson advertised "$advertised" \
        '$configured | all(.[]; .serviceName as $name | ($advertised | index($name)) != null)'
    failed=0
    while IFS=$'\t' read -r service_name https_port; do
        url="https://${service_name#svc:}.$tailnet_domain:$https_port/"
        if ! http_code="$(curl --max-time 15 --silent --show-error --output /dev/null --write-out '%{http_code}' "$url")"; then
            failed=1
        fi
        printf '%s HTTP %s\n' "$url" "$http_code"
        case "$http_code" in
            200|3??|401|403) ;;
            *) failed=1 ;;
        esac
    done < <(jq -r '.[] | [.serviceName, .httpsPort] | @tsv' <<< "$configured")
    exit "$failed"

# Validate OpenClaw's generated config and its Nix-mode write guard offline
check-openclaw target="obelisk":
    nix build ".#nixosConfigurations.{{ target }}.config.system.build.openclaw-check" --no-link --no-write-lock-file

# Check the deployed gateway using its service identity and credential environment
openclaw-health target="obelisk":
    #!/usr/bin/env bash
    set -euo pipefail
    ssh "root@{{ target }}" 'bash -se' <<'REMOTE'
    set -euo pipefail
    systemctl is-active --quiet openclaw.service
    openclaw-admin config validate --json | jq -e '.valid and ((.warnings // []) | length) == 0'
    if ! health_json="$(openclaw-admin health --json)"; then
      printf '%s\n' "$health_json" >&2
      exit 1
    fi
    printf '%s\n' "$health_json" | jq -e '
      {ok, plugins, channels: (.channels | with_entries(.value |= {configured, running, connected, lastError}))}
      | select(.ok and (.plugins.errors | length) == 0
          and .channels.discord.running and .channels.telegram.running
          and .channels.discord.lastError == null and .channels.telegram.lastError == null)
    '
    curl -fsS -o /dev/null -w 'UI HTTP %{http_code}\n' http://127.0.0.1:18789/
    systemctl show openclaw.service -p ActiveState -p SubState -p NRestarts
    REMOTE

# Evaluate all host configurations
eval-all:
    #!/usr/bin/env bash
    set -euo pipefail
    failed=0

    echo "==> Evaluating NixOS configurations..."
    for host in thrawny-z13 thrawny-desktop obelisk; do
        echo -n "  $host: "
        if nix eval ".#nixosConfigurations.$host.config.system.build.toplevel" --no-write-lock-file > /dev/null 2>&1; then
            echo "ok"
        else
            echo "FAILED"
            failed=1
        fi
    done

    echo ""
    echo "==> Evaluating headless images..."
    for host in headless headless-docker headless-podman; do
        echo -n "  $host: "
        if nix eval ".#nixosConfigurations.$host.config.system.build.images.incus" --no-write-lock-file > /dev/null 2>&1; then
            echo "ok"
        else
            echo "FAILED"
            failed=1
        fi
    done

    echo ""
    echo "==> Evaluating nix-darwin..."
    nix eval .#darwinConfigurations.thrawnym1.system.drvPath --no-write-lock-file || failed=1

    echo "==> Evaluating Home Manager configurations..."
    for host in thrawnym1 jonaslergell; do
        echo -n "  $host: "
        if nix eval ".#homeConfigurations.$host.activationPackage" --no-write-lock-file > /dev/null 2>&1; then
            echo "ok"
        else
            echo "FAILED"
            failed=1
        fi
    done

    echo ""
    if [ $failed -eq 0 ]; then
        echo "All configurations valid!"
    else
        echo "Some configurations failed!"
        exit 1
    fi

# Update AI tool flake inputs (llm-agents) and switch
ai:
    #!/usr/bin/env bash
    set -euo pipefail

    get_version() {
        if ! command -v "$1" >/dev/null 2>&1; then
            echo "not installed"
            return
        fi

        local v
        v=$("$1" --version 2>/dev/null | head -1 || true)
        echo "${v:-not installed}"
    }

    if command -v claude &>/dev/null; then
        claude_bin=claude
    elif command -v claude-node &>/dev/null; then
        claude_bin=claude-node
    else
        claude_bin=claude
    fi

    old_claude=$(get_version "$claude_bin")
    old_codex=$(get_version codex)
    old_pi=$(get_version pi)

    nix flake update llm-agents

    if git diff --quiet -- flake.lock; then
        echo "No updates available."
        exit 0
    fi

    just switch

    new_claude=$(get_version "$claude_bin")
    new_codex=$(get_version codex)
    new_pi=$(get_version pi)

    changed=false
    echo ""
    echo "==> Version changes:"
    if [ "$old_claude" != "$new_claude" ]; then
        echo "  claude: $old_claude -> $new_claude"
        changed=true
    fi
    if [ "$old_codex" != "$new_codex" ]; then
        echo "  codex: $old_codex -> $new_codex"
        changed=true
    fi
    if [ "$old_pi" != "$new_pi" ]; then
        echo "  pi: $old_pi -> $new_pi"
        changed=true
    fi
    if [ "$changed" = false ]; then
        echo "  (no version changes detected)"
        echo "Reverting flake.lock."
        git checkout -- flake.lock
        exit 0
    fi

    git add flake.lock
    git commit -m "chore(nix): update AI flake inputs" -- flake.lock

# Update all flake inputs with AI tool version report and switch
full-update:
    #!/usr/bin/env bash
    set -euo pipefail

    get_version() {
        if ! command -v "$1" >/dev/null 2>&1; then
            echo "not installed"
            return
        fi

        local v
        v=$("$1" --version 2>/dev/null | head -1 || true)
        echo "${v:-not installed}"
    }

    if command -v claude &>/dev/null; then
        claude_bin=claude
    elif command -v claude-node &>/dev/null; then
        claude_bin=claude-node
    else
        claude_bin=claude
    fi

    old_claude=$(get_version "$claude_bin")
    old_codex=$(get_version codex)
    old_pi=$(get_version pi)

    nix flake update

    if git diff --quiet -- flake.lock; then
        echo "No updates available."
        exit 0
    fi

    just switch

    new_claude=$(get_version "$claude_bin")
    new_codex=$(get_version codex)
    new_pi=$(get_version pi)

    changed=false
    echo ""
    echo "==> Version changes:"
    if [ "$old_claude" != "$new_claude" ]; then
        echo "  claude: $old_claude -> $new_claude"
        changed=true
    fi
    if [ "$old_codex" != "$new_codex" ]; then
        echo "  codex: $old_codex -> $new_codex"
        changed=true
    fi
    if [ "$old_pi" != "$new_pi" ]; then
        echo "  pi: $old_pi -> $new_pi"
        changed=true
    fi
    if [ "$changed" = false ]; then
        echo "  (no AI tool version changes detected)"
    fi

    git add flake.lock
    git commit -m "chore(nix): update flake inputs" -- flake.lock

# Update all flake inputs and switch
update: full-update

# Update one flake input without switching
lock input:
    nix flake update "{{ input }}"

# Clean up old generations (keeps last 6) and optimize store
clean:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Removing old user profile generations (keeping last 6)..."
    nix-env --delete-generations +6

    echo ""
    echo "==> Removing old system generations (keeping last 6)..."
    sudo nix-env -p /nix/var/nix/profiles/system --delete-generations +6 || true

    echo ""
    echo "==> Running garbage collection..."
    nix-collect-garbage

    echo ""
    echo "==> Optimizing Nix store (deduplicating files)..."
    nix store optimise

    echo ""
    echo "==> Cleanup complete!"

# Push the flake's cache-bundle (selected expensive builds) to Cachix
cache dry_run="":
    #!/usr/bin/env bash
    set -euo pipefail

    dry_run="{{ dry_run }}"
    cache=thrawny

    if [ -z "$dry_run" ] && [ -z "${CACHIX_AUTH_TOKEN:-}" ]; then
        echo "Error: CACHIX_AUTH_TOKEN not set"
        exit 1
    fi

    # Members are declared in flake.nix (packages.<system>.cache-bundle). Building the
    # bundle also builds anything missing, so this works before `just switch`.
    bundle=$(nix build .#cache-bundle --no-link --print-out-paths --no-write-lock-file)

    echo "cache-bundle members:"
    ls "$bundle" | sed 's/^/  /'

    # One narinfo HEAD per closure path tells us what the cache already has.
    export narinfo_base="https://$cache.cachix.org"
    closure=$(nix path-info -rs "$bundle")
    missing=$(echo "$closure" | awk '{ print $1 }' | xargs -P 16 -n 1 sh -c '
        hash=${1#/nix/store/}
        curl -sfI "$narinfo_base/${hash%%-*}.narinfo" >/dev/null || echo "$1"' _)
    summary=$(echo "$closure" | awk -v missing="$missing" '
        BEGIN { n = split(missing, m, "\n"); for (i = 1; i <= n; i++) if (m[i] != "") miss[m[i]] = 1 }
        { total++; size += $2; if ($1 in miss) { mcount++; msize += $2 } }
        END { printf "%d paths (%d MiB) in closure, %d paths (%d MiB) not yet in cache", \
                     total, size / 1048576, mcount, msize / 1048576 }')

    if [ -n "$dry_run" ]; then
        echo "DRY RUN: $summary"
        exit 0
    fi

    echo "Pushing to $cache: $summary"
    cachix push "$cache" "$bundle"

    echo ""
    echo "Pinning cache-bundle (keeping last 3 revisions)..."
    cachix pin "$cache" cache-bundle "$bundle" --keep-revisions 3

# Format Nix files
fmt:
    nix fmt .

# Lint Nix files
lint:
    #!/usr/bin/env bash
    set -euo pipefail
    root="$(git rev-parse --show-toplevel)"
    mapfile -d '' nix_files < <(
        git -C "$root" ls-files -z 'nix/*.nix' 'nix/**/*.nix' \
            | grep -zv '/hardware-configuration\.nix$'
    )
    if [ "${#nix_files[@]}" -eq 0 ]; then
        echo "No tracked Nix files found"
        exit 0
    fi
    for file in "${nix_files[@]}"; do
        statix check --config "$root" "$root/$file"
    done
    deadnix --fail "${nix_files[@]/#/$root/}"

# Format, lint, and evaluate current host
check: fmt lint eval

# Format, lint, and evaluate all hosts
check-all: fmt lint eval-all
