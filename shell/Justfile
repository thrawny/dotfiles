# Desktop shell tasks, invoked from the repository root as just shell::<recipe>
set working-directory := ".."

default:
    @just --list shell

# Build the pinned Quickshell runtime and QML tooling without switching NixOS
tools:
    nix build --inputs-from ./nix nixpkgs#quickshell nixpkgs#qt6.qtdeclarative nixpkgs#cliphist --no-link --print-out-paths

# Build a pinned shell backend without activating the desktop
build-backend package:
    nix build './nix#{{package}}' --no-link --print-out-paths

# Verify the installed image adapter against a private Wayland compositor
check-image-package:
    #!/usr/bin/env bash
    set -euo pipefail
    package=$(nix build ./nix#shell-clipboard-image --no-link --print-out-paths)
    nix shell --inputs-from ./nix nixpkgs#sway nixpkgs#wl-clipboard nixpkgs#cliphist -c env SHELL_CLIPBOARD_IMAGE_ADAPTER="$package/bin/shell-clipboard-image" node --test shell/tests/clipboard-wayland.test.cjs

# Run in the foreground unless this config is already running
dev:
    nix shell --inputs-from ./nix nixpkgs#quickshell -c quickshell -c dotfiles --no-duplicate

# Start the managed shell; stop Hyprland's Waybar only if IPC reports readiness
use:
    systemctl --user start dotfiles-shell.service
    quickshell ipc -c dotfiles call shell ping | grep -qx ready
    -pkill -u "$(id -u)" -f '^[^ ]*waybar[^ ]* .*config-hyprland'

# Manually restore Waybar and stop Quickshell
waybar:
    hyprctl dispatch 'hl.dsp.exec_cmd("waybar -c " .. os.getenv("HOME") .. "/.config/waybar/config-hyprland -s " .. os.getenv("HOME") .. "/.config/waybar/style-hyprland.css")'
    systemctl --user stop dotfiles-shell.service
    -quickshell kill -c dotfiles

# Format the editable QML components
fmt:
    nix shell --inputs-from ./nix nixpkgs#qt6.qtdeclarative -c bash -c 'fd -e qml -0 . shell | xargs -0 qmlformat -i'

# Check shell model tests and QML syntax/types
check:
    nix shell --inputs-from ./nix nixpkgs#quickshell nixpkgs#qt6.qtdeclarative nixpkgs#cliphist nixpkgs#python3 nixpkgs#sway nixpkgs#wl-clipboard -c bash shell/scripts/check

# Check quota failure handling, provider icons, and popup layout with fixture data
check-quota:
    nix shell --inputs-from ./nix nixpkgs#quickshell nixpkgs#qt6.qtdeclarative -c node --test shell/tests/quota*.test.cjs
