#!/usr/bin/env bash
# gauntlet-review — run Claude and Codex code reviews in parallel over the same
# scope and print both raw findings in delimited sections.
#
# Mechanical launcher only: the caller (the `gauntlet` skill) supplies the
# context brief and does all the judgment — dedupe, verify, fix, summarize.
#
# Usage:
#   gauntlet-review [--base <branch> | --uncommitted | --commit <sha>]
#                   [--reviewers claude,codex] [--prior <file> | --no-prior] [brief]
#   ... | gauntlet-review --uncommitted -      # read brief from stdin
#
# Scope defaults to the current branch vs origin's default branch
# (--uncommitted when on that branch). The brief is extra review context passed
# verbatim to both engines; omit it or
# pass '-' to read from stdin (empty is allowed).
#
# Looping: each run persists its raw pass output and the reviewed SHA under a
# per-repo/per-branch state dir, and picks up that branch's ledger of
# already-adjudicated findings so a later round spends its budget on new ground
# instead of re-deriving the last round's findings. This mirrors the hosted
# Codex PR reviewer, which re-reads the full diff every round with prior
# findings suppressed. See SKILL.md for the ledger format and loop protocol.
#
# Graceful degradation: if one engine is unauthenticated or out of usage/quota,
# the script continues with the other and labels why. Exits 0 if at least one
# engine produced a result, non-zero only if both fail.
#
# Reviewer selection: --reviewers takes a comma list of claude/codex (default
# both). A deselected engine is never launched — unlike quota degradation this
# is deterministic, so a Codex-only loop stays Codex-only even after a Claude
# quota reset mid-loop. GAUNTLET_REVIEWERS sets the default.
#
# Env overrides: GAUNTLET_REVIEWERS (default claude,codex),
# GAUNTLET_CODEX_EFFORT (default high), GAUNTLET_CODEX_MODEL,
# GAUNTLET_PRIOR (ledger path), GAUNTLET_STATE_DIR (output root).
#
# Testable with stubs: put fake `claude`/`codex` earlier on PATH.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: gauntlet-review [--base <branch> | --uncommitted | --commit <sha>]
                       [--reviewers claude,codex] [--prior <file> | --no-prior]
                       [brief]

Runs one Claude (/code-review) and one Codex (review) over the same scope in
parallel, printing each review's raw findings in a delimited section. The
caller supplies the brief and does the dedupe/verify/fix/summarize.
--reviewers restricts which engines run (comma list of claude/codex; default
both, or GAUNTLET_REVIEWERS).

Raw output and the reviewed SHA are saved under the branch's state dir (printed
at exit). Findings already adjudicated on this branch are read from that dir's
ledger.md unless --no-prior is given.
EOF
  exit "${1:-0}"
}

scope=""
scope_set=0
prior_file=""
prior_set=0
no_prior=0
reviewers="${GAUNTLET_REVIEWERS:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) scope="--base $2"; scope_set=1; shift 2 ;;
    --uncommitted) scope="--uncommitted"; scope_set=1; shift ;;
    --commit) scope="--commit $2"; scope_set=1; shift 2 ;;
    --reviewers) reviewers="$2"; shift 2 ;;
    --prior) prior_file="$2"; prior_set=1; shift 2 ;;
    --no-prior) no_prior=1; shift ;;
    -h | --help) usage 0 ;;
    --) shift; break ;;
    -) break ;; # stdin marker for the brief; handled below
    -*) echo "gauntlet-review: unknown option: $1" >&2; usage 1 ;;
    *) break ;;
  esac
done

# Resolve reviewer selection. Default is both engines; an explicit selection
# fails loudly on a typo rather than silently running the wrong set.
run_claude=1
run_codex=1
if [[ -n "$reviewers" ]]; then
  run_claude=0
  run_codex=0
  IFS=',' read -ra selected <<<"$reviewers"
  for r in "${selected[@]}"; do
    case "$(printf '%s' "$r" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" in
      claude) run_claude=1 ;;
      codex) run_codex=1 ;;
      both | all) run_claude=1; run_codex=1 ;;
      "") ;;
      *) echo "gauntlet-review: unknown reviewer '$r' (expected claude, codex)" >&2; exit 1 ;;
    esac
  done
  if [[ "$run_claude" -eq 0 && "$run_codex" -eq 0 ]]; then
    echo "gauntlet-review: --reviewers selected no reviewer" >&2
    exit 1
  fi
fi

# Auto-detect scope when none was given: current branch vs origin's default
# branch, or uncommitted changes when already on the corresponding local branch.
# Compare against the remote-tracking ref so a stale local branch does not add
# already-merged upstream changes to the review.
if [[ "$scope_set" -eq 0 ]]; then
  branch="$(git rev-parse --abbrev-ref HEAD)"
  default_ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  default_ref="${default_ref:-origin/main}"
  default_branch="${default_ref#origin/}"
  if [[ "$branch" == "$default_branch" ]]; then scope="--uncommitted"; else scope="--base $default_ref"; fi
fi

# Brief: remaining arg, else stdin (when piped), else empty.
if [[ $# -gt 0 && "$1" != "-" ]]; then
  brief="$*"
elif [[ ! -t 0 ]]; then
  brief="$(cat)"
else
  brief=""
fi

# Describe the scope as prose. Both engines get it this way: Codex's review
# rejects a custom prompt alongside its --base/--uncommitted/--commit flags, so
# we let it (agentically) compute the diff from these instructions instead.
case "$scope" in
  --uncommitted) scope_desc="Review the uncommitted changes in the working tree (staged, unstaged, and untracked)." ;;
  "--base "*) base="${scope#--base }"; scope_desc="Review the changes on this branch relative to ${base}: the diff from 'git diff ${base}...HEAD'." ;;
  "--commit "*) sha="${scope#--commit }"; scope_desc="Review only the changes introduced by commit ${sha}: 'git diff ${sha}~1..${sha}'." ;;
esac

# Per-repo, per-branch state dir. Deliberately outside the working tree: the
# reviewers are told never to write into the repo because the tree is the
# artifact under review, and on --uncommitted scope an untracked ledger would
# land inside its own review. Keyed by branch so parallel worktrees and stacked
# branches keep separate ledgers, and it survives a session handoff.
slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//'; }
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
repo_slug="$(slug "$(basename "$repo_root")")"
branch_slug="$(slug "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo detached)")"
state_root="${GAUNTLET_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gauntlet}"
branch_dir="$state_root/$repo_slug/$branch_slug"
ledger_default="$branch_dir/ledger.md"

# Prior findings: explicit flag wins, then env, then this branch's ledger. The
# auto-pickup is what makes looping ergonomic, but it is never silent — a NOTE
# says which ledger was used, so a one-shot run after an old loop cannot
# quietly inherit stale suppression.
#
# Resolved before the round directory is created: a run that dies on an
# unreadable ledger must not burn a round number, or the round count the loop
# protocol reasons about silently drifts from the number of reviews actually run.
prior=""
prior_src=""
if [[ "$no_prior" -eq 0 ]]; then
  if [[ "$prior_set" -eq 0 && -n "${GAUNTLET_PRIOR:-}" ]]; then prior_file="$GAUNTLET_PRIOR"; prior_set=1; fi
  if [[ "$prior_set" -eq 0 && -s "$ledger_default" ]]; then prior_file="$ledger_default"; prior_set=1; fi
  if [[ "$prior_set" -eq 1 ]]; then
    if [[ ! -r "$prior_file" ]]; then
      echo "gauntlet-review: --prior file not readable: $prior_file" >&2
      exit 1
    fi
    prior="$(cat "$prior_file")"
    prior_src="$prior_file"
  fi
fi

# Round numbering makes the loop legible after the fact and keeps rounds ordered
# lexically; the ledger is what carries meaning between them.
mkdir -p "$branch_dir"
round=1
while [[ -e "$(printf '%s/round-%02d' "$branch_dir" "$round")" ]]; do round=$((round + 1)); done
round_dir="$(printf '%s/round-%02d' "$branch_dir" "$round")"
mkdir -p "$round_dir"

# Record exactly what was reviewed. This is what makes a loop self-measuring:
# with the SHA per round you can tell afterwards whether a finding landed in
# code a previous round already read (resampling) or in the fixes it prompted.
head_sha="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then tree_state="dirty"; else tree_state="clean"; fi
merge_base=""
case "$scope" in
  "--base "*) merge_base="$(git merge-base "${scope#--base }" HEAD 2>/dev/null || true)" ;;
esac

# Suppression, not silencing. The hosted reviewer demonstrably re-reads the full
# diff each round while declining to repost adjudicated findings, and still
# surfaces genuinely new ones in already-reviewed code — including issues
# introduced by the previous round's fix. Both escape hatches below are load
# bearing: without them a ledger turns every touched area into a blind spot.
# The decline-challenge clause has no counterpart in the hosted reviewer, which
# only sees a resolved thread; locally we keep the reason, so a wrong decline
# stays correctable instead of being made permanent by suppression.
prior_block=""
if [[ -n "$prior" ]]; then
  prior_block="PREVIOUSLY ADJUDICATED FINDINGS (earlier rounds on this same change):
${prior}

Do not report any of the above again. Two exceptions, and use them freely:
- A genuinely distinct issue in the same file or area — including one introduced by the fix for a listed finding — IS reportable. Report it and state explicitly why it is not the same finding.
- A finding listed as declined was judged not to apply, and the reason is given. If that reason is factually wrong about the code as it stands now, say so and report the finding again with the correction.
Everything not listed above is in scope as usual. Spend this pass on ground the earlier rounds did not cover."
fi

# Scope, not suppression. The brief is the intent statement (the local stand-in
# for a PR description), and pre-existing code / style are out of scope because
# the review rubric itself puts them there. Deliberately absent: any
# "prefer precision over recall" steer. Generation-time suppression means a real
# bug is never surfaced to be judged; the skill's verify-before-fix step is the
# false-positive guard, and it can only filter what it is shown.
focus="Treat the context/brief above as intended behavior — do not flag choices it marks as deliberate, pre-existing code outside this change, or trivial style.
Within that scope, be exhaustive: report every finding the author would fix if they knew about it, and do not stop at the first one."

# Confirmation is mostly reading, not running: the suite is green before a
# gauntlet, so re-running it re-confirms a gate we already passed. The narrow
# exception is behaviour no test covers, where a probe kills a speculative
# finding cheaply — and it must not touch the tree, which is the review artifact.
verify="Before reporting a finding, confirm it against the real code: read the surrounding code and every caller of what changed. The test suite and the linters are already green, so re-running them proves nothing. Where a finding turns on behaviour no existing test covers — an empty or nil input, an error path, an ordering or concurrency case — probe that one case directly instead of reporting a maybe: call the function, script the sequence, print the value. Never create or modify files in the repository; the working tree is the artifact under review. Say what you probed, and drop candidates the probe disproves."

claude_prompt="/code-review ${scope_desc}

${brief}

${focus}

${verify}

${prior_block}
Report findings only: do NOT edit, fix, or commit — running read-only checks and tests to confirm a finding is fine. For each finding output a line 'file:line — SEVERITY — one-line description', SEVERITY in high/medium/low."

codex_prompt="${scope_desc}

${brief}

${focus}

${verify}

${prior_block}"

# Output is kept, not scratched. A round costs two reviews at 5-20 minutes and
# real quota; discarding the raw findings the moment the caller has read them
# once means a bad dedupe forces a full re-run, and a loop that crosses a
# context compaction loses the basis it is supposed to dedupe against.
claude_out="$round_dir/claude.out"

# Claude reviewer — prints findings to stdout, then exits. Pin every model
# selection surface to Opus 5: /code-review may spawn subagents or carry its
# own model override, and user/project settings may configure fallback models.
# Keep this policy hard-coded; gauntlet reviews must never consume Fable quota.
readonly claude_review_model="claude-opus-5"
readonly claude_review_settings='{"availableModels":["claude-opus-5"],"enforceAvailableModels":true,"fallbackModel":[]}'
claude_pid=""
if [[ "$run_claude" -eq 1 ]]; then
  CLAUDE_CODE_SUBAGENT_MODEL="$claude_review_model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$claude_review_model" \
    claude -p --model "$claude_review_model" --setting-sources "" \
      --settings "$claude_review_settings" --no-session-persistence \
      --permission-mode auto "$claude_prompt" >"$claude_out" 2>&1 &
  claude_pid=$!
fi

# Codex reviewer — scope is in the prompt (see above). Raise the default high
# effort per-run with GAUNTLET_CODEX_EFFORT if a particular diff warrants it.
readonly codex_model="${GAUNTLET_CODEX_MODEL:-gpt-5.6-sol}"
readonly codex_effort="${GAUNTLET_CODEX_EFFORT:-high}"
codex_out="$round_dir/codex.out"
codex_log="$round_dir/codex.log"
codex_pid=""
if [[ "$run_codex" -eq 1 ]]; then
  codex exec --ephemeral --color never --model "$codex_model" \
    -c model_reasoning_effort="$codex_effort" -o "$codex_out" review "$codex_prompt" >"$codex_log" 2>&1 &
  codex_pid=$!
fi

claude_status=0
codex_status=0
if [[ -n "$claude_pid" ]]; then
  if wait "$claude_pid"; then claude_status=0; else claude_status=$?; fi
fi
if [[ -n "$codex_pid" ]]; then
  if wait "$codex_pid"; then codex_status=0; else codex_status=$?; fi
fi

# Classify a non-zero engine result so we can degrade gracefully and say why.
classify() {
  local status="$1" file="$2" txt
  [[ "$status" -eq 0 ]] && { echo "ok"; return; }
  txt="$(tr '[:upper:]' '[:lower:]' <"$file" 2>/dev/null || true)"
  case "$txt" in
    *"not logged in"* | *"log in"* | *"please login"* | *login* | *authenticat* | *unauthorized* | *"401"* | *"invalid api key"* | *"no credentials"* | *"logged out"* | *"session expired"*)
      echo "unavailable: not authenticated" ;;
    *"usage limit"* | *"rate limit"* | *"429"* | *quota* | *"ran out"* | *"out of credit"* | *credit* | *insufficient* | *"limit reached"* | *"too many requests"* | *upgrade*)
      echo "unavailable: usage/quota exhausted" ;;
    *)
      echo "failed (exit $status)" ;;
  esac
}

if [[ "$run_claude" -eq 1 ]]; then claude_state="$(classify "$claude_status" "$claude_out")"; else claude_state="skipped (--reviewers)"; fi
if [[ "$run_codex" -eq 1 ]]; then codex_state="$(classify "$codex_status" "$codex_log")"; else codex_state="skipped (--reviewers)"; fi

ok_count=0
[[ "$run_claude" -eq 1 && "$claude_status" -eq 0 ]] && ok_count=$((ok_count + 1))
[[ "$run_codex" -eq 1 && "$codex_status" -eq 0 ]] && ok_count=$((ok_count + 1))

# meta.txt is the per-round record the loop is measured from: what scope ran,
# against which commit, with which ledger, and which reviewers actually produced
# findings (a degraded round is otherwise indistinguishable from a dry one).
{
  printf 'round: %d\n' "$round"
  printf 'finished: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'scope: %s\n' "$scope"
  printf 'head_sha: %s\n' "$head_sha"
  printf 'worktree: %s\n' "$tree_state"
  [[ -n "$merge_base" ]] && printf 'merge_base: %s\n' "$merge_base"
  printf 'prior_ledger: %s\n' "${prior_src:-none}"
  printf 'reviewers: %s%s\n' "$([[ "$run_claude" -eq 1 ]] && printf 'claude')" \
    "$([[ "$run_codex" -eq 1 ]] && { [[ "$run_claude" -eq 1 ]] && printf ',codex' || printf 'codex'; })"
  printf 'codex_model: %s\n' "$codex_model"
  printf 'codex_effort: %s\n' "$codex_effort"
  printf 'claude: %s\n' "$claude_state"
  printf 'codex: %s\n' "$codex_state"
  printf -- '--- brief ---\n%s\n' "$brief"
} >"$round_dir/meta.txt"

# Graceful degradation: continue on whichever reviewer succeeded; say what
# dropped so the caller knows the agreement signal is unavailable.
if [[ "$ok_count" -eq 0 ]]; then
  printf 'ERROR: no reviewer produced results — claude %s; codex %s\n' \
    "$claude_state" "$codex_state" >&2
else
  if [[ "$run_claude" -eq 0 ]]; then
    printf 'NOTE: claude skipped by --reviewers.\n'
  elif [[ "$claude_status" -ne 0 ]]; then
    printf 'NOTE: claude %s — proceeding with Codex only.\n' "$claude_state"
  fi
  if [[ "$run_codex" -eq 0 ]]; then
    printf 'NOTE: codex skipped by --reviewers.\n'
  elif [[ "$codex_status" -ne 0 ]]; then
    printf 'NOTE: codex %s — proceeding with Claude only.\n' "$codex_state"
  fi
  if [[ -n "$prior_src" ]]; then
    printf 'NOTE: round %d — suppressing findings already adjudicated in %s\n' "$round" "$prior_src"
  else
    printf 'NOTE: round %d — no prior ledger%s\n' "$round" \
      "$([[ "$no_prior" -eq 1 ]] && printf ' (--no-prior)' || printf '')"
  fi
  printf '\n'
fi

printf '===== CLAUDE REVIEW [%s] =====\n' "$claude_state"
if [[ "$run_claude" -eq 0 ]]; then
  : # deselected — nothing ran, nothing to print
elif [[ "$claude_status" -eq 0 ]]; then cat "$claude_out"; else tail -40 "$claude_out"; fi

printf '\n===== CODEX REVIEW [%s] =====\n' "$codex_state"
if [[ "$run_codex" -eq 0 ]]; then
  : # deselected — nothing ran, nothing to print
elif [[ "$codex_status" -eq 0 ]]; then
  cat "$codex_out"
else
  # On failure, show codex's answer file if it wrote anything, plus the log tail
  # (codex diagnostics usually land on stderr -> the log, but not always).
  if [[ -s "$codex_out" ]]; then cat "$codex_out"; fi
  printf '\n----- codex log tail -----\n'
  tail -40 "$codex_log"
fi

printf '\n===== GAUNTLET STATE =====\n'
printf 'round:  %d (reviewed %s, worktree %s)\n' "$round" "${head_sha:0:12}" "$tree_state"
printf 'output: %s\n' "$round_dir"
printf 'ledger: %s%s\n' "$ledger_default" \
  "$([[ -s "$ledger_default" ]] && printf '' || printf '  (not yet written)')"

# Succeed if at least one reviewer produced a result; degrade gracefully otherwise.
[[ "$ok_count" -ge 1 ]]
